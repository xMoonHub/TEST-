-- manda um payload (até 3 tentativas, respeitando o rate limit do Discord)
local function post(payload)
	if not (Config.WebhookOn and type(W.url) == "string" and W.url ~= "") then
		return false
	end
	if not request_ then
		warn("[Moon Hub] Webhook: this executor has no http request function")
		return false
	end

	local body = HttpService:JSONEncode(payload)
	for attempt = 1, 3 do
		local ok, res = pcall(request_, {
			Url = W.url,
			Method = "POST",
			Headers = { ["Content-Type"] = "application/json" },
			Body = body,
		})
		local code = ok and type(res) == "table" and tonumber(res.StatusCode or res.Status) or nil
		if code and code >= 200 and code < 300 then
			return true
		end

		local waitFor = 3
		if code == 429 then
			local okJson, data = pcall(HttpService.JSONDecode, HttpService, res.Body or "{}")
			if okJson and type(data) == "table" and tonumber(data.retry_after) then
				waitFor = math.clamp(tonumber(data.retry_after) + 0.5, 1, 15)
			end
		end
		warn(string.format("[Moon Hub] Webhook failed (attempt %d/3, status %s)", attempt, tostring(code or (ok and "?" or res))))
		task.wait(waitFor)
	end
	return false
end

local function sendBoss(boss)
	if not post(buildPayload(boss)) then
		return false
