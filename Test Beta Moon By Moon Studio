-- Safe zone: ForceField, atributo "safe" ou partes de SafeZone do mapa
local SafeCache = { parts = {}, at = 0 }
local function refreshSafe()
    if os.clock() - SafeCache.at < 10 then return end
    SafeCache.at = os.clock()
    local list = {}
    pcall(function()
        local wo = workspace:FindFirstChild("_WorldOrigin")
        local folder = wo and (wo:FindFirstChild("SafeZones") or wo:FindFirstChild("SafeZone"))
        if folder then
            for _, d in ipairs(folder:GetDescendants()) do
                if d:IsA("BasePart") then list[#list + 1] = d end
            end
        end
        local direct = workspace:FindFirstChild("SafeZones")
        if direct then
            for _, d in ipairs(direct:GetDescendants()) do
                if d:IsA("BasePart") then list[#list + 1] = d end
            end
        end
    end)
    SafeCache.parts = list
end
local function inSafeZone(plr)
    local ch = plr.Character
    local r = ch and ch:FindFirstChild("HumanoidRootPart")
    if not r then return false end
    if ch:FindFirstChildOfClass("ForceField") then return true end
    for name, v in pairs(ch:GetAttributes()) do
        if v == true and string.find(string.lower(name), "safe", 1, true) then return true end
    end
    refreshSafe()
    for _, p in ipairs(SafeCache.parts) do
        if p.Parent then
            local rel = p.CFrame:PointToObjectSpace(r.Position)
            local h = p.Size / 2
            if math.abs(rel.X) <= h.X and math.abs(rel.Y) <= h.Y + 8 and math.abs(rel.Z) <= h.Z then return true end
        end
    end
    return false
end
AB.inSafeZone = inSafeZone

