        if hs and hum.SeatPart ~= hs then flyTo(hs.CFrame + Vector3.new(0, 2, 0)); if near(hrp.Position, hs.Position) < 15 then hrp.CFrame = hs.CFrame + Vector3.new(0, 2, 0) end; SE.lev = "heart: going to the harpoon"; return true end
