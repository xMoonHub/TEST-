                for i, dd in ipairs(dds) do pcall(function() dd:SetValues(valuesFor(i)) end) end
                if Config.PrioDefault then fillDefault() end
            end
            pcall(function()
                local parts, n = {}, 0
                for _, key in ipairs(AFL.prioOrder()) do
                    local f = AFL.feat[key]
                    if f and f.on() then
                        local names = f.labels and f.labels() or { f.hidden and (key == "Normal" and "Normal Farm" or f.label) or f.label }
