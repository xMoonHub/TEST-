                out[#out + 1] = { cf = sp.CFrame, d = (sp.Position - loc).Magnitude }
            end
        end
    end
    table.sort(out, function(a, b) return a.d < b.d end)
    return out
end
-- v23: contador de kills do Tiki. O jogo não expõe esse valor, então o script conta as mortes de mobs do Tiki
-- Outpost que ele enxerga (suas ou de outros jogadores, desde que o mob esteja carregado perto de você).
-- 300 kills = 4 olhos das estátuas (75 por olho). Zera quando o Tyrant nasce. Dá para ajustar na aba Normal Farm.
AFL.TyrantNeed = 300
AFL.TyrantCount = { n = 0, hooked = setmetatable({}, { __mode = "k" }), boss = false }
function AFL.tyrantTrack()
    local C = AFL.TyrantCount
    if getSea() ~= 3 then return end
    local loc = AFL.tikiLocation()
    if bossAlive("Tyrant of the Skies") then
        C.boss, C.n = true, 0 -- o boss nasceu: o ciclo foi consumido
        if AFL.TV then AFL.TV.needReset = true end
        return
    end
    C.boss = false
    for _, e in ipairs(enemiesList()) do
        if not C.hooked[e] then
            local hum, er = e:FindFirstChildOfClass("Humanoid"), e:FindFirstChild("HumanoidRootPart")
            if hum and er and hum.Health > 0 then
                C.hooked[e] = true
                if not string.find(e.Name, "Tyrant", 1, true)
                    and ((loc and (er.Position - loc).Magnitude < 1500) or matchName(e.Name, AFL.TikiMobs)) then
                    local done, c1, c2 = false, nil, nil
                    local function dead()
                        if done then return end
                        done = true
                        if c1 then c1:Disconnect() end
                        if c2 then c2:Disconnect() end
                        if not C.boss then C.n = math.min(AFL.TyrantNeed, C.n + 1) end
                    end
                    c1 = hum.Died:Connect(dead)
                    c2 = hum:GetPropertyChangedSignal("Health"):Connect(function()
                        if hum.Health <= 0 then dead() end
                    end)
                end
            end
        end
    end
end
task.spawn(function()
    while Alive do
        pcall(AFL.tyrantTrack)
        task.wait(0.25)
    end
end)
function AFL.tyrantStatusText()
    if getSea() ~= 3 then return "Only works in Sea 3" end
    local C, need = AFL.TyrantCount, AFL.TyrantNeed
    if C.boss then return "Tyrant of the Skies has already spawned! (count reset)" end
    local left = math.max(0, need - C.n)
    local tag = Config.KillTyrant and "" or "  [Auto Tyrant off]"
    local eyesRead, known = AFL.tyrantEyes()
    if known then
        if eyesRead >= 4 then
            return string.format("Eyes 4/4 lit — step 2: breaking the pots (rounds: %d). Then the Tyrant spawns.%s", AFL.TV and AFL.TV.done or 0, tag)
        end
        return string.format("Eyes %d/4 (read from the map) — script count: %d/%d NPCs%s", eyesRead, C.n, need, tag)
    end
    if left <= 0 then
        return string.format("%d/%d — step 2: breaking the pots (rounds: %d).%s", C.n, need, AFL.TV and AFL.TV.done or 0, tag)
    end
    local eyes = math.min(4, math.floor(C.n / 75))
    return string.format("%d NPCs left (%d/%d) — eyes %d/4, %d to the next%s",
        left, C.n, need, eyes, 75 - (C.n % 75), tag)
end

-- v24: ETAPA 2 do Tyrant — depois dos 300 kills, vai até os potes da arena e quebra com as skills da fruta
-- (só skill de fruta quebra). Quando não restam potes e o boss ainda não nasceu, espera na arena.
-- Os nomes dos potes no mapa NÃO foram verificados: o script procura por jar/pot/vase/pottery perto do Tiki.
-- O resultado aparece em Status > Diagnóstico > invocação.
AFL.Pots = { list = {}, at = -1e9, broken = 0, seen = setmetatable({}, { __mode = "k" }), busy = false, hold = nil,
    scanning = false, names = {}, arena = nil, lookT = 0, lookSince = 0 }
-- v25: antes, sem potes achados ele ficava PARADO (não tinha para onde ir). Agora: a busca roda em segundo plano
-- (não trava o loop), procura em todo o workspace (não só no Map), aceita mais nomes e, se não achar, voa
-- patrulhando em volta do Tiki Outpost / da arena do Tyrant até os potes carregarem.
AFL.PotWords = { "jar", "vase", "pottery", "urn", "clay", "ceramic", "amphora", "breakable", "destructible", "tyrantpot", "skypot" }
function AFL.potMatch(name)
    local n = string.lower(name)
    if string.find(n, "potion", 1, true) or string.find(n, "spot", 1, true) or string.find(n, "pottedplant", 1, true)
        or string.find(n, "turn", 1, true) or string.find(n, "burn", 1, true) or string.find(n, "return", 1, true)
        or string.find(n, "jarvis", 1, true) then
        return false
    end
    if string.find(n, "%f[%a]pots?%f[%A]") or string.find(n, "pot", 1, true) == 1 then return true end
    for _, w in ipairs(AFL.PotWords) do
        if string.find(n, w, 1, true) then return true end
    end
    return false
end
function AFL.potsScan(loc)
    local P = AFL.Pots
    if P.scanning or os.clock() - P.at < 5 then return P.list end
    P.scanning, P.at = true, os.clock()
    task.spawn(function()
        local out, names, n, arena = {}, {}, 0, nil
        pcall(function()
            local skip = {}
            for _, nm in ipairs({ "Enemies", "Characters", "Boats", "SeaBeasts", "NPCs" }) do
                skip[workspace:FindFirstChild(nm) or 0] = true
            end
            for _, d in ipairs(workspace:GetDescendants()) do
                n += 1
                if n % 2500 == 0 then task.wait() end
                local cls = d.ClassName
                if cls == "Model" or cls == "Part" or cls == "MeshPart" or cls == "UnionOperation" then
                    local nl = string.lower(d.Name)
                    if not arena and string.find(nl, "tyrant", 1, true) and not d:FindFirstChildOfClass("Humanoid") then
                        local ap = d:IsA("BasePart") and d or (d:IsA("Model") and (d.PrimaryPart or d:FindFirstChildWhichIsA("BasePart", true)))
                        if ap then arena = ap.Position end
                    end
                    if AFL.potMatch(d.Name) and not d:FindFirstChildOfClass("Humanoid") then
                        local part = d:IsA("BasePart") and d or d.PrimaryPart or d:FindFirstChildWhichIsA("BasePart", true)
                        local bad = false
                        local a = d.Parent
                        while a and a ~= workspace do
                            if skip[a] or (a:IsA("Model") and a:FindFirstChildOfClass("Humanoid")) then bad = true break end
                            a = a.Parent
                        end
                        if part and not bad and part.Parent and (part.Position - loc).Magnitude < 6000 then
                            local dup = false
                            for _, o in ipairs(out) do
                                if o.inst == d or d:IsDescendantOf(o.inst) then dup = true break end
                                if o.inst:IsDescendantOf(d) then o.inst, o.part, dup = d, part, true break end
                            end
                            if not dup then
                                out[#out + 1] = { inst = d, part = part }
                                if #names < 6 and not names[d.Name] then names[d.Name] = true; names[#names + 1] = d.Name end
                            end
                        end
                    end
                end
            end
        end)
        -- potes que sumiram desde a última leitura = quebrados
        for inst in pairs(P.seen) do
            if not inst.Parent then P.seen[inst] = nil; P.broken += 1 end
        end
        for _, o in ipairs(out) do P.seen[o.inst] = true end
        P.list, P.names, P.arena = out, names, arena or P.arena
        P.scanning = false
    end)
    return P.list
end
function AFL.potKey(name)
    local kc = Enum.KeyCode[name]
    if not kc then return end
    pcall(function()
        VirtualInputManager:SendKeyEvent(true, kc, false, game)
        task.wait(0.1)
        VirtualInputManager:SendKeyEvent(false, kc, false, game)
    end)
end
function AFL.potsStep(loc, hrp)
    local P = AFL.Pots
    State.Mode = "Auto Tyrant of the Skies"
    local list = AFL.potsScan(loc)
    local best, bd = nil, math.huge
    for _, o in ipairs(list) do
        if o.part.Parent then
            local d = (hrp.Position - o.part.Position).Magnitude
            if d < bd then best, bd = o, d end
        end
    end
    if not best then
        -- sem potes carregados: NUNCA fica parado. Vai à arena do Tyrant (se achou) ou patrulha em volta do Tiki
        local now = os.clock()
        if now - P.lookT > 3 then P.lookSince = now end
        P.lookT = now
        local t = now - P.lookSince
        local target
        if P.arena then
            -- arena conhecida: vai até lá e dá voltas curtas em volta (o jogo só carrega objetos perto)
            local ang = math.floor(t / 4) * math.pi / 3
            local r = (t < 8) and 0 or 120
            target = CFrame.new(P.arena + Vector3.new(math.cos(ang) * r, 70, math.sin(ang) * r))
            State.Text = "300/300 done: going to the Tyrant arena to look for the pots"
        else
            local k = math.floor(t / 7) % 8
            local ang = k * math.pi / 4
            local r = 300 + 450 * (math.floor(t / 56) % 5)
            target = CFrame.new(loc + Vector3.new(math.cos(ang) * r, 120, math.sin(ang) * r))
            State.Text = string.format("300/300 done: looking for the pots (patrol radius %d)", r)
        end
        Diag.summon = string.format("Auto Tyrant step 2: no pot loaded (broken: %d, arena %s). Patrolling; if it never finds one, the pot name is different: send me this diagnostic.",
            P.broken, P.arena and "found" or "not found")
        flyTo(target)
        return true
    end
    P.hold = best.part.Position + Vector3.new(0, 25, 0)
    State.Text = string.format("300/300 done: breaking pots (%d left, %d broken)", #list, P.broken)
    Diag.summon = string.format("Auto Tyrant step 2: pot '%s' at %d studs | fruit skills | names seen: %s",
        best.inst.Name, math.floor(bd), table.concat(P.names, ", "))
    local stand = best.part.Position + Vector3.new(0, 8, 0) -- perto: o M1 de Melee/Sword precisa de alcance
    Aim.part, Aim.level = best.part, false
    if (hrp.Position - stand).Magnitude > 10 then
        flyTo(CFrame.new(stand))
        return true
    end
    if currentTween then currentTween:Cancel() end
    hrp.CFrame = CFrame.lookAt(stand, best.part.Position)
    hrp.AssemblyLinearVelocity = Vector3.zero
    -- v26: quebra os potes com TODAS as armas: para cada uma (Melee, Sword, Gun, Fruta) equipa, bate de M1 por ~1,2s
    -- (a câmera mira o pote) e depois usa as skills dela. Só entram as armas que você tem.
    Config.SeaUntil = os.clock() + 1.2
    Config.AttackUntil = os.clock() + 0.8
    if not P.busy then
        P.busy = true
        task.spawn(function()
            local order = { "Melee", "Sword", "Gun", "Blox Fruit" }
            local keysBy = { Melee = { "Z", "X", "C" }, Sword = { "Z", "X" }, Gun = { "Z", "X" }, ["Blox Fruit"] = { "Z", "X", "C", "V", "F" } }
            for _, tip in ipairs(order) do
                if not (Alive and Config.KillTyrant) then break end
                if findTool(tip) then
                    Config.SeaTool = { tip = tip }
                    Config.SeaUntil = os.clock() + 1.5
                    pcall(equipWeapon)
                    task.wait(0.3)
                    local t0 = os.clock()
                    while os.clock() - t0 < 1.2 and Alive and Config.KillTyrant do
                        Config.SeaUntil = os.clock() + 1.2
                        Config.AttackUntil = os.clock() + 0.8
                        if tip == "Melee" then
                            pcall(cfAttack)
                        else
                            pcall(function()
                                local c = Player.Character
                                local tl = c and c:FindFirstChildOfClass("Tool")
                                if tl then tl:Activate() end
                            end)
                        end
                        task.wait(0.08)
                    end
                    for _, k in ipairs(keysBy[tip]) do
                        if not (Alive and Config.KillTyrant) then break end
                        Config.SeaUntil = os.clock() + 1.2
                        AFL.potKey(k)
                        task.wait(0.3)
                    end
                end
            end
            P.busy = false
        end)
    end
    return true
end

-- ============ v27: ETAPA 2 DO TYRANT (integrada do Batman Hub) ============
-- Olhos: lidos do mapa (TikiOutpost.IslandModel.Eye1..4, Transparency == 0). Com 4 olhos acesos, voa até os 4 vasos
-- (coordenadas fixas), mira PARA BAIXO (câmera -89° + hook no mouse) e atira com a Skull Guitar (5 tiros por vaso).
-- Sem Skull Guitar: usa M1 + skills de cada arma (fruta, melee, espada, arma de fogo) mirando para baixo.
-- Boss vivo = trava os vasos (needReset) até os olhos apagarem de novo. Se o mapa não tiver o modelo dos olhos,
-- cai para a contagem de 300 kills do script.
AFL.TV = {
    vases = {
        Vector3.new(-16230.123046875, 153.8718719482422, 1449.07373046875),
        Vector3.new(-16309.607421875, 153.9078826904297, 1452.01708984375),
        Vector3.new(-16313.8388671875, 153.9078826904297, 1339.071533203125),
        Vector3.new(-16234.29296875, 153.79917907714844, 1336.2052001953125),
    },
    transform = { "dragon", "leopard", "kitsune", "t-rex", "trex", "yeti", "mammoth", "venom", "gas" },
    needReset = false, running = false, idx = 0, warnAt = 0, hooked = false, aimPos = nil, aimPart = nil, done = 0,
}
function AFL.tyrantEyes()
    local map = workspace:FindFirstChild("Map")
    local tiki = map and map:FindFirstChild("TikiOutpost")
    local island = tiki and tiki:FindFirstChild("IslandModel")
    if not island then return 0, false end
    local c = 0
    for i = 1, 4 do
        local eye = island:FindFirstChild("Eye" .. i, true)
        if eye and eye:IsA("BasePart") and eye.Transparency == 0 then c += 1 end
    end
    return c, true
