-- ============ ATAQUE ============
-- O jogo só registra o golpe se o clique for "real" e o cursor estiver sobre o mob.
-- Por isso: (1) a câmera é apontada para o mob e o clique cai FORA da janela da Fluent;
-- (2) existem vários métodos de ataque. O script mede se o mob perdeu vida e, se não perdeu,
--     troca sozinho de método (e depois desce a altura) até achar uma combinação que cause dano.
local Aim = { part = nil, on = false, camChanged = false, px = nil, py = nil, level = false }
-- Ciclo automático: sem Mouse/Touch (clique sintético trava o cursor). Esses dois continuam no menu, só manual.
-- Para Melee, prioriza o controlador de combate do jogo: Tool:Activate() sozinho
-- normalmente não dispara o M1 do estilo de luta.
local METHODS = { "CombatFramework", "Net", "Tool", "VirtualUser" }
local Watch = { enemy = nil, hp = 0, lastDmg = 0, mi = 1, stage = 0, confirmed = false, skip = {} }
local Fail = {}

local function currentMethod()
    if os.clock() < Config.SeaUntil then return "Tool" end -- Sea Events: M1 por Tool:Activate com a câmera mirando
    -- Gun / Blox Fruit: dispara com Tool:Activate (sem clique sintético) e a câmera mira no cursor
    if Config.Weapon == "Gun" and (Config.AttackMethod == "Auto" or Config.AttackMethod == "Net") then
        return "Tool"
    end
    return (Config.AttackMethod ~= "Auto") and Config.AttackMethod or METHODS[Watch.mi]
end

local function restoreCamera()
    if not Aim.camChanged then return end
    Aim.camChanged = false
    pcall(function()
        local cam = workspace.CurrentCamera
        cam.CameraType = Enum.CameraType.Custom
        local _, _, hum = getChar()
        if hum then cam.CameraSubject = hum end
    end)
end

-- Retângulo da janela da Fluent (para o clique nunca cair em cima dela)
local function windowRect()
    local ok, r = pcall(function()
        local root = Window and Window.Root
        if root then
            if not root.Visible then return false end
            local p, sz = root.AbsolutePosition, root.AbsoluteSize
            return { p.X, p.Y, p.X + sz.X, p.Y + sz.Y }
        end
    end)
    if ok and r == false then return nil end -- janela escondida
    if ok and r then return r end
    local cam = workspace.CurrentCamera
    local vp = cam and cam.ViewportSize or Vector2.new(1280, 720)
    return { vp.X / 2 - 300, vp.Y / 2 - 240, vp.X / 2 + 300, vp.Y / 2 + 240 } -- estimativa
end

-- Posição atual do cursor (a câmera aponta o mob para ESSE pixel, então não é preciso clicar em outro lugar)
local function cursorPoint(vp)
    local ok, loc = pcall(function() return UserInputService:GetMouseLocation() end)
    if ok and loc and loc.X > 1 and loc.Y > 1 and loc.X < vp.X - 1 and loc.Y < vp.Y - 1 then
        return math.clamp(loc.X, vp.X * 0.1, vp.X * 0.9), math.clamp(loc.Y, vp.Y * 0.1, vp.Y * 0.9)
    end
    return vp.X * 0.5, vp.Y * 0.5
end

-- Escolhe um ponto da tela livre da janela
local function safePoint(vp)
    local rect = windowRect()
    local cands = { { 0.88, 0.50 }, { 0.12, 0.50 }, { 0.88, 0.30 }, { 0.12, 0.30 }, { 0.50, 0.12 }, { 0.88, 0.70 } }
    for _, c in ipairs(cands) do
        local x, y = vp.X * c[1], vp.Y * c[2]
        if (not rect) or x < rect[1] - 30 or x > rect[3] + 30 or y < rect[2] - 30 or y > rect[4] + 30 then
            return x, y
        end
    end
    return vp.X * 0.5, vp.Y * 0.5
end

-- Câmera olhando para o alvo, de modo que ele apareça exatamente no pixel (px, py)
local function aimCFrame(camPos, target, px, py, vp, fov)
    local look = (target - camPos)
    if look.Magnitude < 0.01 then return CFrame.new(camPos) end
    look = look.Unit
    local t = math.tan(math.rad(fov) / 2)
    local ax = math.atan(((px - vp.X / 2) / (vp.Y / 2)) * t)
    local ay = math.atan(((py - vp.Y / 2) / (vp.Y / 2)) * t)
    local yaw = math.atan2(-look.X, -look.Z) + ax
    local pitch = math.clamp(math.asin(math.clamp(look.Y, -1, 1)) + ay, math.rad(-85), math.rad(85))
    return CFrame.new(camPos) * CFrame.fromEulerAnglesYXZ(pitch, yaw, 0) -- sem roll: a câmera nunca fica torta
end

-- Clique/toque real (entra como input do jogador, o jogo não ignora)
local function clickScreen(touch)
    local cam = workspace.CurrentCamera
    if not cam then return false end
    local x, y = Aim.px, Aim.py
    if not x then x, y = safePoint(cam.ViewportSize) end
    return pcall(function()
        if touch then
            VirtualInputManager:SendTouchEvent(1, 0, x, y)
            VirtualInputManager:SendTouchEvent(1, 2, x, y)
        else
            VirtualInputManager:SendMouseMoveEvent(x, y, game)
            VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 0)
            VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 0)
        end
    end)
end

-- Chama o controlador de combate do próprio jogo (se o executor deixar ler o módulo)
local CFW = { tried = false, ctrl = nil }
local function cfAttack()
    return pcall(function()
        if not CFW.tried or (not CFW.ctrl and os.clock() - (CFW.at or 0) > 10) then
            CFW.tried, CFW.at = true, os.clock()
            local mod = require(Player.PlayerScripts:WaitForChild("CombatFramework", 3))
            CFW.ctrl = getupvalues(mod)[2]
        end
        local ctrl = CFW.ctrl and CFW.ctrl.activeController
        assert(ctrl, "activeController unavailable")
        pcall(function()
            ctrl.hitboxMagnitude = 60  -- alcance do golpe (com o jogador longe do mob)
            ctrl.timeToNextAttack = 0  -- sem espera entre um golpe e o próximo (era o "delay" do clique)
            ctrl.attacking = false
        end)
        ctrl:attack()
    end)
end

local doNetAttack -- definido na seção NET (logo abaixo da seção INIMIGOS)

local function doAttack(method)
    local ok = false
    if method == "Net" then
        ok = doNetAttack and doNetAttack() or false
    elseif method == "Mouse" then
        ok = clickScreen(false)
    elseif method == "Touch" then
        ok = clickScreen(true)
    elseif method == "VirtualUser" then
        ok = pcall(function()
            VirtualUser:CaptureController()
            VirtualUser:Button1Down(Vector2.new(1280, 672))
            VirtualUser:Button1Up(Vector2.new(1280, 672))
        end)
    elseif method == "CombatFramework" then
        ok = cfAttack()
    elseif method == "Tool" then
        if Config.Weapon == "Melee" then
            -- Fallback correto para M1 de estilos de luta.
            ok = cfAttack()
        else
            ok = pcall(function()
                local char = Player.Character
                local tool = char and char:FindFirstChildOfClass("Tool")
                if tool then tool:Activate() end
            end)
        end
    end
    -- método que dá erro de API várias vezes seguidas é descartado do ciclo automático
    if method == "Mouse" or method == "Touch" or method == "VirtualUser" then
        Fail[method] = ok and 0 or ((Fail[method] or 0) + 1)
        if Fail[method] >= 8 then Watch.skip[method] = true end
    elseif method == "CombatFramework" and CFW.tried and not CFW.ctrl then
        Watch.skip[method] = true
    end
end

-- Câmera: enquanto ataca com Mouse/Touch, mantém o mob exatamente sob o cursor
