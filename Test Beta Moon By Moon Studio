-- Vida <= SafeLow: sai voando para cima ate chegar em SafeHigh e so entao volta a bater.
-- (Se sua vida maxima for menor que SafeHigh, usa 45% e 95% da vida maxima.)
local Protect = { on = false }
local function protectStep()
    if not Config.SafeProtect then Protect.on = false; return false end
    local _, hrp, hum = getChar()
    if not hum then return false end
    local lo, hi = Config.SafeLow, Config.SafeHigh
    if hum.MaxHealth < hi then lo, hi = hum.MaxHealth * 0.45, hum.MaxHealth * 0.95 end
    if not Protect.on and hum.Health <= lo then Protect.on = true end
    if Protect.on and hum.Health >= hi then Protect.on = false end
    if not Protect.on then return false end
    State.Mode, State.Text = "Safe Protect", string.format("vida %d (voltando a bater em %d)", hum.Health, hi)
    Fight.active, Fight.inPos = false, false
    Config.AttackUntil = 0
    flyTo(CFrame.new(hrp.Position + Vector3.new(0, 400, 0)))
    return true
end

