do
    local AM = {}
    AB.Aim = AM
    local UIS = UserInputService
    local touchOnly = UIS.TouchEnabled and not UIS.KeyboardEnabled
    local function d(k, v) if Config[k] == nil then Config[k] = v end end
    d("AimOn", true); d("AimMode", "Both"); d("AimSource", "Bounty Target"); d("AimPart", "HumanoidRootPart")
    d("AimFOV", 220); d("AimSmooth", 0.35); d("AimPredict", 0.12); d("AimPredictOn", true); d("AimAutoPing", true)
    d("AimHitChance", 100); d("AimGuarantee", true); d("AimGate", "On Skill / Click"); d("AimMaxDist", 1500); d("AimSticky", true)
    d("AimShowFOV", false); d("AimFOVOrigin", "Center")

    local SKILL_CODES = { Z = Enum.KeyCode.Z, X = Enum.KeyCode.X, C = Enum.KeyCode.C, V = Enum.KeyCode.V, F = Enum.KeyCode.F }
    local ORDER = { "Z", "X", "C", "V", "F" }
    local SA = { pos = nil, part = nil, sx = 0, sy = 0, roll = true, rollAt = 0, releaseAt = 0, forceUntil = 0 }
    local Track = setmetatable({}, { __mode = "k" })
    local cur, hooked = nil, false
    AM.status = "idle"

    -- ===== previsao =====
    local function velocityOf(part, now)
        local p, tr = part.Position, Track[part]
        if not tr or now - tr.t > 0.4 then
            Track[part] = { p = p, t = now, v = Vector3.zero }
            return part.AssemblyLinearVelocity
        end
        local dt = now - tr.t
        if dt > 0.0005 then
            local inst = (p - tr.p) / dt
            if inst.Magnitude > 450 then inst = tr.v end
            tr.v = tr.v:Lerp(inst, math.clamp(dt * 16, 0.12, 1))
            tr.p, tr.t = p, now
        end
        local pv = part.AssemblyLinearVelocity
        return (pv.Magnitude > tr.v.Magnitude) and pv or tr.v
    end
    local function leadPos(part, now)
        local pos = part.Position
        if not Config.AimPredictOn then return pos end
        local t = tonumber(Config.AimPredict) or 0
        if Config.AimAutoPing then
            local ok, ping = pcall(function() return Player:GetNetworkPing() end)
            if ok and ping then t += math.clamp(ping, 0, 0.4) end
        end
        local off = velocityOf(part, now) * math.clamp(t, 0, 0.7)
        if off.Magnitude > 70 then off = off.Unit * 70 end
        return pos + off
    end

    local function partOf(char)
        local w = Config.AimPart
        if w == "Torso" then return char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") or char:FindFirstChild("HumanoidRootPart") end
        return char:FindFirstChild(w) or char:FindFirstChild("HumanoidRootPart")
    end

    -- ===== escolha do alvo =====
    local function closestEnemy(cam, origin)
        local best, bk
        for _, p in ipairs(Players:GetPlayers()) do
            local ch = p ~= Player and p.Character
            local hum = ch and ch:FindFirstChildOfClass("Humanoid")
            local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
            if hum and hrp and hum.Health > 0 and not ch:FindFirstChildOfClass("ForceField")
                and not (p.Team ~= nil and p.Team == Player.Team) then
                local dist = (hrp.Position - cam.CFrame.Position).Magnitude
                local part = partOf(ch) or hrp
                local v, on = cam:WorldToViewportPoint(part.Position)
                if on and dist <= (tonumber(Config.AimMaxDist) or 1500) then
                    local sd = (Vector2.new(v.X, v.Y) - origin).Magnitude
                    if Config.AimGuarantee or sd <= (tonumber(Config.AimFOV) or 220) then
                        local k = sd
                        if not bk or k < bk then best, bk = { char = ch, part = part, hum = hum, dist = dist }, k end
                    end
                end
            end
        end
        return best
    end
    local function pick(cam, origin)
        -- 1) alvo do farm (sempre prioridade)
        if Config.AimSource == "Bounty Target" and Fight.char then
            local ch = Fight.char
            local hum, hrp = ch:FindFirstChildOfClass("Humanoid"), ch:FindFirstChild("HumanoidRootPart")
            if hum and hrp and hum.Health > 0 then
                return { char = ch, part = partOf(ch) or hrp, hum = hum, dist = (hrp.Position - cam.CFrame.Position).Magnitude }
            end
        end
        -- 2) sticky
        if Config.AimSticky and cur and cur.char.Parent and cur.hum.Health > 0
            and (cur.part.Position - cam.CFrame.Position).Magnitude <= (tonumber(Config.AimMaxDist) or 1500) * 1.2 then
            return cur
        end
        return closestEnemy(cam, origin)
    end

    -- ===== gate (so mexe na mira durante skill / clique) =====
    local function gateOpen()
        if not SA.pos or not SA.roll then return false end
        if Config.AimGate == "Always" or touchOnly then return true end
        if os.clock() < SA.forceUntil or os.clock() < (Config.AttackUntil or 0) then return true end
        if UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then return true end
        for _, k in pairs(SKILL_CODES) do if UIS:IsKeyDown(k) then return true end end
        return os.clock() - SA.releaseAt < 0.35
    end
    local function effMode()
        local m = Config.AimMode
        if (m == "Silent" or m == "Both") and not hookmetamethod then return "Camera Lock" end
        return m
    end
    table.insert(Connections, UIS.InputEnded:Connect(function() SA.releaseAt = os.clock() end))

    local function installHooks()
        if hooked or not hookmetamethod then return end
        hooked = true
        local mouse = Player:GetMouse()
        local wrap = newcclosure or function(f) return f end
        local isCaller = checkcaller or function() return false end
        local ok1 = pcall(function()
            local old
            old = hookmetamethod(game, "__index", wrap(function(self, key)
                if self == mouse and (key == "Hit" or key == "Target" or key == "X" or key == "Y" or key == "UnitRay")
                    and Alive and effMode() ~= "Camera Lock" and gateOpen() and not isCaller() then
                    if key == "Hit" then return CFrame.new(SA.pos)
                    elseif key == "Target" then return SA.part
                    elseif key == "X" then return SA.sx
                    elseif key == "Y" then return SA.sy
                    else
                        local cam = workspace.CurrentCamera
                        local o = cam and cam.CFrame.Position or Vector3.zero
                        return Ray.new(o, (SA.pos - o).Unit)
                    end
                end
                return old(self, key)
            end))
        end)
        if not ok1 then hooked = false return end
        pcall(function()
            if not getnamecallmethod then return end
            local oldNc
            oldNc = hookmetamethod(game, "__namecall", wrap(function(self, ...)
                local m = getnamecallmethod()
                if (m == "GetMouseLocation" or m == "ScreenPointToRay" or m == "ViewportPointToRay")
                    and Alive and SA.pos and effMode() ~= "Camera Lock" and not isCaller() and gateOpen() then
                    if m == "GetMouseLocation" then
                        if self == UIS then return Vector2.new(SA.sx, SA.sy) end
                    elseif self == workspace.CurrentCamera then
                        local o = self.CFrame.Position
                        return Ray.new(o, (SA.pos - o).Unit)
                    end
                end
                if (m == "FireServer" or m == "InvokeServer") and Alive and SA.pos and effMode() ~= "Camera Lock"
                    and typeof(self) == "Instance" and not isCaller() then
                    local tool = Player.Character and Player.Character:FindFirstChildOfClass("Tool")
                    if tool and self:IsDescendantOf(tool) and self.Name ~= "LeftClickRemote" and gateOpen() then
                        local args = table.pack(...)
                        local changed = false
                        for i = 1, args.n do
                            local a = args[i]
                            if typeof(a) == "Vector3" and a.Magnitude > 3 and not changed then
                                args[i] = SA.pos; changed = true
                            end
                        end
                        if changed then
                            setnamecallmethod(m)
                            return oldNc(self, table.unpack(args, 1, args.n))
                        end
                    end
                end
                if setnamecallmethod then setnamecallmethod(m) end
                return oldNc(self, ...)
            end))
        end)
    end

    -- ===== FOV (frame, sem Drawing) =====
    local fgui, fframe
    pcall(function()
        fgui = Instance.new("ScreenGui")
        fgui.Name, fgui.IgnoreGuiInset, fgui.ResetOnSpawn = "MoonBountyAimFOV", true, false
        fgui.Parent = (type(gethui) == "function" and gethui()) or game:GetService("CoreGui")
        fframe = Instance.new("Frame")
        fframe.BackgroundTransparency, fframe.AnchorPoint, fframe.Visible = 1, Vector2.new(0.5, 0.5), false
        fframe.Parent = fgui
        Instance.new("UICorner", fframe).CornerRadius = UDim.new(1, 0)
        local st = Instance.new("UIStroke", fframe)
        st.Thickness, st.Color = 1.5, Color3.fromRGB(0, 230, 255)
    end)

    pcall(function() RunService:UnbindFromRenderStep("MoonBountyAimbot") end)
    RunService:BindToRenderStep("MoonBountyAimbot", Enum.RenderPriority.Camera.Value + 1, function(dt)
        if not Alive then
            pcall(function() RunService:UnbindFromRenderStep("MoonBountyAimbot") end)
            SA.pos, SA.part = nil, nil
            pcall(function() if fgui then fgui:Destroy() end end)
            return
        end
        local cam = workspace.CurrentCamera
        if not cam then return end
        local origin = (Config.AimFOVOrigin == "Center" or touchOnly) and (cam.ViewportSize / 2) or UIS:GetMouseLocation()
        if fframe then
            local show = Config.AimOn and Config.AimShowFOV and Config.AimSource ~= "Bounty Target"
            fframe.Visible = show and true or false
            if show then
                local f = tonumber(Config.AimFOV) or 220
                fframe.Size = UDim2.fromOffset(f * 2, f * 2)
                fframe.Position = UDim2.fromOffset(origin.X, origin.Y)
            end
        end
        if not Config.AimOn then
            cur, SA.pos, SA.part = nil, nil, nil
            AM.status = "off"
            return
        end
        local now = os.clock()
        if now - SA.rollAt > 0.3 then
            SA.rollAt = now
            SA.roll = Config.AimGuarantee or math.random(1, 100) <= (tonumber(Config.AimHitChance) or 100)
        end
        cur = pick(cam, origin)
        if not (cur and cur.part and cur.part.Parent) then
            cur, SA.pos, SA.part = nil, nil, nil
            AM.status = "sem alvo"
            return
        end
        cur.dist = (cur.part.Position - cam.CFrame.Position).Magnitude
        local pos = leadPos(cur.part, now)
        local sv = cam:WorldToViewportPoint(pos)
        SA.pos, SA.part, SA.sx, SA.sy = pos, cur.part, sv.X, sv.Y
        local mode = effMode()
        if mode == "Silent" or mode == "Both" then installHooks() end
        -- Camera Lock so enquanto ataca/usa skill (nao rouba a camera quando voce so anda)
        if (mode == "Camera Lock" or mode == "Both") and gateOpen() then
            local goal = CFrame.lookAt(cam.CFrame.Position, pos)
            local s = Config.AimGuarantee and 1 or math.clamp(tonumber(Config.AimSmooth) or 0.35, 0.02, 1)
            local a = (s >= 1) and 1 or (1 - (1 - s) ^ (math.min(dt, 0.1) * 60))
            cam.CFrame = cam.CFrame:Lerp(goal, a)
        end
        local who = Players:GetPlayerFromCharacter(cur.char)
        AM.status = string.format("%s -> %s (%dm)%s", mode, who and who.Name or cur.char.Name, math.floor(cur.dist), SA.roll and "" or " [miss]")
    end)

    -- ===== AUTO SKILLS =====
    -- Z X C V F em sequencia: so quando esta em posicao (ou perto) do alvo; abre o gate do aimbot a cada uso.
    local last = {}
    local function skillReady(tool, key)
        local ok, ready = pcall(function()
            local sk = Player.PlayerGui.Main.Skills:FindFirstChild(tool.Name)
            local fr = sk and sk:FindFirstChild(key)
            local cd = fr and fr:FindFirstChild("Cooldown")
            if not cd then return true end
            local x = cd.Size.X.Scale
            return not (x > 0.02 and x < 0.98)
        end)
        return (not ok) or ready
    end
    task.spawn(function()
        while Alive do
            task.wait(0.08)
            if Config.UseSkills and Config.AutoFarm and Fight.char and State.Busy then
                local ch = Fight.char
                local tr = ch:FindFirstChild("HumanoidRootPart")
                local _, hrp = getChar()
                if tr and hrp and ((Config.SkillOnlyInPos and Fight.inPos) or (not Config.SkillOnlyInPos))
                    and (tr.Position - hrp.Position).Magnitude <= (tonumber(Config.SkillRange) or 150) then
                    local tool = findTool(Config.Weapon)
                    for _, k in ipairs(ORDER) do
                        if not (Alive and Fight.char == ch) then break end
                        if Config.SkillKeys[k] and os.clock() - (last[k] or 0) >= (tonumber(Config.SkillDelay) or 0.25)
                            and (not tool or skillReady(tool, k)) then
                            last[k] = os.clock()
                            equipWeapon()
                            SA.forceUntil = os.clock() + 0.5
                            pressKey(SKILL_CODES[k])
                            Diag.skill = "ultima skill: " .. k
                            task.wait(math.max(0.05, tonumber(Config.SkillDelay) or 0.25))
                        end
                    end
                end
            end
        end
    end)

    function AM.statusText()
        return table.concat({
            "Aimbot: " .. (Config.AimOn and "ON" or "off") .. " | " .. tostring(Config.AimMode) .. " | fonte: " .. tostring(Config.AimSource),
            "Agora: " .. tostring(AM.status),
            "Silent hooks: " .. (hookmetamethod and (hooked and "ativos" or "prontos") or "NAO suportado (usa Camera Lock)"),
            "Skills: " .. (Config.UseSkills and "ON" or "off") .. " | " .. tostring(Diag.skill or "-"),
        }, "\n")
    end
end

