    tg("EspFruit", "ESP Fruit", "Shows the fruits lying on the map (yellow)")
    tg("EspBerry", "ESP Berry", "Shows the berry bushes (green)")
    tg("EspIsland", "ESP Island", "Shows the islands with the distance (blue)")
