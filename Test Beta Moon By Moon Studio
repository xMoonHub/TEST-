    local boss, name = AFL.Boss.find()
    if boss then
        State.Mode, State.Text = "Auto Boss", "Killing " .. boss.Name
        Diag.boss = "killing " .. boss.Name
        if Config.BossQuest and AFL.Boss.q[name] and os.clock() - AFL.Boss.last > 8 then
            local visible, known = questVisible()
            if not (known and visible) then
                AFL.Boss.last = os.clock()
                invoke("StartQuest", AFL.Boss.q[name][1], AFL.Boss.q[name][2])
            end
        end
        if Config.BossKill then
            fightEnemy(boss, { boss.Name }, false)
        else
            local _, r = aliveParts(boss)
            if r and distanceTo(r.CFrame) > 60 then flyTo(r.CFrame * CFrame.new(0, 20, 0)) end
        end
        return true
    end
    -- boss not spawned: model may sit in ReplicatedStorage (like Elite), fly there
    for name in pairs(Config.BossSel or {}) do
