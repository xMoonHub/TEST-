-- ============ ATAQUE: SO O CLICK (M1) DA FRUTA ============
-- Baseado no fruit.lua: usa o LeftClickRemote da propria fruta.
--  * frutas normais (Dragon, T-Rex, Kitsune, Tiger, Yeti, Mammoth...): FireServer(Vector3.new(0.01,-500,0.01), 1, true)
--  * Blade-Blade, Gas-Gas (e Control, Magnet, Pain, Chop): FireServer(direcao_do_alvo, combo) com combo 1..5
-- Modos: Normal / Fast / Super Fast (Super Fast = a cada frame, sem intervalo). O cooldown do M1 e removido em todos.
do
    local CdAt = 0
    local function isCd(name)
        local n = string.lower(name)
        return string.find(n, "cooldown", 1, true) or string.find(n, "debounce", 1, true)
            or string.find(n, "combo", 1, true) or n == "cd" or string.find(n, "delay", 1, true)
    end
    -- zera tudo que parece cooldown/debounce/combo na fruta equipada (a cada 50ms)
    local function stripCooldown()
        local now = os.clock()
        if now - CdAt < 0.05 then return end
        CdAt = now
        local char = Player.Character
        local tool = char and char:FindFirstChildOfClass("Tool")
        if not tool then return end
        for _, holder in ipairs({ tool, char }) do
            for name, v in pairs(holder:GetAttributes()) do
                if isCd(name) then
                    if type(v) == "number" then holder:SetAttribute(name, 0)
                    elseif type(v) == "boolean" and v == true and string.find(string.lower(name), "cooldown", 1, true) then
                        holder:SetAttribute(name, false)
                    end
                end
            end
        end
        for _, d in ipairs(tool:GetDescendants()) do
            if (d:IsA("NumberValue") or d:IsA("IntValue")) and isCd(d.Name) then d.Value = 0
            elseif d:IsA("BoolValue") and string.find(string.lower(d.Name), "cooldown", 1, true) then d.Value = false end
        end
    end

    local M1 = { at = 0, combo = 0, last = 0,
        remoteFruits = { ["Blade-Blade"] = true, ["Gas-Gas"] = true, ["Control-Control"] = true,
            ["Magnet-Magnet"] = true, ["Pain-Pain"] = true, ["Chop-Chop"] = true } }
    local DOWN = Vector3.new(0.01, -500, 0.01)

    local function fruitClick()
        local now = os.clock()
        if now - M1.at < (AttackGap[Config.AttackMode] or 0.25) then return end
        M1.at = now
        local char = Player.Character
        local tool = char and char:FindFirstChildOfClass("Tool")
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not (tool and hrp) then return end
        local remote = tool:FindFirstChild("LeftClickRemote")
        local fname = tool.Name
        local short3 = string.match(fname, "^(%a+)")
        local isRemote = M1.remoteFruits[fname] or (short3 and M1.remoteFruits[short3 .. "-" .. short3])
        local hedged = isRemote and not (fname == "Blade-Blade" or fname == "Gas-Gas") -- Control/Magnet/Pain/Chop
        if remote and tool.ToolTip == "Blox Fruit" and (tool:GetAttribute("ServerState") == nil or hedged) then
            if isRemote then
                local tr = Fight.char and Fight.char:FindFirstChild("HumanoidRootPart")
                if tr then
                    local dir = tr.Position - hrp.Position
                    dir = (dir.Magnitude > 0.1) and dir.Unit or Vector3.new(0, -1, 0)
                    if now - M1.last > 0.65 then M1.combo = 0 end
                    M1.last = now
                    for _ = 1, 3 do
                        M1.combo = M1.combo % 5 + 1
                        pcall(remote.FireServer, remote, dir, M1.combo)
                        if hedged then
                            -- formatos alternativos (posicao do alvo): o remote ignora o que nao entende
                            pcall(remote.FireServer, remote, tr.Position, M1.combo)
                            pcall(remote.FireServer, remote, tr.Position, dir, M1.combo)
                        end
                    end
                end
                if hedged then
                    pcall(remote.FireServer, remote, DOWN, 1, true)
                    pcall(function() tool:Activate() end)
                end
            else
                for _ = 1, 3 do pcall(remote.FireServer, remote, DOWN, 1, true) end
            end
            return
        end
        -- fruta sem LeftClickRemote (ou com ServerState): Activate em rajada + remote se existir
        for _ = 1, 3 do pcall(function() tool:Activate() end) end
        if remote then pcall(remote.FireServer, remote, DOWN, 1, true) end
    end
    AB.fruitClick = fruitClick

    local lastEquip = 0
    table.insert(Connections, RunService.Heartbeat:Connect(function()
        if not Alive then return end
        if not (State.Busy and os.clock() < Config.AttackUntil) then return end
        if os.clock() - lastEquip > 1 then
            lastEquip = os.clock()
            pcall(equipWeapon)
        end
        pcall(stripCooldown)
        pcall(fruitClick)
    end))

    -- Frutas que precisam do V (transformar) antes de usar o M1
    local BeastFruits = { "tiger", "leopard", "yeti", "mammoth", "mamute" }
    local Transform = { char = nil }
    function AB.transformStep()
        local char = Player.Character
        if not char or Transform.char == char then return end
        local tool = findTool("Blox Fruit")
        if not tool then return end
        Transform.char = char
        local n = string.lower(tool.Name)
        for _, k in ipairs(BeastFruits) do
            if string.find(n, k, 1, true) then
                equipWeapon()
                task.wait(0.4)
                pressKey(Enum.KeyCode.V)
                task.wait(0.8)
                Diag.fight = "transformei (" .. tool.Name .. ")"
                return
            end
        end
    end

    -- Aviso sobre a fruta equipada (aparece no diagnostico)
    function AB.fruitNote()
        local tool = findTool("Blox Fruit")
        if not tool then return "nenhuma fruta comida encontrada" end
        return tool.Name .. (tool:FindFirstChild("LeftClickRemote") and " (M1 ok)" or " (sem LeftClickRemote: uso Tool:Activate)")
    end
end

