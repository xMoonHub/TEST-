        Fluent:Notify({ Title = "Moon Hub Auto Bounty", Content = "Carregado no Mar " .. getSea() .. ".", Duration = 4 })
    else
        Fluent:Notify({ Title = "Moon Hub Auto Bounty", Content = "Remote do Blox Fruits não encontrado: a UI abre, mas o farm não funciona neste jogo.", Duration = 8 })
    end
