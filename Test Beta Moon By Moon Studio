-- hook no mouse: Mouse.Hit / Mouse.Target apontam para o chão do vaso enquanto a mira está ativa
function AFL.tvHook()
    local V = AFL.TV
    if V.hooked or not hookmetamethod then return end
    V.hooked = true
    local mouse = Player:GetMouse()
    local wrap = newcclosure or function(f) return f end
    local old
    local ok = pcall(function()
        old = hookmetamethod(game, "__index", wrap(function(self, key)
            if self == mouse and Alive and V.aimPos and not (checkcaller and checkcaller()) then
                if key == "Hit" then return CFrame.new(V.aimPos) end
                if key == "Target" then return V.aimPart end
            end
            return old(self, key)
        end))
    end)
    if not ok then V.hooked = false end
end
function AFL.tvAimDown(pos, action)
    local V = AFL.TV
    local char = Player.Character
    if not char then return end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { char, workspace:FindFirstChild("Enemies") or char }
    local hit = workspace:Raycast(pos, Vector3.new(0, -300, 0), params)
    local aimPos = hit and hit.Position or (pos - Vector3.new(0, 20, 0))
    local aimPart = hit and hit.Instance
    AFL.tvHook()
    V.aimPos, V.aimPart = aimPos, aimPart
    local cam = workspace.CurrentCamera
    pcall(function() RunService:UnbindFromRenderStep("MoonHubAimDown") end)
    pcall(function()
        RunService:BindToRenderStep("MoonHubAimDown", Enum.RenderPriority.Camera.Value + 2, function()
            local _, yaw = cam.CFrame:ToOrientation()
            cam.CFrame = CFrame.new(cam.CFrame.Position) * CFrame.fromOrientation(-math.rad(89), yaw, 0)
        end)
    end)
    task.wait(0.2)
    pcall(action, aimPos, aimPart)
    pcall(function() RunService:UnbindFromRenderStep("MoonHubAimDown") end)
    V.aimPos, V.aimPart = nil, nil
end
function AFL.tvShoot(pos)
    AFL.tvAimDown(pos, function(aimPos, aimPart)
        local char = Player.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local netF = ReplicatedStorage:FindFirstChild("Modules") and ReplicatedStorage.Modules:FindFirstChild("Net")
        local shootEvent = netF and netF:FindFirstChild("RE/ShootGunEvent")
        local cam = workspace.CurrentCamera
        for _ = 1, 5 do
            if not (Alive and Config.KillTyrant) then return end
            local tool = char and char:FindFirstChildOfClass("Tool")
            if not (tool and tool.Name == "Skull Guitar") then
                local g = Player.Backpack:FindFirstChild("Skull Guitar")
                if g and hum then hum:EquipTool(g) task.wait(0.3) end
                tool = char and char:FindFirstChildOfClass("Tool")
            end
            if not tool then return end
            pcall(function() tool:Activate() end)
            pcall(function()
                VirtualUser:CaptureController()
                VirtualUser:Button1Down(Vector2.new(1280, 672))
                VirtualUser:Button1Up(Vector2.new(1280, 672))
            end)
            if mouse1click then pcall(mouse1click) end
            pcall(function()
                local s = cam.ViewportSize
                local cx, cy = s.X / 2, s.Y / 2
                VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, true, game, 0)
                VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, false, game, 0)
            end)
            pcall(function()
                local s = cam.ViewportSize
                local cx, cy = s.X / 2, s.Y / 2
                VirtualInputManager:SendTouchEvent(1, 0, cx, cy)
                task.wait(0.05)
                VirtualInputManager:SendTouchEvent(1, 2, cx, cy)
            end)
            if shootEvent then pcall(shootEvent.FireServer, shootEvent, aimPos, { aimPart }) end
            local sf = tool:FindFirstChild("RemoteFunctionShoot")
            if sf then task.spawn(pcall, sf.InvokeServer, sf, aimPos, aimPart) end
            task.wait(0.3)
        end
    end)
end
-- sem Skull Guitar: cada arma que você tiver (fruta, melee, espada, gun): M1 por ~1s + skills Z X C V F
function AFL.tvSkills(abort)
    local char = Player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    for _, tip in ipairs({ "Blox Fruit", "Melee", "Sword", "Gun" }) do
        if abort() then return end
        local tool = findTool(tip)
        if tool then
            hum:EquipTool(tool)
            task.wait(0.3)
            local t0 = os.clock()
            while os.clock() - t0 < 1 and not abort() do
                if tip == "Melee" then
                    pcall(cfAttack)
                else
                    pcall(function() tool:Activate() end)
                end
                task.wait(0.08)
            end
            local low = string.lower(tool.Name)
            local isTransform = false
            for _, w in ipairs(AFL.TV.transform) do
                if tip == "Blox Fruit" and string.find(low, w, 1, true) then isTransform = true end
            end
            for _, k in ipairs({ "Z", "X", "C", "V", "F" }) do
                if abort() then return end
                if not (isTransform and k == "V") then
                    AFL.potKey(k)
                    task.wait(0.3)
                end
            end
        end
    end
end
function AFL.tvRun()
    local V = AFL.TV
    if V.running then return end
    V.running = true
    task.spawn(function()
        local function abort()
            return not (Alive and Config.KillTyrant) or bossAlive("Tyrant of the Skies") ~= nil
        end
        local ok, err = pcall(function()
            for i, pos in ipairs(V.vases) do
                if abort() then break end
                V.idx = i
                local cf = CFrame.new(pos)
                local t0 = os.clock()
                while not abort() and os.clock() - t0 < 60 do
                    local _, hrp = getChar()
                    if not hrp or (hrp.Position - pos).Magnitude <= 8 then break end
                    flyTo(cf)
                    task.wait(0.1)
                end
                if abort() then break end
                local _, hrp = getChar()
                if hrp then
                    if currentTween then currentTween:Cancel() end
                    hrp.CFrame = cf
                    hrp.AssemblyLinearVelocity = Vector3.zero
                end
                if findToolByName("skull guitar") then
                    Diag.summon = string.format("Auto Tyrant step 2: pot %d/%d with the Skull Guitar", i, #V.vases)
                    AFL.tvShoot(pos)
                else
                    if os.clock() - V.warnAt > 30 then
                        V.warnAt = os.clock()
                        pcall(function() Fluent:Notify({ Title = "Moon Hub - Tyrant", Content = "No Skull Guitar: using M1 + weapon skills", Duration = 5 }) end)
                    end
                    Diag.summon = string.format("Auto Tyrant step 2: pot %d/%d with M1 + skills (no Skull Guitar)", i, #V.vases)
                    AFL.tvAimDown(pos, function() AFL.tvSkills(abort) end)
                end
                local t1 = os.clock()
                while os.clock() - t1 < 2 and not abort() do task.wait(0.2) end
            end
            V.done += 1
        end)
        if not ok then Diag.summon = "Auto Tyrant step 2: error " .. tostring(err) end
        pcall(function() RunService:UnbindFromRenderStep("MoonHubAimDown") end)
        AFL.TV.aimPos, AFL.TV.aimPart = nil, nil
        V.running = false
    end)
end
function AFL.tvStep()
    local V = AFL.TV
    State.Mode = "Auto Tyrant of the Skies"
    State.Text = string.format("Breaking pots (%d/%d, rounds: %d)", math.max(V.idx, 1), #V.vases, V.done)
    AFL.tvRun() -- só inicia se não houver uma rodada em andamento
    return true
end

function AFL.tyrantStep()
    if getSea() ~= 3 then
        Diag.summon = "Auto Tyrant: only works in Sea 3"
        return false
    end
    local _, hrp = getChar()
    if not hrp then return false end
    -- v27: 4 olhos acesos (lidos do mapa) = próxima missão: quebrar os 4 vasos. Sem o modelo dos olhos: 300 kills.
    local eyes, known = AFL.tyrantEyes()
    local V = AFL.TV
    local lit = known and (eyes >= 4) or ((not known) and AFL.TyrantCount.n >= AFL.TyrantNeed)
    if not lit then V.needReset = false end
    if lit and not V.needReset and not AFL.TyrantCount.boss then
        if not Config.TyrantSpawn then
            Diag.summon = "Auto Tyrant: Auto Spawn is off (the pots will not be broken)"
            return false
        end
        return AFL.tvStep()
    end

    local loc = AFL.tikiLocation()
    if not loc then
        Diag.summon = "Auto Tyrant: could not find the Tiki Outpost on the map (go there once)"
        return false
    end
    local T = AFL.Tiki
    local best, bd, n = nil, math.huge, 0
    for _, e in ipairs(enemiesList()) do
        local eh, er = aliveParts(e)
        if eh and not string.find(e.Name, "Tyrant", 1, true)
            and ((er.Position - loc).Magnitude < 1500 or matchName(e.Name, AFL.TikiMobs)) then
            n += 1
            local d = (hrp.Position - er.Position).Magnitude
            if d < bd then best, bd = e, d end
        end
    end
    State.Mode = "Auto Tyrant of the Skies"
    local now = os.clock()
    if best then
        T.since, T.last = now, now
        Diag.summon = string.format("Auto Tyrant: Tiki Outpost; mobs alive nearby: %d (every kill counts for the statues)", n)
        State.Text = string.format("Farming the Tiki Outpost: %s (%d NPCs left)", best.Name,
            math.max(0, AFL.TyrantNeed - AFL.TyrantCount.n))
        if Config.TyrantQuest then
            -- Auto Quest: pega a última quest do Tiki e mata os mobs (todos os tipos da ilha)
            AFL.TikiQuest.npc = AFL.tikiNpcCF(loc)
            farmQuestStep(AFL.TikiQuest, "Auto Tyrant", true, AFL.tikiNames(loc), true)
        else
            fightEnemy(best, AFL.tikiNames(loc), true)
        end
        return true
    end
    -- nenhum mob carregado: patrulha para o jogo carregar/nascer os mobs
    if now - T.last > 3 then T.since = now end -- começou uma nova busca
    T.last = now
    local t = now - T.since
    local sps = AFL.tikiSpawns(loc)
    local target
    if #sps > 0 then
        local idx = (math.floor(t / 6) % #sps) + 1
