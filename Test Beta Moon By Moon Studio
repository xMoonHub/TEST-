-- 1) tenta o remote de onde estiver; 2) se não vier fruta, voa até o NPC e tenta de novo
--    (remote, ProximityPrompt e botão da janela do gacha). O resultado fica em Status > Diagnóstico.
local Gacha = { nextAt = 0, last = "ainda não girou", tries = 0, phase = "idle", travelSince = 0, pauseUntil = 0 }
pcall(function()
    if canFile() and isfile("MoonHub_gacha.txt") then
        Gacha.nextAt = tonumber(readfile("MoonHub_gacha.txt")) or 0
    end
end)
local function saveGacha()
    pcall(function()
        if canFile() then writefile("MoonHub_gacha.txt", tostring(Gacha.nextAt)) end
    end)
end

local function describe(v)
    if type(v) == "table" then
        local parts, n = {}, 0
        for k, x in pairs(v) do
            n += 1
            if n > 5 then break end
            parts[#parts + 1] = tostring(k) .. "=" .. tostring(x)
        end
        return "{" .. table.concat(parts, ", ") .. "}"
    end
    return tostring(v)
end

local function npcPart(m)
    return m:FindFirstChild("HumanoidRootPart") or m.PrimaryPart or m:FindFirstChildWhichIsA("BasePart")
end

-- Nomes de NPCs por perto (ajuda a achar o NPC certo se o gacha mudar de nome)
local function nearbyNpcNames()
    local names, seen = {}, {}
    local _, hrp = getChar()
    local npcs = workspace:FindFirstChild("NPCs")
    if npcs and hrp then
        for _, m in ipairs(npcs:GetChildren()) do
            local part = npcPart(m)
            if part and not seen[m.Name] and (part.Position - hrp.Position).Magnitude < 400 then
                seen[m.Name] = true
                names[#names + 1] = m.Name
                if #names >= 8 then break end
            end
        end
    end
    return #names > 0 and table.concat(names, ", ") or "nenhum"
end

local ZiolesCache, ZiolesLast = nil, 0
local function findGachaNpc()
    local _, hrp = getChar()
    -- NPC "Zioles": primeiro em workspace.NPCs, depois uma busca geral (no máx. a cada 5s)
    if ZiolesCache and ZiolesCache.Parent then return ZiolesCache end
    local z = workspace:FindFirstChild("NPCs") and workspace.NPCs:FindFirstChild("Zioles")
    if not z and os.clock() - ZiolesLast > 5 then
        ZiolesLast = os.clock()
        z = workspace:FindFirstChild("Zioles", true)
    end
    if z and z:IsA("Model") and npcPart(z) then
        ZiolesCache = z
        return z
    end
    local npcs = workspace:FindFirstChild("NPCs")
    if not npcs then return end
    local best, bestD = nil, math.huge
    for _, m in ipairs(npcs:GetChildren()) do
        local n = string.lower(m.Name)
        if string.find(n, "cousin", 1, true) or string.find(n, "gacha", 1, true) or string.find(n, "zioles", 1, true) then
            local part = npcPart(m)
            if part then
                local d = hrp and (hrp.Position - part.Position).Magnitude or 0
                if d < bestD then best, bestD = m, d end
            end
        end
    end
    return best
end

-- Chama o remote e confere se veio fruta (ou se a resposta parece o tempo restante do cooldown)
-- Quantas frutas estão GUARDADAS no inventário (o gacha pode mandar a fruta direto para lá)
local function invFruitCount()
    local ok, inv = invoke("getInventoryFruits")
    if ok and type(inv) == "table" then
        local n = 0
        for _ in pairs(inv) do n += 1 end
        return n
    end
end

-- Recebeu fruta? (mochila OU inventário)
local function gotFruit(beforeBag, beforeInv)
    if countFruits() > beforeBag then return true end
    local now = invFruitCount()
    return beforeInv ~= nil and now ~= nil and now > beforeInv
end

local function tryRoll()
    local before, beforeInv = countFruits(), invFruitCount()
    Gacha.rollClock = os.clock()
    local ok, r
    local net = ReplicatedStorage:FindFirstChild("Modules") and ReplicatedStorage.Modules:FindFirstChild("Net")
    local rf = net and net:FindFirstChild("RF/GachaNetworkRF")
    if rf then
        ok, r = pcall(function()
            return rf:InvokeServer({ Context = "Purchase", BoxName = "ZiolesGacha" })
        end)
    else
        ok, r = invoke("Cousin", "Buy") -- plano B (remote antigo)
    end
    Gacha.tries += 1
    Gacha.last = (ok and "resposta: " or "erro: ") .. describe(r)
    task.wait(1.5)
    if gotFruit(before, beforeInv) then return true, "fruta recebida" end
    if ok and type(r) == "string" then
        local l = string.lower(r)
        if string.find(l, "cooldown", 1, true) or string.find(l, "wait", 1, true)
            or string.find(l, "hour", 1, true) or string.find(l, "minute", 1, true) then
            return true, "em cooldown (texto do jogo)", 1800
        end
    end
    if ok and type(r) == "number" and r >= 30 and r <= 7200 then
        return true, "em cooldown", math.floor(r)
    end
    if ok and type(r) == "table" then
        if r.Success == true or r.success == true then return true, "gacha aceito" end
        for k, v in pairs(r) do
            local key = string.lower(tostring(k))
            if type(v) == "number" and v >= 30 and v <= 7200
                and (string.find(key, "cool", 1, true) or string.find(key, "remain", 1, true) or string.find(key, "time", 1, true)) then
                return true, "em cooldown (" .. tostring(k) .. ")", math.floor(v)
            end
        end
    end
    return false
end

