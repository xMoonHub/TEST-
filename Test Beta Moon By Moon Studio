-- ---------- pegar a quest ----------
function DHF.take(data, reason)
    if os.clock() - DHF.lastTry < 6 then return end
    DHF.lastTry = os.clock()
    if DHF.uiActive() then DHF.takenAt = os.clock() return end
    -- já pegou uma quest e ainda não matou todos os mobs dela: NÃO pega outra
    if DHF.total and DHF.takenAt > 0 and DHF.kills < DHF.total and os.clock() - DHF.takenAt < 150 then
        Diag.quest = string.format("quest in progress: %d/%d killed; I only take another when all are dead", DHF.kills, DHF.total)
        return
    end
    qlog(string.format("Taking quest (%s): %s", tostring(reason or "?"), data.Label))

    local area = DHF.getArea(data.Mobs)
    local cf
    if area then
        cf = CFrame.new(area.center + Vector3.new(0, 12, 0))
    else
        local sp = DHF.nearestSpawn(data.Mobs)
        if sp then cf = sp.CFrame * CFrame.new(0, 12, 0) end
    end
    if cf then DHF.flyWait(cf, 90) end
    if not Alive or Config.Mode ~= "Level" then return end
    if DHF.uiActive() then DHF.takenAt = os.clock() return end

    local function start()
        invoke("StartQuest", data.Quest.Name, data.Quest.Level)
        task.wait(0.6)
    end
    start()

    -- não apareceu: vai até o NPC mais perto da área e tenta de novo
    if not DHF.uiActive() then
        local sp = DHF.nearestSpawn(data.Mobs)
        local anchor = area and area.center or (sp and sp.Position)
        local npcs = workspace:FindFirstChild("NPCs")
        if anchor and npcs then
            local bestPos, bestD = nil, 600
            for _, n in ipairs(npcs:GetChildren()) do
                local okp, p = pcall(function() return n:GetPivot().Position end)
                if okp then
                    local d = (p - anchor).Magnitude
                    if d < bestD then bestPos, bestD = p, d end
                end
            end
            if bestPos then
                DHF.flyWait(CFrame.new(bestPos + Vector3.new(0, 4, 0)), 90)
                if not Alive or Config.Mode ~= "Level" then return end
                start()
            end
        end
    end
    DHF.takenAt, DHF.lastSeen = os.clock(), os.clock()
    DHF.lastCur, DHF.lastMax = 0, nil
    DHF.kills = 0
end

