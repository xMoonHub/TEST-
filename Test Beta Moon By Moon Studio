        l.BackgroundTransparency, l.TextColor3 = 1, Color3.fromRGB(255, 40, 40)
        l.TextStrokeTransparency, l.TextStrokeColor3 = 0, Color3.new(0, 0, 0)
        l.Font, l.TextSize = Enum.Font.GothamBold, 38
