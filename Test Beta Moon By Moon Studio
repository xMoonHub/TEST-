    -- ===== Priorities =====
    sub("Priorities")
    local NONE = "None"
    local dds = {}
    local function enabledLabels()
        local out = {}
        for _, key in ipairs(AFL.FeatOrder) do
            local f = AFL.feat[key]
            if f.labels then
                for _, l in ipairs(f.labels()) do out[#out + 1] = l end
            elseif not f.hidden and f.listed() then
                out[#out + 1] = f.label
            end
        end
        return out
    end
    local function valuesFor(i)
        local vals, seen = { NONE }, { [NONE] = true }
        for _, l in ipairs(enabledLabels()) do
            if not seen[l] then seen[l] = true; vals[#vals + 1] = l end
        end
        local cur = Config.Prio[i]
        if cur and cur ~= "" and not seen[cur] then vals[#vals + 1] = cur end
        return vals
    end
    local busy, fillDefault, pt = false, nil, nil
    if Config.PrioDefault == nil then
        local any = false
        for _, v in ipairs(Config.Prio) do if v and v ~= "" and v ~= NONE then any = true end end
        Config.PrioDefault = not any
    end
    local slots = math.max(5, #Config.Prio)
    local function addSlot(i)
        Config.Prio[i] = Config.Prio[i] or NONE
        local dd = Tabs.Farm:AddDropdown("Prio" .. i, {
            Title = "Priority " .. i, Values = valuesFor(i), Default = Config.Prio[i],
            Description = (i == 1) and "Runs first. Lists the functions you have turned on (quests excluded)." or nil,
        })
        dd:OnChanged(function(v)
            if busy then return end
            v = v or NONE
            Config.Prio[i] = v
            busy = true
            if Config.PrioDefault then Config.PrioDefault = false; if pt then pcall(function() pt:SetValue(false) end) end end
            -- sem repetir a mesma função em dois slots (evita conflito): a antiga vira None
            if v ~= NONE then
                for j, d2 in pairs(dds) do
                    if j ~= i and Config.Prio[j] == v then Config.Prio[j] = NONE; pcall(function() d2:SetValue(NONE) end) end
                end
            end
            busy = false
            persist()
        end)
        dds[i] = dd
    end
    pt = Tabs.Farm:AddToggle("PrioDefault", { Title = "Default Priorities (recommended)",
        Description = "Uses the script's own order, built so functions never fight each other: Dungeon > Raid > Fruit > Mirage > Vulcan > Sea > Pirate > Elite > Factory > Chest > Boss > Awk Boss > Tyrant > Dough Prince > Normal Farm. Change any slot below to make your own order (this turns off)",
        Default = Config.PrioDefault and true or false })
    pt:OnChanged(function(v)
        if busy then return end
        Config.PrioDefault = v and true or false
        if v then fillDefault() end
        persist()
    end)
    Tabs.Farm:AddButton({ Title = "Reset to default priorities", Description = "Goes back to the script's recommended order",
        Callback = function() if pt then pt:SetValue(true) end; fillDefault() end })
    local ordInfo = Tabs.Farm:AddParagraph({ Title = "Current order", Content = "..." })
    for i = 1, slots do addSlot(i) end
    fillDefault = function()
        busy = true
        local list = enabledLabels()
        while #dds < #list do slots += 1; addSlot(slots) end
        for i, dd in ipairs(dds) do
            local v = list[i] or NONE
            Config.Prio[i] = v
            pcall(function() dd:SetValue(v) end)
        end
        busy = false
        persist()
    end
    if Config.PrioDefault then task.defer(fillDefault) end
    Tabs.Farm:AddButton({ Title = "Add new priority", Description = "Creates one more priority slot (no limit)",
