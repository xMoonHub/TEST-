-- Segue o alvo a cada frame (Heartbeat E Stepped): o jogador fica grudado nele, para o servidor ver a posicao
local function stickToTarget()
    if not (Alive and Fight.active) then return end
    if os.clock() > Fight.expires then
        Fight.active, Fight.inPos = false, false
        return
    end
    local _, hrp = getChar()
    local tr = Fight.char and Fight.char:FindFirstChild("HumanoidRootPart")
    if not (hrp and tr) then return end
    local stand = tr.Position + Vector3.new(0, Config.HoverHeight, 0)
    if (hrp.Position - stand).Magnitude < 6 then
        -- GRUDADO no jogador (mesma posicao dele, N studs acima); mantem a rotacao atual
        hrp.CFrame = CFrame.new(stand) * hrp.CFrame.Rotation
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
    end
end
