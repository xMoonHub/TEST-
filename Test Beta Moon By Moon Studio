    -- Soul Reaper: usa a Hallow Essence no altar (precisa estar com ela)
    if Config.SummonReaper and not bossAlive("Soul Reaper") then
        if not hasItem("Hallow Essence") then
            Diag.summon = "Soul Reaper: no Hallow Essence"
        elseif now - Summon.reaper > 8 then
            local map = workspace:FindFirstChild("Map")
            local hc = map and map:FindFirstChild("Haunted Castle")
            local altar = hc and hc:FindFirstChild("Summoner", true)
            local cf = altar and posOf(altar)
