-- ============ FPS BOOSTER (tira as texturas do jogo) ============
AFL.Fps = { on = false, conn = nil, running = false }
function AFL.fpsStrip(d)
    pcall(function()
        -- não mexe em personagens (jogadores/NPCs) nem em interface: só no cenário (evita bugar o mouse/clique)
        local mdl = d:FindFirstAncestorWhichIsA("Model")
        if mdl and mdl:FindFirstChildOfClass("Humanoid") then return end
        if d:IsA("BasePart") then
            d.Material = Enum.Material.SmoothPlastic
            d.Reflectance = 0
            d.CastShadow = false
            if d:IsA("MeshPart") then d.TextureID = "" end
        elseif d:IsA("Decal") or d:IsA("Texture") then
            d.Transparency = 1
        elseif d:IsA("SurfaceAppearance") then
            d:Destroy()
        elseif d:IsA("ParticleEmitter") or d:IsA("Trail") or d:IsA("Beam") or d:IsA("Smoke")
            or d:IsA("Fire") or d:IsA("Sparkles") or d:IsA("PostEffect") then
            d.Enabled = false
        end
    end)
end
function AFL.fpsApply(on)
    local F = AFL.Fps
    if not on then
        F.on = false
        if F.conn then pcall(function() F.conn:Disconnect() end) F.conn = nil end
        return
    end
    if F.on then return end
    F.on = true
    pcall(function()
        local L = game:GetService("Lighting")
        L.GlobalShadows = false
        L.FogEnd = 9e9
        for _, e in ipairs(L:GetChildren()) do AFL.fpsStrip(e) end
    end)
    -- limpa tudo que existe agora (em lotes para não travar) e tudo que carregar depois
    task.spawn(function()
        local n = 0
        for _, d in ipairs(workspace:GetDescendants()) do
            if not (F.on and Alive) then return end
            AFL.fpsStrip(d)
            n += 1
            if n % 150 == 0 then task.wait(0.03) end
        end
    end)
    F.conn = workspace.DescendantAdded:Connect(function(d)
        if F.on and Alive then task.defer(AFL.fpsStrip, d) end
    end)
    table.insert(Connections, F.conn)
end

