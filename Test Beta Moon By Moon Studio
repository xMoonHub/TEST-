-- ============ ANIMATIONS + TOGGLE GUI BUTTON ============
do
    local TweenService = game:GetService("TweenService")
    local UIS = game:GetService("UserInputService")
    local root = Window and Window.Root
    -- estilos de animação escolhidos pelo jogador (Interface > Animation Style)
    AFL.animStyle = function(dir)
        local st = Config.UIAnimStyle or "Smooth"
        local map = { Smooth = { In = Enum.EasingStyle.Quart, Out = Enum.EasingStyle.Quint }, Bouncy = { In = Enum.EasingStyle.Back, Out = Enum.EasingStyle.Back },
            Snappy = { In = Enum.EasingStyle.Expo, Out = Enum.EasingStyle.Expo }, Soft = { In = Enum.EasingStyle.Sine, Out = Enum.EasingStyle.Sine } }
        return (map[st] or map.Smooth)[dir or "Out"]
    end
    local function tw(inst, t, props, style, dir)
        local dur = (Config.UIAnim == false) and 0.001 or (t / math.clamp(tonumber(Config.UIAnimSpeed) or 1, 0.3, 3))
        local tween = TweenService:Create(inst, TweenInfo.new(dur, style or AFL.animStyle("Out"), dir or Enum.EasingDirection.Out), props)
        tween:Play()
        return tween
    end

    -- ---- window open / close: smooth scale (UIScale) ----
    if root then
        -- scale around the center: the window anchor must be the middle (keeps the same place on screen)
        pcall(function()
            local ap = root.AnchorPoint
            if math.abs(ap.X - 0.5) > 0.01 or math.abs(ap.Y - 0.5) > 0.01 then
                local sz = root.AbsoluteSize
                if sz.X < 10 then sz = Vector2.new(root.Size.X.Offset, root.Size.Y.Offset) end
                root.Position = root.Position + UDim2.fromOffset(sz.X * (0.5 - ap.X), sz.Y * (0.5 - ap.Y))
                root.AnchorPoint = Vector2.new(0.5, 0.5)
            end
        end)
        local sc = root:FindFirstChild("MHScale") or Instance.new("UIScale")
        AFL.uiScale = math.clamp(tonumber(Config.UIScale) or 1, 0.5, 1.4)
        sc.Name, sc.Scale = "MHScale", AFL.uiScale
        sc.Parent = root
        local orig = Window.Minimize
        local busy = false
        if type(orig) == "function" then
            Window.Minimize = function(self, ...)
                if busy then return end
                busy = true
                local args = table.pack(...)
                local closing = not self.Minimized
                if closing then
                    local t = tw(sc, 0.2, { Scale = 0.9 * AFL.uiScale }, AFL.animStyle("In"), Enum.EasingDirection.In)
                    t.Completed:Wait()
                    pcall(orig, self, table.unpack(args, 1, args.n))
                    sc.Scale = AFL.uiScale
                else
                    sc.Scale = 0.9 * AFL.uiScale
                    pcall(orig, self, table.unpack(args, 1, args.n))
                    tw(sc, 0.42, { Scale = AFL.uiScale }, AFL.animStyle("Out"), Enum.EasingDirection.Out)
                end
                busy = false
            end
        end

        -- ---- tab switch: each tab page "pops" in smoothly when it becomes visible ----
        local function hookPage(sf)
            if sf:GetAttribute("MHPage") or not sf:IsA("ScrollingFrame") then return end
            sf:SetAttribute("MHPage", true)
            local us = Instance.new("UIScale")
            us.Name, us.Scale, us.Parent = "MHPageScale", 1, sf
            sf:GetPropertyChangedSignal("Visible"):Connect(function()
                if sf.Visible and not AFL.mobile then
                    us.Scale = 0.965
                    tw(us, 0.34, { Scale = 1 }, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
                end
            end)
        end
        local function scan()
            for _, d in ipairs(root:GetDescendants()) do
                if d:IsA("ScrollingFrame") and d.AbsoluteSize.X > 250 and d.AbsoluteSize.Y > 150 then pcall(hookPage, d) end
            end
        end
        scan()
        task.delay(1.5, function() if Alive then pcall(scan) end end)
    end

    -- ---- Toggle GUI button (mobile friendly) with the moon image ----
    local MOON_B64 = ""
    local function b64dec(data)
        local alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
        local map = {}
        for i = 1, #alphabet do map[string.byte(alphabet, i)] = i - 1 end
        local out, bits, nbits = {}, 0, 0
        for i = 1, #data do
            local v = map[string.byte(data, i)]
            if v then
                bits = bits * 64 + v
                nbits = nbits + 6
                if nbits >= 8 then
                    nbits = nbits - 8
                    local byte = math.floor(bits / 2 ^ nbits)
                    bits = bits - byte * 2 ^ nbits
                    out[#out + 1] = string.char(byte)
                end
            end
        end
        return table.concat(out)
    end
    local parent = (gethui and gethui()) or game:GetService("CoreGui")
    pcall(function() local o = parent:FindFirstChild("MoonHubToggle"); if o then o:Destroy() end end)
    local gui = Instance.new("ScreenGui")
    gui.Name, gui.ResetOnSpawn, gui.IgnoreGuiInset, gui.DisplayOrder = "MoonHubToggle", false, true, 999
    gui.Parent = parent
    AFL.ToggleGui = gui
    local btn = Instance.new("ImageButton")
    btn.Name = "Toggle"
    btn.AutoButtonColor = false
    btn.Size = UDim2.fromOffset(52, 52)
    btn.Position = UDim2.fromOffset(140, 64) -- top-left, just below the Roblox menu/chat pill (not covering it)
    btn.BackgroundColor3, btn.BackgroundTransparency = Color3.fromRGB(18, 18, 24), 0.25
    btn.Image = ""
    btn.Parent = gui
    Instance.new("UICorner", btn).CornerRadius = UDim.new(1, 0)
    local stroke = Instance.new("UIStroke")
    stroke.Color, stroke.Thickness, stroke.Transparency = Color3.fromRGB(255, 255, 255), 2.5, 0
    stroke.Parent = btn
    local bscale = Instance.new("UIScale", btn)
    local moon = Instance.new("ImageLabel")
    moon.BackgroundTransparency = 1
    moon.AnchorPoint = Vector2.new(0.5, 0.5)
    moon.Position = UDim2.fromScale(0.5, 0.5)
    moon.Size = UDim2.fromOffset(36, 36) -- fits inside the circle, no squashing (square image, Fit)
    moon.ScaleType = Enum.ScaleType.Fit
    pcall(function() moon.ResampleMode = Enum.ResamplerMode.Pixelated end)
    moon.Parent = btn
    local okImg = false
    if writefile and getcustomasset then
        pcall(function()
            writefile("MoonHub_moon.png", b64dec(MOON_B64))
            moon.Image = getcustomasset("MoonHub_moon.png")
            okImg = true
        end)
    end
    if not okImg then
        local fb = Instance.new("TextLabel")
        fb.BackgroundTransparency, fb.Size, fb.Text = 1, UDim2.fromScale(1, 1), "☾"
        fb.TextColor3, fb.TextScaled, fb.Font = Color3.new(1, 1, 1), true, Enum.Font.GothamBold
        fb.Parent = btn
    end

    -- click = open / close (animated) | drag = move the button (clamped to the screen)
    local dragging, moved, startPos, startInput
    btn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging, moved = true, false
            startPos, startInput = btn.Position, input.Position
            tw(bscale, 0.1, { Scale = 0.9 })
        end
    end)
    UIS.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local d = input.Position - startInput
            if d.Magnitude > 8 then moved = true end
            if moved then
                local cam = workspace.CurrentCamera
                local vs = cam and cam.ViewportSize or Vector2.new(800, 600)
                btn.Position = UDim2.fromOffset(math.clamp(startPos.X.Offset + d.X, 0, vs.X - 52), math.clamp(startPos.Y.Offset + d.Y, 0, vs.Y - 52))
            end
        end
    end)
    UIS.InputEnded:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
            dragging = false
            tw(bscale, 0.18, { Scale = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
            if not moved then pcall(function() Window:Minimize() end) end
        end
    end)
    -- the button follows the theme border color
    task.spawn(function()
        while Alive do
            task.wait(1)
        end
        pcall(function() gui:Destroy() end)
    end)
end

