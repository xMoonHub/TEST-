--=====================================================================
--  DETECÇÃO DOS BOSSES
--  spawned[id]  = modelo vivo perto de você (Workspace.Enemies / Workspace.Characters)
--  template[id] = modelo no ReplicatedStorage (boss spawnado no servidor, mas longe)
--=====================================================================
local function normName(name)
	return (tostring(name):lower():gsub("[^%w]", ""))
end

local bossByName = {}
for _, boss in ipairs(W.bosses) do
	for _, name in ipairs(boss.names) do
		bossByName[normName(name)] = boss
	end
end

local function isReady(model)
	if not model or not model.Parent or not model:IsDescendantOf(Workspace) then
		return false
	end
	local hum = model:FindFirstChildOfClass("Humanoid")
	local root = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
	return hum ~= nil and hum.Health > 0 and root ~= nil
end

local function isDormantValid(model)
	if not model:IsA("Model") or Players:GetPlayerFromCharacter(model) then
		return false
	end
	local root = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
	if not root then
		return false
	end
	local hum = model:FindFirstChildOfClass("Humanoid")
	if hum and hum.Health <= 0 then
		return false
	end
	return true
end

local memory = {}      -- id -> { hum, template } do último boss visto vivo (para saber se morreu)
local stale = setmetatable({}, { __mode = "k" }) -- modelos do ReplicatedStorage já descartados
local ignoreUntil = {} -- id -> tick até quando o ReplicatedStorage é ignorado (logo após a morte)

local function scan()
	local live, raw = {}, {}

	local folders = {}
	local enemiesFolder = Workspace:FindFirstChild("Enemies")
	if enemiesFolder then
		table.insert(folders, enemiesFolder)
	end
	local charactersFolder = Workspace:FindFirstChild("Characters")
	if charactersFolder then
		table.insert(folders, charactersFolder)
	end

	for _, folder in ipairs(folders) do
		for _, model in ipairs(folder:GetChildren()) do
			local boss = bossByName[normName(model.Name)]
			if boss and not live[boss.id] and model:IsA("Model") and not Players:GetPlayerFromCharacter(model) and isReady(model) then
				live[boss.id] = model
			end
		end
	end

	for _, model in ipairs(ReplicatedStorage:GetChildren()) do
		local boss = bossByName[normName(model.Name)]
		if boss and not raw[boss.id] and isDormantValid(model) then
			raw[boss.id] = model
		end
	end

	local template = {}
	local now = tick()

	for _, boss in ipairs(W.bosses) do
		local id = boss.id
		local liveModel = live[id]
		local rsModel = raw[id]
		local mem = memory[id]

		if liveModel then
			if rsModel then
				stale[rsModel] = nil
				template[id] = rsModel
			end
			ignoreUntil[id] = nil
			memory[id] = { hum = liveModel:FindFirstChildOfClass("Humanoid"), template = rsModel }
		else
			if mem then
				-- tinha boss vivo e ele sumiu
				memory[id] = nil
				if mem.hum and mem.hum.Health <= 0 then
					-- morreu: o modelo que sobrou no ReplicatedStorage é resto, não é spawn novo
					ignoreUntil[id] = now + W.deathCooldown
					if rsModel and rsModel == mem.template then
						stale[rsModel] = true
					end
				end
			end

			if rsModel and not stale[rsModel] and now >= (ignoreUntil[id] or 0) then
				template[id] = rsModel
			end
		end
	end

	return { spawned = live, template = template }
end

