function AB.hopInfo()
    if not Config.AutoHop then return "off" end
    local parts = {}
    if Config.HopKillsOn then parts[#parts + 1] = string.format("kills %d/%d", Sess.kills, Config.HopKills) end
    if Config.HopTimerOn then parts[#parts + 1] = string.format("timer %ds", math.max(0, math.floor(Config.HopAfter - (os.clock() - Hop.serverAt)))) end
    if Config.HopNoTarget and Hop.noTargetSince then
        parts[#parts + 1] = string.format("sem alvo %ds", math.floor(os.clock() - Hop.noTargetSince))
    end
    return #parts > 0 and table.concat(parts, " | ") or "on"
end

local function hopTrigger()
    if not (Config.AutoHop and Config.AutoFarm) then return nil end
    if os.clock() - Hop.serverAt < 15 then return nil end -- tempo para o servidor carregar
    if os.clock() - Hop.failAt < 20 then return nil end
    if Config.HopKillsOn and Sess.kills >= Config.HopKills then return "kills" end
    if Config.HopTimerOn and os.clock() - Hop.serverAt >= Config.HopAfter then return "timer" end
    if Config.HopNoTarget and Hop.noTargetSince and os.clock() - Hop.noTargetSince >= Config.HopNoTargetSecs then return "sem alvos" end
    return nil
end

local function hopStep()
    if not Hop.phase then
        local r = hopTrigger()
        if not r then
            Diag.hop = AB.hopInfo()
            return false
        end
        Hop.phase, Hop.reason, Hop.climbStart, Hop.counting = "climb", r, os.clock(), false
    end
    local _, hrp = getChar()
    if not hrp then return true end
    State.Mode = "Server Hop"
    Fight.active, Fight.plr, Fight.char, Fight.inPos = false, nil, nil, false
    Config.AttackUntil = 0
    flyTo(CFrame.new(hrp.Position + Vector3.new(0, 500, 0))) -- sobe sem parar
    -- sai do combate (no maximo 45s) e so entao troca de servidor
    if Config.HopWaitCombat and inCombat() and os.clock() - Hop.climbStart < 45 then
        State.Text = "subindo ate sair do combate (" .. tostring(Hop.reason) .. ")"
        return true
    end
    if not Hop.counting then
        Hop.counting = true
        task.spawn(function()
            for i = 3, 1, -1 do
                if not Alive then Hop.msg(nil) return end
                Hop.msg(string.format("Hop in %d seconds", i))
                task.wait(1)
            end
            Hop.msg("Hop in 0 seconds")
            local ok = Hop.go()
            if not ok and Alive then
                -- falhou: recomeca o ciclo neste servidor e tenta de novo depois
                Hop.failAt = os.clock()
                Hop.phase, Hop.counting = nil, false
                Hop.serverAt = os.clock() - Config.HopAfter + 25
                Hop.noTargetSince = nil
            end
            task.delay(3, function() if Alive and not Hop.phase then Hop.msg(nil) end end)
        end)
    end
    State.Text = "trocando de servidor"
    return true
end

