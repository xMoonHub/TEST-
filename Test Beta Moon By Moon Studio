        if not pg then return end
        local want = (Config.Team == "Pirates") and "pirate" or "marine"
        for _, b in ipairs(pg:GetDescendants()) do
            if b:IsA("TextButton") or b:IsA("ImageButton") then
                local label, inTeam, a = string.lower(b.Name .. " " .. (b:IsA("TextButton") and b.Text or "")), false, b.Parent
                while a and a ~= pg do
                    local n = string.lower(a.Name)
                    label = label .. " " .. n
                    if string.find(n, "team", 1, true) then inTeam = true end
                    a = a.Parent
                end
                if inTeam and string.find(label, want, 1, true) then
                    pcall(function() if firesignal then firesignal(b.MouseButton1Click) end end)
                    pcall(function() if firesignal then firesignal(b.Activated) end end)
                    pcall(function()
                        if getconnections then
                            for _, c in ipairs(getconnections(b.MouseButton1Click)) do c:Fire() end
                            for _, c in ipairs(getconnections(b.Activated)) do c:Fire() end
                        end
                    end)
                    Diag.team = Diag.team .. " | cliquei em " .. b:GetFullName()
                    return
                end
            end
        end
    end)
end

