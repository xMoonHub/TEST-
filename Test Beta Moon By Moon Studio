-- Chama um RemoteFunction com segurança. Retorna (ok, resposta)
local function invoke(...)
    if not CommF then return false, "remote CommF_ not found" end
    -- v21: tempo limite de 8s. Antes, um remote sem resposta travava o loop principal para sempre
    -- (o farm "parava sozinho" depois de um tempo).
    local args = table.pack(...)
    local done, ok, res = false, false, nil
    task.spawn(function()
        ok, res = pcall(CommF.InvokeServer, CommF, table.unpack(args, 1, args.n))
        done = true
    end)
    local t0 = os.clock()
    while not done and os.clock() - t0 < 8 do task.wait(0.05) end
    if not done then return false, "no response from the server (8s)" end
    return ok, res
end

