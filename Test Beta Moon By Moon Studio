    T:AddButton({ Title = "Activate V4 Now", Description = "Only works with the energy full", Callback = function() R.activateNow() end })
    local AREAS = {
        { "Race Door", nil }, { "Top of Great Tree", pos3(2948, 2282, -7214) }, { "Temple of Time", pos3(28286, 14895, 103) },
        { "Ancient One", pos3(28982, 14888, -120) }, { "Lever Pull", LEVER }, { "Safe Zone", pos3(28273, 14897, 157) },
        { "PvP Zone", pos3(28767, 14967, -164) }, { "Clock", pos3(29552, 15069, -86) } }
    local DOORS = { Fishman = pos3(28224, 14889, -210), Human = pos3(29237, 14889, -207), Cyborg = pos3(28492, 14901, -426),
        Skypiea = pos3(28967, 14918, 234), Ghoul = pos3(28672, 14889, 454), Mink = pos3(29020, 14889, -379) }
