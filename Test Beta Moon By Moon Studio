    local q, first = nil, nil
    for _, e in ipairs(QuestTables[3] or {}) do
        if e.quest and string.sub(e.quest, 1, 12) == "HauntedQuest" then
            first = first or e
            if lvl >= e.min and lvl <= e.max then q = e break end
        end
