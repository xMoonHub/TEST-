    local function myPos()
        local _, hrp = getChar()
        return hrp and hrp.Position
    end
    -- draws (or updates) the label above `adornee`
    local function mark(kind, key, adornee, text, model)
        if not (adornee and adornee.Parent) then return end
        local m = marks[kind][key]
        if not (m and m.gui and m.gui.Parent) then
            local gui = Instance.new("BillboardGui")
            gui.Name = "MHEsp"
            gui.AlwaysOnTop = true
            gui.Size = UDim2.fromOffset(180, 28)
            gui.StudsOffset = Vector3.new(0, 3, 0)
            gui.Adornee = adornee
            local lb = Instance.new("TextLabel")
            lb.Size = UDim2.fromScale(1, 1)
            lb.BackgroundTransparency = 1
            lb.Font = Enum.Font.GothamBold
            lb.TextSize = 14
            lb.TextColor3 = COLORS[kind]
            lb.TextStrokeTransparency = 0.3
            lb.Parent = gui
            gui.Parent = adornee
            m = { gui = gui, lb = lb }
            if model then
                local ok, h = pcall(function()
                    local hl = Instance.new("Highlight")
                    hl.FillColor, hl.OutlineColor, hl.FillTransparency, hl.Adornee = COLORS[kind], COLORS[kind], 0.75, model
                    hl.Parent = model
                    return hl
                end)
                if ok then m.hl = h end
            end
            marks[kind][key] = m
        end
        m.lb.Text = text
    end
    local function sweep(kind, seen)
        for key, m in pairs(marks[kind]) do
            if not (seen and seen[key]) then
                pcall(function() m.gui:Destroy() end)
                pcall(function() if m.hl then m.hl:Destroy() end end)
                marks[kind][key] = nil
            end
        end
    end
    local function dist(p)
        local mp = myPos()
        return mp and math.floor((mp - p).Magnitude) or 0
    end
    local function firstPart(inst)
        if not inst then return end
        if inst:IsA("BasePart") then return inst end
        return inst:FindFirstChildWhichIsA("BasePart", true)
    end

    local scans = {
        Player = function()
            local seen = {}
            for _, pl in ipairs(game:GetService("Players"):GetPlayers()) do
                local ch = pl.Character
                local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
                local hum = ch and ch:FindFirstChildOfClass("Humanoid")
                if pl ~= Player and hrp then
                    seen[pl] = true
                    mark("Player", pl, hrp, string.format("%s [%dm] HP %d", pl.DisplayName ~= "" and pl.DisplayName or pl.Name, dist(hrp.Position), hum and math.floor(hum.Health) or 0), ch)
                end
            end
            return seen
        end,
        Fruit = function()
            local seen = {}
            for _, t in ipairs(workspace:GetChildren()) do
                if t:IsA("Tool") and string.find(t.Name, "Fruit") then
                    local h = t:FindFirstChild("Handle")
                    if h then
                        seen[t] = true
                        mark("Fruit", t, h, string.format("%s [%dm]", t.Name, dist(h.Position)))
                    end
                end
            end
            return seen
        end,
        Berry = function()
            local seen = {}
            for _, b in ipairs(CS:GetTagged("BerryBush")) do
                local p = firstPart(b.Parent and b.Parent:IsA("Model") and b.Parent or b)
                if p then
                    seen[b] = true
                    mark("Berry", b, p, string.format("%s [%dm]", b.Name, dist(p.Position)))
                end
            end
            return seen
        end,
        Island = function()
            local seen = {}
            local wo = workspace:FindFirstChild("_WorldOrigin")
            local loc = wo and wo:FindFirstChild("Locations")
            for _, isl in ipairs(loc and loc:GetChildren() or {}) do
                local p = firstPart(isl)
                if p then
                    seen[isl] = true
                    mark("Island", isl, p, string.format("%s [%dm]", isl.Name, dist(p.Position)))
                end
            end
            return seen
        end,
    }
    local cfgKey = { Player = "EspPlayer", Fruit = "EspFruit", Berry = "EspBerry", Island = "EspIsland" }
    task.spawn(function()
        while Alive do
            for kind, scan in pairs(scans) do
                if Config[cfgKey[kind]] then
                    local ok, seen = pcall(scan)
                    sweep(kind, ok and seen or nil)
                else
                    sweep(kind, nil)
                end
            end
            task.wait(0.4)
        end
        for kind in pairs(marks) do sweep(kind, nil) end
    end)

    local function tg(id, title, desc)
        T:AddToggle(id, { Title = title, Description = desc, Default = Config[id] and true or false }):OnChanged(function(v) Config[id] = v; persist() end)
    end
