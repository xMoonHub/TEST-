                local _, hrp, hum = getChar()
                local tool = Player.Backpack:FindFirstChild("Hallow Essence")
                if tool and hum then pcall(function() hum:EquipTool(tool) end) end
                pcall(function()
                    for _, d in ipairs(altar:GetDescendants()) do
                        if d:IsA("BasePart") and hrp then
                            firetouchinterest(hrp, d, 0)
                            firetouchinterest(hrp, d, 1)
                        end
                    end
                    if altar:IsA("BasePart") and hrp then
                        firetouchinterest(hrp, altar, 0)
                        firetouchinterest(hrp, altar, 1)
                    end
                end)
                Diag.summon = "Soul Reaper: touched the altar with the Hallow Essence"
            end
        end
    end
    return false
end

