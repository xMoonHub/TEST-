-- + Conte_do_colado (Cursed Captain join API). Um recurso por vez, em ordem: Reroll > Ghoul > Cyborg > V2 > V3 > V4 Lever.
;(function()
    local T = Tabs.Races
    local RS = game:GetService("ReplicatedStorage")
    local HttpSvc = game:GetService("HttpService")
    local TeleportSvc = game:GetService("TeleportService")
    local PlayersSvc = game:GetService("Players")
    local R = {}
    AFL.Race = R
    R.status = "Idle"
    local function cfgv(k, d) if Config[k] == nil then Config[k] = d end end
    cfgv("RaceReroll", false); cfgv("RaceTarget", "Ghoul"); cfgv("RaceGhoul", false); cfgv("RaceGhoulHop", false)
    cfgv("RaceCyborg", false); cfgv("RaceV2", false); cfgv("RaceV3", false); cfgv("RaceV3Pvp", false)
    cfgv("RaceLever", false); cfgv("RaceGear", false); cfgv("RaceV4Auto", false)

    local function note(t) R.status = t; State.Mode, State.Text = "Races", t; Diag.race = t end
    local function inv(...) local ok, res = invoke(...); if ok then return res end return nil end
    local function pdata() return Player:FindFirstChild("Data") end
    local function raceVal() local d = pdata(); local r = d and d:FindFirstChild("Race"); return r and tostring(r.Value) or "?" end
    local function dval(n) local d = pdata(); local v = d and d:FindFirstChild(n); return v and tonumber(v.Value) or 0 end
    local function evolved() local d = pdata(); local r = d and d:FindFirstChild("Race"); return r ~= nil and r:FindFirstChild("Evolved") ~= nil end
    local function pos3(x, y, z) return Vector3.new(x, y, z) end
    local function near(v, r) local _, hrp = getChar(); return hrp and (hrp.Position - v).Magnitude <= (r or 8) end
    local function goTo(v, up) flyTo(CFrame.new(v.X, v.Y + (up or 0), v.Z)) end
    local function hasTool(n) return findToolByName(string.lower(n)) ~= nil end
    local function equipByName(n)
        local t, eq = findToolByName(string.lower(n))
        if t and not eq then local _, _, hum = getChar(); if hum then hum:EquipTool(t) end end
        return t
    end
    local function fire(cd) if cd and type(fireclickdetector) == "function" then pcall(fireclickdetector, cd) end end

    -- ===== servidor com Cursed Captain (API do Conte_do_colado) =====
    local API_URL, SECRET = "https://api.quantumonyx.cc", "QnTmOnyX"
    local ALPHA = "kQ9mZ2xW7nR4vB1jY6tF3hD8pL5cG0sA"
    local function decodeJobId(arg)
        local s = arg:gsub("^%.", ""):gsub("%.$", "")
        local t, n = {}, 0
        for i = 1, #s do n += 1; if n % 5 ~= 0 then t[#t + 1] = s:sub(i, i) end end
        local s2 = table.concat(t)
        local out, a, b = {}, 1, 1
        local function f3(x, y) return (x - SECRET:byte((y - 1) % #SECRET + 1) - y) % 32 end
        while a <= #s2 do
            local i1, i2 = ALPHA:find(s2:sub(a, a), 1, true), ALPHA:find(s2:sub(a + 1, a + 1), 1, true)
            if not i1 or not i2 then return "" end
            out[#out + 1] = string.char(f3(i1 - 1, b) + f3(i2 - 1, b + 100) * 32)
            a += 2; b += 1
        end
        return table.concat(out)
    end
    local reqf = (syn and syn.request) or http_request or (http and http.request) or request or httprequest
    local joining, lastJoin = false, 0
    function R.joinBoss(bossName)
        if joining or os.clock() - lastJoin < 8 or not reqf then return false end
        joining, lastJoin = true, os.clock()
        task.spawn(function()
            local ok = pcall(function()
                local res = reqf({ Url = API_URL .. "/api/logs/" .. bossName:lower(), Method = "GET", Headers = { ["Content-Type"] = "application/json" } })
                if not res or res.StatusCode ~= 200 then error("api") end
                local dec = HttpSvc:JSONDecode(res.Body)
                local entries = dec and dec[bossName:lower()]
                if not entries or #entries == 0 then error("empty") end
                local ids = {}
                for i = #entries, 1, -1 do
                    local e = entries[i]
                    if e.jobId and e.jobId ~= "" and (not e.placeId or tostring(e.placeId) == tostring(game.PlaceId)) then
                        local j = decodeJobId(e.jobId)
                        if j ~= "" and j ~= game.JobId and not table.find(ids, j) then ids[#ids + 1] = j end
                    end
                end
                if #ids == 0 then error("none") end
                local cur, browser = game.JobId, RS:FindFirstChild("__ServerBrowser")
                for i, j in ipairs(ids) do
                    if game.JobId ~= cur or not Alive then break end
                    note(string.format("Hopping to %s server (%d/%d)", bossName, i, #ids))
                    pcall(saveAll)
                    pcall(function()
                        if browser then browser:InvokeServer("teleport", j)
                        else TeleportSvc:TeleportToPlaceInstance(game.PlaceId, j, Player) end
                    end)
                    task.wait(6)
                end
            end)
            if not ok then note("No " .. bossName .. " server found in the API (will retry)") end
            joining = false
        end)
        return true
    end

    -- ===== Ghost Ship =====
    local SHIP = pos3(923.213, 125.39765, 32852.832)
    local SHIP_MOBS = { "Ship Deckhand", "Ship Engineer", "Ship Steward", "Ship Officer" }
    local enterAt = 0
    local function insideShip() local _, hrp = getChar(); return hrp and (hrp.Position - SHIP).Magnitude <= 1000 end
    local function enterShip()
        if insideShip() then return true end
        if os.clock() - enterAt > 4 then enterAt = os.clock(); inv("requestEntrance", SHIP) end
        return false
    end
    local function fightNames(names, label)
        local e = findEnemy(names)
        if e then note(label .. ": " .. e.Name); fightEnemy(e, { e.Name }, true); return true end
        return false
    end

    -- ===== Reroll (Banana/NightRace): BlackbeardReward Reroll 1 -> 2 (3000 fragments) =====
    local lastReroll = 0
    local function stepReroll()
        if not Config.RaceReroll then return false end
        local want = tostring(Config.RaceTarget)
        if raceVal() == want then note("Reroll: already " .. want); return false end
        if dval("Fragments") < 3000 then note("Reroll: need 3000 fragments"); return false end
        if os.clock() - lastReroll < 3 then return true end
        lastReroll = os.clock()
        note("Rerolling race (now " .. raceVal() .. " -> " .. want .. ")")
        inv("BlackbeardReward", "Reroll", "1")
        inv("BlackbeardReward", "Reroll", "2")
        return true
    end

    local function toSea2()
        if getSea() == 2 then return true end
        note("Traveling to the Second Sea")
        if os.clock() - (R.travelAt or 0) > 15 then R.travelAt = os.clock(); inv("TravelDressrosa") end
        return false
    end

    -- ===== Ghoul: 100 Ectoplasm + Hellfire Torch (Cursed Captain) -> Ectoplasm Buy 4 =====
    local BUY_POS = pos3(921, 125, 33453)
    local lastChange = 0
    local function stepGhoul()
        if not Config.RaceGhoul or raceVal() == "Ghoul" then return false end
        if not toSea2() then return true end
        if os.clock() - lastChange > 12 then lastChange = os.clock(); inv("Ectoplasm", "Change", 4) end
        local ecto = invCount("Ectoplasm")
        if ecto < 100 then
            if not enterShip() then note("Ghoul: entering the Ghost Ship"); return true end
            if fightNames(SHIP_MOBS, string.format("Ghoul: Ectoplasm %d/100", ecto)) then return true end
            note("Ghoul: waiting for ship mobs"); goTo(SHIP, 30); return true
        end
        if hasTool("Hellfire Torch") then
            if near(BUY_POS, 10) then
                note("Ghoul: buying the race")
                inv("Ectoplasm", "BuyCheck", 4); task.wait(0.2); inv("Ectoplasm", "Buy", 4)
            else
                note("Ghoul: going to the Ectoplasm shop"); goTo(BUY_POS)
            end
            return true
        end
        local cap = findEnemy({ "Cursed Captain" })
        if cap then
            if not insideShip() and not enterShip() then note("Ghoul: entering the Ghost Ship"); return true end
            note("Ghoul: killing Cursed Captain"); fightEnemy(cap, { cap.Name }, false); return true
        end
        if Config.RaceGhoulHop then
            note("Ghoul: no Cursed Captain here, searching a server")
            R.joinBoss("CursedCaptain")
            return true
        end
        note("Ghoul: Cursed Captain is not in this server (turn on Auto Ghoul Server Hop)")
        return false
    end

    -- ===== Cyborg: 2500 frags, Fist of Darkness / Core Brain / Microchip / Order =====
    local MACHINE = pos3(-5544, 229, -5938)
    local function machine()
        local m = workspace:FindFirstChild("Map"); local ci = m and m:FindFirstChild("CircleIsland")
        local rs = ci and ci:FindFirstChild("RaidSummon"); local b = rs and rs:FindFirstChild("Button")
        local mn = b and b:FindFirstChild("Main")
        return mn, mn and mn:FindFirstChildOfClass("ClickDetector"), ci
    end
    local function useMachine(label)
        local _, cd = machine()
        if not near(MACHINE, 8) then note(label .. ": going to the machine"); goTo(MACHINE); return true end
        fire(cd); task.wait(0.6); return true
    end
    local function labUnlocked(ci)
        local d = ci and ci:FindFirstChild("SecretLabDoors"); local c = d and d:FindFirstChild("colormodel")
        return c and c.Color.G > c.Color.R
    end
    local function stepCyborg()
        if not Config.RaceCyborg or raceVal() == "Cyborg" then return false end
        if not toSea2() then return true end
        local chk = inv("CyborgTrainer", "Check")
        local mn, _, ci = machine()
        if chk == 1 or chk == true or (mn and not mn.CanCollide) then
            if dval("Fragments") >= 2500 then
                note("Cyborg: buying the race"); inv("CyborgTrainer", "Buy"); task.wait(1); return true
            end
            note("Cyborg: need 2500 fragments"); return false
        end
        if hasTool("Core Brain") then equipByName("Core Brain"); return useMachine("Cyborg (Core Brain)") end
        local order = findEnemy({ "Order" })
        if order then note("Cyborg: killing Order"); fightEnemy(order, { "Order" }, false); return true end
        if hasTool("Microchip") then equipByName("Microchip"); return useMachine("Cyborg (Microchip)") end
        if not labUnlocked(ci) then
            if hasTool("Fist of Darkness") then equipByName("Fist of Darkness"); return useMachine("Cyborg (Fist of Darkness)") end
            local e = AFL.feat and AFL.feat.Chest
            if e then
                note("Cyborg: farming chests for the Fist of Darkness")
                local ok, busy = pcall(e.run)
                return (ok and busy) and true or false
            end
            note("Cyborg: need the Fist of Darkness"); return false
        end
        if dval("Fragments") >= 1000 then
            note("Cyborg: buying a Microchip"); inv("BlackbeardReward", "Microchip", "2"); task.wait(1); return true
        end
        note("Cyborg: need 1000 fragments for the Microchip"); return false
    end

    -- ===== V2 (Alchemist, Second Sea) =====
    local ALCH = pos3(-2777, 73, -3570)
    local function flowerPart(n) local p = workspace:FindFirstChild(n); return (p and p:IsA("BasePart") and p.Transparency ~= 1) and p or nil end
    local function stepV2()
        if not Config.RaceV2 or evolved() then return false end
        if raceVal() == "Draco" then note("V2: Draco cannot use the Alchemist"); return false end
        if not toSea2() then return true end
        if dval("Beli") < 500000 then note("V2: need 500,000 Beli"); return false end
        local a = inv("Alchemist", "1")
        if a == 0 or a == 2 then
            if near(ALCH, 6) then note("V2: talking to the Alchemist"); inv("Alchemist", a == 0 and "2" or "3"); task.wait(1)
            else note("V2: going to the Alchemist"); goTo(ALCH) end
            return true
        elseif a == 1 then
            for i = 1, 2 do
                local n = "Flower " .. i
                if not hasTool(n) then
                    local p = flowerPart("Flower" .. i)
                    if p then note("V2: collecting " .. n); flyTo(p.CFrame); return true end
                end
            end
            if not hasTool("Flower 3") then
                if not insideShip() and not enterShip() then note("V2: entering the Ghost Ship (yellow flower)"); return true end
                if fightNames(SHIP_MOBS, "V2: yellow flower") then return true end
            end
            if not (hasTool("Flower 1") and hasTool("Flower 2") and hasTool("Flower 3")) then
                note("V2: waiting for night (flowers)"); goTo(pos3(-382, 73, 290)); return true
            end
        end
        return false
    end

    -- ===== V3 (Wenlocktoad) =====
    local WEN = pos3(-1992, 125, -73)
    local function pvpTarget()
        local _, hrp = getChar(); if not hrp then return end
        local best, bd, mylvl = nil, math.huge, dval("Level")
        local sky = raceVal() == "Skypiea"
        for _, pl in ipairs(PlayersSvc:GetPlayers()) do
            if pl ~= Player and not pl:GetAttribute("IslandRaiding") and not pl:GetAttribute("PvpDisabled") then
                local pd = pl:FindFirstChild("Data")
                local ok = true
                if sky then local r = pd and pd:FindFirstChild("Race"); ok = r and tostring(r.Value) == "Skypiea" end
                local lv = pd and pd:FindFirstChild("Level")
                if ok and lv and math.abs(lv.Value - mylvl) < 500 then
                    local c = pl.Character; local h = c and c:FindFirstChild("HumanoidRootPart"); local hu = c and c:FindFirstChildOfClass("Humanoid")
                    if h and hu and hu.Health > 0 then
                        local d = (h.Position - hrp.Position).Magnitude
                        if d < bd then best, bd = c, d end
                    end
                end
            end
        end
        return best
    end
    local function stepV3()
        if not Config.RaceV3 or not evolved() then return false end
        if inv("Wenlocktoad") ~= nil then note("V3: already unlocked"); return false end
        if dval("Level") < 1000 then note("V3: need level 1000"); return false end
        if dval("Beli") < 2000000 then note("V3: need 2,000,000 Beli"); return false end
        if not toSea2() then return true end
        local w = inv("Wenlocktoad", "1")
        if w == 0 or w == 2 then
            if near(WEN, 6) then note("V3: talking to Wenlocktoad"); inv("Wenlocktoad", w == 0 and "2" or "3"); task.wait(1)
            else note("V3: going to Wenlocktoad"); goTo(WEN) end
            return true
        elseif w == 1 then
            local race = raceVal()
            if race == "Mink" then
                local e = AFL.feat and AFL.feat.Chest
                if e then
                    note("V3 (Mink): opening chests")
                    local ok, busy = pcall(e.run)
                    return (ok and busy) and true or false
                end
            elseif race == "Human" then
                if fightNames({ "Diamond", "Orbitus", "Jeremy" }, "V3 (Human)") then return true end
                note("V3 (Human): Diamond / Orbitus / Jeremy not spawned"); goTo(pos3(-382, 73, 290)); return true
            elseif race == "Ghoul" or race == "Skypiea" then
                if not Config.RaceV3Pvp then note("V3 (" .. race .. "): needs PvP, turn on 'Allow PvP for V3'"); return false end
                local c = pvpTarget()
                if c then note("V3 (" .. race .. "): hunting " .. c.Name); fightEnemy(c, { c.Name }, false); return true end
                note("V3 (" .. race .. "): no valid player found"); return false
            else
                note("V3 (" .. race .. "): no automation for this race yet"); return false
            end
        end
        return false
    end

    -- ===== V4: Pull Lever (Fully) + Gear + Activate =====
    local LEVER, LDOOR, GREAT = pos3(28575, 14937, 72), pos3(28610, 14897, 106), pos3(2956, 2282, -7216)
    local function stepLever()
        if not Config.RaceLever then return false end
        local p = inv("RaceV4Progress", "Check")
        if p == 1 then note("V4: beginning"); inv("RaceV4Progress", "Begin"); return true end
        if p == 2 then
            if not near(LDOOR, 500) then note("V4: entering the temple"); inv("requestEntrance", pos3(28283, 14897, 105)); goTo(LDOOR); return true end
            if near(LDOOR, 20) then
                task.wait(1); inv("RaceV4Progress", "TeleportBack"); task.wait(0.5); goTo(GREAT); inv("RaceV4Progress", "Teleport")
            else goTo(LDOOR) end
            note("V4: progressing"); return true
        end
        if p == 3 then note("V4: continuing"); inv("RaceV4Progress", "Continue"); return true end
        local map = workspace:FindFirstChild("Map")
        local mystic = map and map:FindFirstChild("MysticIsland")
        local door = inv("CheckTempleDoor")
        local light = game:GetService("Lighting")
        if mystic and not door then
            local ct = light.ClockTime
            if ct > 16 or ct < 5 then
                local c = mystic:FindFirstChild("Center")
                if c then
                    local top = pos3(c.Position.X, 500, c.Position.Z)
                    local gear
                    for _, ch in ipairs(mystic:GetChildren()) do if ch.Name == "Part" and ch:IsA("MeshPart") and ch.Transparency == 0 then gear = ch end end
                    if gear then note("V4: going to the Blue Gear"); flyTo(gear.CFrame)
                    else
                        note("V4: looking at the moon"); goTo(top)
                        if near(top, 200) then
                            pcall(function()
                                local cam = workspace.CurrentCamera
                                cam.CFrame = CFrame.lookAt(cam.CFrame.Position, cam.CFrame.Position + light:GetMoonDirection() * 100)
                            end)
                            task.wait(0.5)
                            pcall(function() RS.Remotes.CommE:FireServer("ActivateAbility") end)
                        end
                    end
                    return true
                end
            end
            note("V4: waiting for night (Mirage)"); return false
        elseif door then
            if not near(LEVER, 10) then note("V4: going to the lever"); goTo(LEVER); return true end
            pcall(function() fireproximityprompt(map["Temple of Time"].Lever.Prompt.ProximityPrompt, math.huge) end)
            note("V4: pulling the lever"); return true
        end
        note("V4: Mirage Island not found"); return false
    end

    -- ===== Gear automático (Ancient Clock) =====
    local gearAt = 0
    local GEARS = { {}, { "Gear1" }, { "Gear2", "Omega" }, { "Gear2", "Alpha" }, { "Gear2", true }, { "Gear2", false }, { "Gear3", "Alpha" }, { "Gear3", "Omega" },
        { "Gear3", true }, { "Gear3", false }, { "Gear4", "Alpha" }, { "Gear4", true }, { "Gear4", false }, { "Gear5", "Default" }, { "Gear5", true }, { "Gear5", false } }
    local function chooseGear()
        if os.clock() - gearAt < 20 then return end
        gearAt = os.clock()
        local res = inv("TempleClock", "Check")
        if type(res) == "table" and res.HadPoint ~= true then return end
        local g4 = (type(res) == "table" and res.RaceDetails and res.RaceDetails.B == 2) and "Omega" or "Alpha"
        for _, a in ipairs(GEARS) do
            local args = { "TempleClock", "SpendPoint", table.unpack(a) }
            if a[1] == "Gear4" and a[2] == "Alpha" then args[4] = g4 end
            pcall(invoke, table.unpack(args))
        end
    end
    -- ativa a V4 quando a energia está cheia (Quantum)
    local function activateV4()
        local c = Player.Character
        local en, tr = c and c:FindFirstChild("RaceEnergy"), c and c:FindFirstChild("RaceTransformed")
        if en and tr and en.Value >= 1 and not tr.Value then
            pcall(function() Player.Backpack.Awakening.RemoteFunction:InvokeServer({ true }) end)
            return true
        end
    end
    function R.activateNow() return activateV4() end

    -- ===== passo principal (chamado pelo loop em ordem de prioridade) =====
    function R.step()
        if getChar() == nil then return false end
        local order = { stepReroll, stepGhoul, stepCyborg, stepV2, stepV3, stepLever }
        for _, f in ipairs(order) do
            local ok, busy = pcall(f)
            if not ok then AFL.logErr("Races", busy)
            elseif busy then return true end
        end
        return false
    end
    function R.listed()
        return Config.RaceReroll or Config.RaceGhoul or Config.RaceCyborg or Config.RaceV2 or Config.RaceV3 or Config.RaceLever
    end
    task.spawn(function()
        while Alive do
            task.wait(2)
            if Config.RaceGear then pcall(chooseGear) end
            if Config.RaceV4Auto then pcall(activateV4) end
        end
    end)

    -- ===== UI =====
    local function tog(id, title, desc)
        T:AddToggle(id, { Title = title, Description = desc, Default = Config[id] and true or false }):OnChanged(function(v) Config[id] = v; persist() end)
    end
    T:AddSection("Race Info")
    local info = T:AddParagraph({ Title = "Race", Content = "Checking..." })
    local info2 = T:AddParagraph({ Title = "Resources", Content = "Checking..." })
    task.spawn(function()
        while Alive do
            pcall(function()
                local c = Player.Character
                local en, tr = c and c:FindFirstChild("RaceEnergy"), c and c:FindFirstChild("RaceTransformed")
                info:SetDesc(string.format("%s (%s) | V4 energy: %s | Transformed: %s\nStatus: %s", raceVal(), evolved() and "V2+" or "V1",
                    en and string.format("%d%%", math.floor(en.Value * 100)) or "-", tr and tostring(tr.Value) or "-", R.status))
                info2:SetDesc(string.format("Fragments: %d | Beli: %d | Level: %d | Ectoplasm: %d", dval("Fragments"), dval("Beli"), dval("Level"), invCount("Ectoplasm")))
            end)
            task.wait(1.5)
        end
    end)

    T:AddSection("Ghoul")
    tog("RaceGhoul", "Auto Ghoul", "100 Ectoplasm (Ghost Ship mobs) + Hellfire Torch (Cursed Captain), then buys Ghoul. Second Sea")
    tog("RaceGhoulHop", "Auto Ghoul Server Hop", "No Cursed Captain here? Joins a server that has one (Quantum API)")

    T:AddSection("Cyborg")
    tog("RaceCyborg", "Auto Cyborg", "Fist of Darkness (chests) > Order boss > Microchip > Core Brain > buys Cyborg (2500 fragments)")

    T:AddSection("Upgrade Race")
    tog("RaceV2", "Auto Upgrade Race V2", "Alchemist quest: 3 flowers (night), needs 500k Beli. Second Sea")
    tog("RaceV3", "Auto Upgrade Race V3", "Wenlocktoad quest (level 1000, 2M Beli). Mink/Human automatic; Ghoul/Sky need PvP")
    tog("RaceV3Pvp", "Allow PvP for V3", "Ghoul / Skypiea V3 require hunting players")

    T:AddSection("Reroll Race")
    local RACES = { "Human", "Skypiea", "Fishman", "Mink", "Cyborg", "Ghoul" }
    local ri = 1; for i, n in ipairs(RACES) do if n == Config.RaceTarget then ri = i end end
    T:AddDropdown("RaceTarget", { Title = "Select Race", Description = "Race you want (each reroll costs 3000 fragments)", Values = RACES, Default = ri })
        :OnChanged(function(v) Config.RaceTarget = v; persist() end)
    tog("RaceReroll", "Auto Reroll Race", "Rerolls until you get the selected race")

    T:AddSection("Race V4")
    T:AddToggle("AutoV3", { Title = "Auto Activate Race V3", Default = Config.AutoV3 }):OnChanged(function(v) Config.AutoV3 = v; persist() end)
    T:AddToggle("AutoV4", { Title = "Auto Activate Race V4", Default = Config.AutoV4 }):OnChanged(function(v) Config.AutoV4 = v; persist() end)
    tog("RaceV4Auto", "Auto Activate V4 (energy full)", "Uses the awakening as soon as the race energy is full")
    tog("RaceLever", "Auto Pull Lever (Fully)", "Finds the Blue Gear on Mirage, opens the temple and pulls the lever")
