-- Avalia 1 jogador: devolve (elegivel, motivo). Usado pelo farm e pelo ESP (cor das linhas)
local function evaluate(plr, mylv, mine, myPos)
    if plr == Player then return false, "voce" end
    local tn = plr.Team and plr.Team.Name
    local known = (mine == "Pirates" or mine == "Marines")
    -- Marinha so mata Pirata | Pirata mata Pirata e Marinha | sem time detectado: so evita o mesmo time
    local okTeam
    if known then okTeam = (mine == "Pirates") or (tn == "Pirates")
    else okTeam = (plr.Team ~= Player.Team) or plr.Team == nil end
    if not okTeam then return false, "time" end
    if Killed[plr.UserId] then return false, "ja morto" end
    if Blacklist[plr] and Blacklist[plr] > os.clock() then return false, "ignorado" end
    local ch = plr.Character
    local hum = ch and ch:FindFirstChildOfClass("Humanoid")
    local r = ch and ch:FindFirstChild("HumanoidRootPart")
    if not (hum and r and hum.Health > 0) then return false, "morto" end
    local lv
    pcall(function() lv = plr.Data.Level.Value end)
    if lv then
        if lv < mylv - Config.MaxLevelDiff then return false, "level baixo" end
        if Config.MaxLevelAbove > 0 and lv > mylv + Config.MaxLevelAbove then return false, "level alto" end
    end
    if Config.MinBounty > 0 then
        local b = readBounty(plr)
        if b and b < Config.MinBounty then return false, "bounty baixo" end
    end
    if Config.IgnoreFriends and isFriend(plr) then return false, "amigo" end
    if Config.IgnoreSafe and inSafeZone(plr) then return false, "safe zone" end
    if myPos and (r.Position - myPos).Magnitude > Config.MaxDistance then return false, "longe" end
    return true, "ok"
end
AB.evaluate = evaluate

local PickStat = {}
local function pickTargets(maxCount, exclude)
    local _, hrp = getChar()
    if not hrp then return {} end
    local mylv, mine = getPlayerLevel(), teamName()
    PickStat = { total = 0, mine = mine }
    local list = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= Player then
            PickStat.total += 1
            if not (exclude and exclude[plr]) then
                local ok, why = evaluate(plr, mylv, mine, hrp.Position)
                if ok then
                    local r = plr.Character.HumanoidRootPart
                    local hum = plr.Character:FindFirstChildOfClass("Humanoid")
                    local d = (r.Position - hrp.Position).Magnitude
                    local key = d
                    local pr = Config.TargetPriority
                    if pr == "Highest Level" then
                        local lv = 0; pcall(function() lv = plr.Data.Level.Value end); key = -lv
                    elseif pr == "Lowest Level" then
                        local lv = 0; pcall(function() lv = plr.Data.Level.Value end); key = lv
                    elseif pr == "Lowest Health" then key = hum.Health
                    elseif pr == "Highest Bounty" then key = -(readBounty(plr) or 0)
                    elseif pr == "Random" then key = math.random()
                    end
                    list[#list + 1] = { plr = plr, key = key, d = d }
                else
                    PickStat[why] = (PickStat[why] or 0) + 1
                end
            end
        end
    end
    table.sort(list, function(a, b) if a.key == b.key then return a.d < b.d end return a.key < b.key end)
    local out = {}
    for i = 1, math.min(maxCount, #list) do out[i] = list[i].plr end
    PickStat.eligible = #list
    return out
end
AB.pickTargets = pickTargets

local function registerKill()
    Stats.kills += 1
    Sess.kills += 1
    saveAll()
end

-- ============ ESP (sempre ligado) ============
-- Por jogador: contorno (Highlight), nome, level, barra de vida (HP), distancia, bounty, time e tags (ALVO / SAFE / LEVEL...).
-- Linhas (tracers) apontando para cada jogador que pode ser morto + setas na borda da tela para quem esta fora da tela.
-- Cores: vermelho = alvo atual | laranja = pode ser morto | cinza = nao pode (time, level, safe zone...) | verde = amigo.
-- Tudo feito com Frames/Billboards/Highlight (nao depende da Drawing API, funciona em qualquer executor).
do
    local ESP = { rec = {}, hud = nil }
    AB.ESP = ESP
    local COL = {
        target = Color3.fromRGB(255, 60, 60), ok = Color3.fromRGB(255, 170, 40), no = Color3.fromRGB(150, 150, 160),
        friend = Color3.fromRGB(90, 255, 140), safe = Color3.fromRGB(80, 220, 255),
        pirate = Color3.fromRGB(255, 90, 90), marine = Color3.fromRGB(90, 150, 255),
    }
    local gui = Instance.new("ScreenGui")
    gui.Name, gui.ResetOnSpawn, gui.IgnoreGuiInset, gui.DisplayOrder = "MoonHubBountyESP", false, true, 40
    gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    local okP = pcall(function() gui.Parent = (gethui and gethui()) or game:GetService("CoreGui") end)
    if not okP or not gui.Parent then gui.Parent = Player:WaitForChild("PlayerGui") end
    ESP.gui = gui
    local lines = Instance.new("Folder"); lines.Name = "Lines"; lines.Parent = gui
    local hlFolder = Instance.new("Folder"); hlFolder.Name = "Highlights"; hlFolder.Parent = gui

    local function mk(class, props, parent)
        local o = Instance.new(class)
        for k, v in pairs(props) do o[k] = v end
        o.Parent = parent
        return o
    end

    local function newRec(plr)
        local r = { plr = plr }
        -- linha
        r.line = mk("Frame", { Name = "L_" .. plr.Name, AnchorPoint = Vector2.new(0.5, 0.5), BorderSizePixel = 0, Visible = false,
            BackgroundColor3 = COL.ok }, lines)
        -- seta (losango) para fora da tela
        r.arrow = mk("Frame", { Name = "A_" .. plr.Name, AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(14, 14),
            Rotation = 45, BorderSizePixel = 0, Visible = false, BackgroundColor3 = COL.ok }, lines)
        mk("UIStroke", { Color = Color3.new(0, 0, 0), Thickness = 1.5 }, r.arrow)
        r.arrowTxt = mk("TextLabel", { Name = "AT_" .. plr.Name, AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(110, 28),
            BackgroundTransparency = 1, Font = Enum.Font.GothamBold, TextSize = 11, TextColor3 = Color3.new(1, 1, 1),
            TextStrokeTransparency = 0.2, Visible = false, Text = "" }, lines)
        -- contorno
        r.hl = mk("Highlight", { Name = "H_" .. plr.Name, FillTransparency = 0.8, OutlineTransparency = 0,
            DepthMode = Enum.HighlightDepthMode.AlwaysOnTop, Enabled = false }, hlFolder)
        -- billboard
        local bb = mk("BillboardGui", { Name = "B_" .. plr.Name, AlwaysOnTop = true, Size = UDim2.fromOffset(190, 62),
            StudsOffset = Vector3.new(0, 4.2, 0), MaxDistance = math.huge, LightInfluence = 0, ResetOnSpawn = false }, gui)
        r.bb = bb
        r.name = mk("TextLabel", { Name = "N", BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 0), Size = UDim2.new(1, 0, 0, 17),
            Font = Enum.Font.GothamBold, TextSize = 14, TextColor3 = Color3.new(1, 1, 1), TextStrokeTransparency = 0.25, Text = plr.Name }, bb)
        r.barBg = mk("Frame", { Name = "HPBg", Position = UDim2.fromOffset(20, 19), Size = UDim2.new(1, -40, 0, 8), BorderSizePixel = 0,
            BackgroundColor3 = Color3.fromRGB(15, 15, 18), BackgroundTransparency = 0.15 }, bb)
        mk("UICorner", { CornerRadius = UDim.new(1, 0) }, r.barBg)
        mk("UIStroke", { Color = Color3.new(0, 0, 0), Thickness = 1 }, r.barBg)
        r.barFill = mk("Frame", { Name = "Fill", Size = UDim2.fromScale(1, 1), BorderSizePixel = 0, BackgroundColor3 = Color3.fromRGB(70, 255, 110) }, r.barBg)
        mk("UICorner", { CornerRadius = UDim.new(1, 0) }, r.barFill)
        r.hpTxt = mk("TextLabel", { Name = "HP", BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 27), Size = UDim2.new(1, 0, 0, 13),
            Font = Enum.Font.GothamMedium, TextSize = 11, TextColor3 = Color3.fromRGB(235, 235, 235), TextStrokeTransparency = 0.3, Text = "" }, bb)
        r.info = mk("TextLabel", { Name = "I", BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 40), Size = UDim2.new(1, 0, 0, 13),
            Font = Enum.Font.GothamMedium, TextSize = 11, TextColor3 = Color3.fromRGB(200, 200, 210), TextStrokeTransparency = 0.3, Text = "" }, bb)
        r.tag = mk("TextLabel", { Name = "T", BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 51), Size = UDim2.new(1, 0, 0, 11),
            Font = Enum.Font.GothamBold, TextSize = 10, TextColor3 = COL.ok, TextStrokeTransparency = 0.3, Text = "" }, bb)
        ESP.rec[plr] = r
        return r
    end

    local function removeRec(plr)
        local r = ESP.rec[plr]
        if not r then return end
        for _, k in ipairs({ "line", "arrow", "arrowTxt", "hl", "bb" }) do
            pcall(function() r[k]:Destroy() end)
        end
        ESP.rec[plr] = nil
    end
    table.insert(Connections, Players.PlayerRemoving:Connect(removeRec))

    local function setLine(f, a, b, thick, color, transp)
        local d = b - a
        local len = d.Magnitude
        if len < 1 then f.Visible = false return end
        f.Size = UDim2.fromOffset(len, thick)
        f.Position = UDim2.fromOffset((a.X + b.X) / 2, (a.Y + b.Y) / 2)
        f.Rotation = math.deg(math.atan2(d.Y, d.X))
        f.BackgroundColor3, f.BackgroundTransparency = color, transp
        f.Visible = true
    end

    local function hpColor(ratio)
        ratio = math.clamp(ratio, 0, 1)
        if ratio > 0.5 then return Color3.fromRGB(255 * (1 - ratio) * 2, 255, 60) end
        return Color3.fromRGB(255, 255 * ratio * 2, 60)
    end

    -- HUD pequeno (alvo, elegiveis, kills, hop)
    local hud = mk("TextLabel", { Name = "HUD", AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 6), Size = UDim2.fromOffset(420, 38),
        BackgroundColor3 = Color3.fromRGB(10, 10, 14), BackgroundTransparency = 0.35, BorderSizePixel = 0, Font = Enum.Font.GothamMedium,
        TextSize = 12, TextColor3 = Color3.fromRGB(235, 235, 245), Text = "", RichText = true, Visible = false }, gui)
    mk("UICorner", { CornerRadius = UDim.new(0, 10) }, hud)
    mk("UIStroke", { Color = Color3.fromRGB(255, 255, 255), Thickness = 1.5, Transparency = 0.2 }, hud)
    ESP.hud = hud

    local state = { textAt = 0, eligible = 0, total = 0 }
    ESP.state = state

    local function update(dt)
        if not Alive then return end
        local cam = workspace.CurrentCamera
        if not cam then return end
        local vp = cam.ViewportSize
        local _, myHrp = getChar()
        local myPos = myHrp and myHrp.Position or cam.CFrame.Position
        local mylv, mine = getPlayerLevel(), teamName()
        local now = os.clock()
        local textTick = now - state.textAt >= 0.15
        if textTick then state.textAt = now end

        local origin
        local o = Config.EspOrigin
        if o == "Center" then origin = Vector2.new(vp.X / 2, vp.Y / 2)
        elseif o == "Top" then origin = Vector2.new(vp.X / 2, 0)
        elseif o == "Mouse" then
            local ml = UserInputService:GetMouseLocation()
            origin = Vector2.new(ml.X, ml.Y)
        else origin = Vector2.new(vp.X / 2, vp.Y) end

        -- ordena por distancia para limitar o numero de Highlights (o Roblox renderiza no maximo 31)
        local order = {}
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= Player then
                local ch = plr.Character
                local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
                if hrp then order[#order + 1] = { plr = plr, ch = ch, hrp = hrp, d = (hrp.Position - myPos).Magnitude }
                else removeRec(plr) end
            end
        end
        table.sort(order, function(a, b) return a.d < b.d end)

        local hlCount, eligible = 0, 0
        for i, e in ipairs(order) do
            local plr, ch, hrp = e.plr, e.ch, e.hrp
            local r = ESP.rec[plr] or newRec(plr)
            -- avaliacao (safe zone etc.) so a ~7 Hz: barato e suficiente para as cores
            if textTick or r.evalOk == nil then r.evalOk, r.evalWhy = evaluate(plr, mylv, mine, nil) end
            local ok, why = r.evalOk, r.evalWhy
            local isTarget = (Fight.plr == plr) and Fight.char == ch
            if ok then eligible += 1 end
            local friend = (why == "amigo")
            local color = isTarget and COL.target or (ok and COL.ok) or (friend and COL.friend) or (why == "safe zone" and COL.safe) or COL.no
            local tooFar = e.d > Config.EspMaxDist

            -- billboard
            local head = ch:FindFirstChild("Head") or hrp
            if r.bb.Adornee ~= head then r.bb.Adornee = head end
            r.bb.Enabled = not tooFar
            if textTick and not tooFar then
                local hum = ch:FindFirstChildOfClass("Humanoid")
                local lv = "?"
                pcall(function() lv = tostring(plr.Data.Level.Value) end)
                local tn = plr.Team and plr.Team.Name
                local tcol = (tn == "Pirates") and COL.pirate or (tn == "Marines" and COL.marine or Color3.new(1, 1, 1))
                r.name.Text = string.format("%s  [Lv %s]", plr.DisplayName ~= plr.Name and plr.Name or plr.Name, lv)
                r.name.TextColor3 = color
                if Config.EspHealth and hum then
                    r.barBg.Visible, r.hpTxt.Visible = true, true
                    local ratio = hum.MaxHealth > 0 and hum.Health / hum.MaxHealth or 0
                    r.barFill.Size = UDim2.fromScale(math.clamp(ratio, 0, 1), 1)
                    r.barFill.BackgroundColor3 = hpColor(ratio)
                    r.hpTxt.Text = string.format("HP %d / %d  (%d%%)", math.floor(hum.Health), math.floor(hum.MaxHealth), math.floor(ratio * 100))
                else
                    r.barBg.Visible, r.hpTxt.Visible = false, false
                end
                local info = string.format("%dm", math.floor(e.d))
                if tn then info = info .. "  |  " .. (tn == "Pirates" and "Pirata" or "Marinha") end
                if Config.EspBounty then
                    local b = readBounty(plr)
                    if b then info = info .. "  |  " .. short(b) end
                end
                r.info.Text = info
                r.info.TextColor3 = tcol
                local tag = isTarget and "[ ALVO ]" or (ok and "[ PODE MATAR ]" or ("[ " .. string.upper(why) .. " ]"))
                r.tag.Text, r.tag.TextColor3 = tag, color
            end

            -- contorno (max 28 jogadores mais proximos)
            if Config.EspHighlight and not tooFar and hlCount < 28 then
                hlCount += 1
                if r.hl.Adornee ~= ch then r.hl.Adornee = ch end
                r.hl.FillColor, r.hl.OutlineColor = color, color
                r.hl.FillTransparency = isTarget and 0.55 or (ok and 0.8 or 0.92)
                r.hl.Enabled = true
            else
                r.hl.Enabled = false
            end

            -- linha / seta
            local showLine = Config.EspTracers and not tooFar and (ok or isTarget or Config.EspAllLines)
            if showLine or Config.EspArrows then
                local v, on = cam:WorldToViewportPoint(hrp.Position)
                local p = Vector2.new(v.X, v.Y)
                local onScreen = on and v.Z > 0 and p.X >= 0 and p.X <= vp.X and p.Y >= 0 and p.Y <= vp.Y
                if not onScreen then
                    -- fora da tela: ponto na borda na direcao do jogador
                    local rel = cam.CFrame:PointToObjectSpace(hrp.Position)
                    local dir = Vector2.new(rel.X, -rel.Y)
                    if dir.Magnitude < 0.001 then dir = Vector2.new(0, 1) end
                    dir = dir.Unit
                    local c = Vector2.new(vp.X / 2, vp.Y / 2)
                    local m = 30
                    local sx = dir.X ~= 0 and ((vp.X / 2 - m) / math.abs(dir.X)) or math.huge
                    local sy = dir.Y ~= 0 and ((vp.Y / 2 - m) / math.abs(dir.Y)) or math.huge
                    p = c + dir * math.min(sx, sy)
                end
                if showLine then
                    setLine(r.line, origin, p, isTarget and 2.5 or 1.5, color, isTarget and 0.05 or 0.25)
                else
                    r.line.Visible = false
                end
                if Config.EspArrows and not onScreen and not tooFar and (ok or isTarget or Config.EspAllLines) then
                    r.arrow.Position = UDim2.fromOffset(p.X, p.Y)
                    r.arrow.BackgroundColor3 = color
                    r.arrow.Visible = true
                    r.arrowTxt.Position = UDim2.fromOffset(p.X, p.Y + 18)
                    if textTick then r.arrowTxt.Text = string.format("%s\n%dm", plr.Name, math.floor(e.d)) end
                    r.arrowTxt.TextColor3 = color
                    r.arrowTxt.Visible = true
                else
                    r.arrow.Visible, r.arrowTxt.Visible = false, false
                end
            else
                r.line.Visible, r.arrow.Visible, r.arrowTxt.Visible = false, false, false
            end
        end
        state.eligible, state.total = eligible, #order

        -- HUD
        if Config.EspHud then
            hud.Visible = true
            if textTick then
                local tgt = Fight.plr and Fight.plr.Name or "-"
                local hopTxt = (Config.AutoHop and AB.hopInfo) and AB.hopInfo() or "off"
                hud.Text = string.format("<b>Moon Hub Bounty</b>  |  Alvo: <font color=\"#FF5050\">%s</font>  |  Pode matar: <font color=\"#FFAA28\">%d</font>/%d\nKills: %d (servidor %d)  |  Hop: %s",
                    tgt, eligible, #order, Stats.kills, Sess.kills, hopTxt)
            end
        else
            hud.Visible = false
        end
    end

    table.insert(Connections, RunService.RenderStepped:Connect(function(dt)
        local ok, err = pcall(update, dt)
        if not ok and due("espErr", 5) then warn("[Moon Hub Bounty] ESP: " .. tostring(err)) end
    end))

    -- limpeza quando o script e fechado
    task.spawn(function()
        while Alive do task.wait(1) end
        pcall(function() gui:Destroy() end)
    end)
end

-- ============ FRUIT: Auto Random Fruit (gacha) + Auto Store ============
local function distanceTo(cf)
    local _, hrp = getChar()
    return hrp and (hrp.Position - cf.Position).Magnitude or math.huge
end

-- ============ FRUITS ============
-- Contagem de frutas físicas (nome contém "Fruit")
local function countFruits()
    local n = 0
    for _, c in ipairs({ Player.Backpack, Player.Character }) do
        if c then
            for _, t in ipairs(c:GetChildren()) do
                if t:IsA("Tool") and string.find(t.Name, "Fruit") then n += 1 end
            end
        end
    end
    return n
end

-- Auto Store: no máximo 2 tentativas por fruta (fruta nova = tentativas novas)
local StoreTries = setmetatable({}, { __mode = "k" })
local function storeStep()
    for _, c in ipairs({ Player.Backpack, Player.Character }) do
        if c then
            for _, t in ipairs(c:GetChildren()) do
                if t:IsA("Tool") and string.find(t.Name, "Fruit") and (StoreTries[t] or 0) < 2 then
                    StoreTries[t] = (StoreTries[t] or 0) + 1
                    invoke("StoreFruit", t:GetAttribute("OriginalName") or t.Name, t)
                    task.wait(0.3)
                end
            end
        end
    end
end

