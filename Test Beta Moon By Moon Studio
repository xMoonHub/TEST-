    pcall(function() if canFile() then writefile(VISITED_FILE, HttpService:JSONEncode(t)) end end)
end

-- lista de servidores candidatos (varias paginas, dois hosts)
function Hop.list(visited)
    local out, cursor = {}, nil
    local order = Config.HopPreferFull and "Desc" or "Asc"
    for _ = 1, 5 do
        local data
        for _, host in ipairs({ "games.roblox.com", "games.roproxy.com" }) do
            local url = string.format("https://%s/v1/games/%d/servers/Public?sortOrder=%s&limit=100%s", host, game.PlaceId, order,
                cursor and ("&cursor=" .. cursor) or "")
            local okG, body = pcall(function() return game:HttpGet(url) end)
            if okG then
                local okJ, d = pcall(function() return HttpService:JSONDecode(body) end)
                if okJ and d and d.data then data = d break end
            end
        end
        if not data then break end
        for _, s in ipairs(data.data) do
            if s.id and s.id ~= game.JobId and not visited[s.id] and s.playing and s.maxPlayers
                and s.playing < s.maxPlayers - 1 and s.playing >= Config.HopMinPlayers then
                out[#out + 1] = s
            end
        end
        cursor = data.nextPageCursor
        if not cursor or #out >= 40 then break end
    end
    return out
end

function Hop.go()
    local visited = loadVisited()
    visited[game.JobId] = os.time()
    local list = Hop.list(visited)
    if #list == 0 then
        -- plano B: relaxa o minimo de jogadores
        local keep = Config.HopMinPlayers
        Config.HopMinPlayers = 1
        list = Hop.list(visited)
        Config.HopMinPlayers = keep
    end
    if #list == 0 then Diag.hop = "nenhum servidor disponivel" return false end

    -- retomada: o farm volta ligado no servidor novo
    pcall(function()
        if canFile() then
            writefile(RESUME_FILE, HttpService:JSONEncode({ t = os.time(), farm = Config.AutoFarm, hop = Config.AutoHop }))
        end
    end)
    saveAll()
    -- re-executa o script pelo loader (que entra sozinho com a key salva)
    if not Hop.queued then
        local code = genv.MoonHubReload
        if queueFn and type(code) == "string" and #code > 0 then
            Hop.queued = pcall(queueFn, code)
        elseif not Hop.warned then
            Hop.warned = true
            notify("Aviso: abra o script pelo loader (com a key) para ele voltar sozinho depois do hop.", nil, 8)
        end
    end

    for attempt = 1, 6 do
        local top = Config.HopPreferFull and math.min(#list, 6) or #list
        local i = math.random(1, math.max(1, top))
        local s = table.remove(list, i)
        if not s then break end
        visited[s.id] = os.time()
        saveVisited(visited)
        Diag.hop = string.format("indo para %s (%d/%d) tentativa %d", string.sub(s.id, 1, 8), s.playing, s.maxPlayers, attempt)
        local okT = pcall(function() TeleportService:TeleportToPlaceInstance(game.PlaceId, s.id, Player) end)
        if okT then task.wait(12) end -- se o teleporte funcionar o script e fechado aqui
        if not Alive then return true end
    end
    return false
end

