                           stroke = Color3.fromRGB(200, 200, 200), thick = 4, strokeT = 0, acrylic = false, text = Color3.fromRGB(235, 235, 235),
                           title = WHITE, titleStroke = Color3.fromRGB(0, 0, 90), sub = Color3.fromRGB(255, 255, 90) },
        ["Halloween"] = { base = "Darker", mul = 0.3, tint = Color3.fromRGB(45, 10, 70), tintA = 0.55, solid = true, corner = 18,
                           stroke = Color3.fromRGB(255, 120, 0), thick = 4, strokeT = 0, acrylic = false, text = Color3.fromRGB(255, 145, 30),
                           title = Color3.fromRGB(255, 130, 0), titleStroke = BLACK, sub = Color3.fromRGB(190, 120, 255) },
        ["Full Black"] = { base = "Darker", mul = 0.35, strokeMul = 1.1, solid = true, corner = 18, stroke = BLACK, thick = 4, strokeT = 0, acrylic = false },
        ["White"]      = { base = "Light",  mul = 1,    lerp = WHITE, lerpA = 0.6, solid = true, strokeLerp = 0.1, corner = 18, stroke = Color3.fromRGB(190, 190, 195), thick = 4, strokeT = 0, acrylic = false,
                           title = BLACK, titleStroke = WHITE, sub = Color3.fromRGB(0, 140, 190) },
        ["Water"]      = { base = "Darker", mul = 1.8, tint = Color3.fromRGB(190, 228, 252), tintA = 0.5, glass = 0.985, corner = 18,
