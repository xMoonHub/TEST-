-- ---- Inventory read straight from the game's client data (same method as the Banana hub) ----
-- Finds, at runtime, the store (GetItems/ReadItem), the KEYS table (QUANTITY/MASTERY) and ReplicatedStorage.ItemConfig.
AFL.Inv = { map = {}, at = 0, tries = 0, state = "not started" }
do
    local I = AFL.Inv
    local RS = game:GetService("ReplicatedStorage")
    local store, keys, cfg
    local function try(f) local ok, v = pcall(f); if ok then return v end end
    local function discover()
        if store and keys and cfg then return true end
        if not cfg then
            local ms = RS:FindFirstChild("ItemConfig")
            cfg = ms and try(function() return require(ms) end)
        end
        if (not store or not keys) and getgc and os.clock() - (I.lastScan or -99) > 20 then
            I.lastScan = os.clock()
            I.tries += 1
            for _, v in ipairs(getgc(true)) do
                if type(v) == "table" then
                    if not keys and try(function() return rawget(v, "QUANTITY") end) ~= nil and try(function() return rawget(v, "MASTERY") end) ~= nil then keys = v end
                    if not store and type(try(function() return v.GetItems end)) == "function" and type(try(function() return v.ReadItem end)) == "function" then store = v end
                    if store and keys then break end
                end
            end
        end
        return (store and keys and cfg) and true or false
    end
    -- Método principal (Quantum Onyx): remote GetAllItemValues devolve {ItemId, NetworkedUID, Key, Value}; o nome vem do ItemConfig
    local netMod
    local function viaRemote()
        if not netMod then
            local mods = RS:FindFirstChild("Modules")
            local nf = mods and mods:FindFirstChild("Net")
            netMod = nf and try(function() return require(nf) end)
        end
        local cfg2 = cfg
        if not cfg2 then
            local ms = RS:FindFirstChild("ItemConfig")
            cfg2 = ms and try(function() return require(ms) end)
            cfg = cfg2 or cfg
        end
        if not (netMod and cfg2) then return nil, "Net/ItemConfig missing" end
        local ok, res = pcall(function() return netMod:RemoteFunction("GetAllItemValues"):InvokeServer() end)
        if not ok or type(res) ~= "table" then return nil, "GetAllItemValues failed: " .. tostring(res) end
        local by, rows = {}, 0
        for _, r in next, res do
            rows += 1
            local k = tostring(r.ItemId) .. "_" .. tostring(r.NetworkedUID)
            by[k] = by[k] or { id = r.ItemId, at = {} }
            if r.Value ~= nil then by[k].at[r.Key] = r.Value end
        end
        local m, n, mast = {}, 0, {}
        for _, it in next, by do
            local okc, conf = pcall(function() return cfg2.match(it.id):unwrap() end)
            local names = {}
            if okc and conf then
                local dl = conf.Index and conf.Index.DebugLabel
                if dl then dl = tostring(dl); names[#names + 1] = dl:match("^(.-)%s*%[") or dl end
                local d = conf.Display and conf.Display.Name
                if d then names[#names + 1] = tostring(d) end
                local sk = conf.Index and conf.Index.StorageKey
                if sk then names[#names + 1] = tostring(sk) end
            end
            local mv = tonumber(it.at.Mastery)
            if mv and it.at.IsOwned == true then for _, nm in ipairs(names) do mast[nm] = math.max(mast[nm] or 0, mv) end end
            local q = tonumber(it.at.Quantity) -- só Quantity conta (IsOwned também vale para receitas/itens desbloqueados e dava falso positivo)
            if q and q > 0 and #names > 0 then
                n += 1
                for _, nm in ipairs(names) do
                    m[nm] = math.max(m[nm] or 0, q)
                    local nk = "#" .. string.lower(string.gsub(nm, "[^%w]", ""))
                    m[nk] = math.max(m[nk] or 0, q)
                end
            end
        end
        if n == 0 then return nil, "GetAllItemValues returned " .. rows .. " rows but no item matched" end
        I.mast = mast
        return m, n .. " items read (GetAllItemValues)"
    end
    function I.refresh()
        if os.clock() - I.at < 4 then return end
        I.at = os.clock()
        local m0, st0 = viaRemote()
        if m0 then I.map, I.state = m0, st0 return end
        I.remoteErr = st0
        if not discover() then
            I.state = string.format("module not found (store=%s keys=%s config=%s) | remote: %s", tostring(store ~= nil), tostring(keys ~= nil), tostring(cfg ~= nil), tostring(I.remoteErr))
            return
        end
        local m, n = {}, 0
        local ok, err = pcall(function()
            local a, b, c = store:GetItems(keys.QUANTITY)
            local function each(fn)
                if type(a) == "function" then for k, v in a, b, c do fn(k, v) end
                elseif type(a) == "table" then for k, v in pairs(a) do fn(k, v) end end
            end
            each(function(_, it)
                local q = type(it) == "table" and tonumber(it.Value)
                if q and q > 0 then
                    local okc, conf = pcall(function() return cfg.match(it.ItemId):unwrap() end)
                    local name
                    if okc and conf then
                        local d = conf.Display
                        name = (d and d.Name) or (conf.Index and conf.Index.StorageKey)
                    end
                    name = tostring(name or ("ItemId_" .. tostring(it.ItemId)))
                    n += 1
                    m[name] = (m[name] or 0) + q
                    local nk = "#" .. string.lower(string.gsub(name, "[^%w]", ""))
                    m[nk] = (m[nk] or 0) + q
                end
            end)
        end)
        if ok then I.map, I.state = m, n .. " item types read from the game data"
        else I.state = "read error: " .. tostring(err) end
    end
    function I.mastery(name) return I.mast and I.mast[name] or nil end
    function I.count(name)
        pcall(I.refresh)
        local nk = "#" .. string.lower(string.gsub(tostring(name), "[^%w]", ""))
        return I.map[name] or I.map[nk] or 0
    end
end


-- ---- Tiro por remote (Dragonstorm / Skull Guitar): mira sozinho no alvo, sem clicar na tela e sem mexer na câmera ----
-- Base: Quantum Onyx (RE/ShootGunEvent + Validator2 com o contador do CombatController) e Banana (SpamGunDragonStorm / Skull Guitar "TAP").
AFL.Shot = { last = 0, state = "not started" }
do
    local S = AFL.Shot
    local RS = game:GetService("ReplicatedStorage")
    local getup = getupvalue or (debug and debug.getupvalue)
    local setup = setupvalue or (debug and debug.setupvalue)
    local ctrlFn, shootEv, validator
    local function init()
        if shootEv and validator then return true end
        pcall(function()
            local mods = RS:FindFirstChild("Modules")
            local net = mods and mods:FindFirstChild("Net")
            shootEv = shootEv or (net and net:FindFirstChild("RE/ShootGunEvent"))
            local rem = RS:FindFirstChild("Remotes")
            validator = validator or (rem and rem:FindFirstChild("Validator2"))
        end)
        return shootEv ~= nil
    end
    -- contador que o servidor confere (mesma conta do CombatController)
    local function sig()
        if not ctrlFn and getup then
            pcall(function()
                local cc = require(RS.Controllers.CombatController)
                ctrlFn = getup(cc.Attack, 9)
            end)
        end
        if not (ctrlFn and getup and setup) then return 0, 0 end
        local ok, a, b = pcall(function()
            local v19, v20, v21, v22 = getup(ctrlFn, 15), getup(ctrlFn, 13), getup(ctrlFn, 16), getup(ctrlFn, 17)
            local v23, v24, v25 = getup(ctrlFn, 14), getup(ctrlFn, 18), getup(ctrlFn, 19)
            if not (v19 and v20 and v21 and v22 and v23 and v24 and v25) then return 0, 0 end
            local n = ((v19 * v23 + v20 * v21) % v22 * v22 + v20 * v23) % v24
            local n2 = math.floor(n / v22)
            local n3 = n - n2 * v22
            local n4 = v25 + 1
            setup(ctrlFn, 15, n2); setup(ctrlFn, 13, n3); setup(ctrlFn, 19, n4)
            return math.floor(n / v24 * 16777215), n4
        end)
        if ok then return a, b end
        return 0, 0
    end
    function S.fire(sc)
        local char = Player.Character
        local tool = char and char:FindFirstChildOfClass("Tool")
        local part = sc.part
        if not (tool and part and part.Parent) then return end
        local name = string.lower(tool.Name)
        local pos = part.Position
        if os.clock() - S.last < 0.1 then return end
        if sc.kind == "sg" and string.find(name, "skull guitar", 1, true) then
            S.last = os.clock()
            local re = tool:FindFirstChild("RemoteEvent")
            if re then re:FireServer("TAP", pos); S.state = "Skull Guitar: TAP" end
        elseif sc.kind == "gun" and tool.ToolTip == "Gun" then
            S.last = os.clock()
            local re = tool:FindFirstChild("RemoteEvent")
            if re and string.find(name, "skull guitar", 1, true) then re:FireServer("TAP", pos); S.state = "Skull Guitar: TAP"; return end
            if not init() then S.state = "RE/ShootGunEvent not found"; return end
            pcall(function()
                tool:SetAttribute("IsReloading_Client", false)
                tool:SetAttribute("LocalShotsLeft", 100)
                tool:SetAttribute("LocalTotalShots", (tool:GetAttribute("LocalTotalShots") or 0) + 1)
            end)
            local a, b = sig()
            if validator then pcall(function() validator:FireServer(a, b) end) end
            pcall(function() shootEv:FireServer(pos, { part }) end)
            S.state = "Gun " .. tool.Name .. ": shot at " .. tostring(part.Name)
        elseif sc.kind == "ds" and string.find(name, "dragonstorm", 1, true) then
            if not init() then S.state = "RE/ShootGunEvent not found"; return end
            S.last = os.clock()
            pcall(function()
                tool:SetAttribute("IsReloading_Client", false)
                tool:SetAttribute("LocalShotsLeft", 100)
                tool:SetAttribute("LocalTotalShots", (tool:GetAttribute("LocalTotalShots") or 0) + 1)
            end)
            local a, b = sig()
            if validator then pcall(function() validator:FireServer(a, b) end) end
            pcall(function() shootEv:FireServer(pos, { part }) end)
            S.state = "Dragonstorm: shot at " .. tostring(part.Name)
        end
    end
    Config.ShotFire = S.fire
end

function AFL.invDebug()
    local raw = InvCache.raw
    if type(raw) ~= "table" then return "game data: " .. tostring(AFL.Inv.state) .. " | remote: no data" end
    local n, hits = 0, {}
    for _, it in pairs(raw) do
        n += 1
        local nm = type(it) == "table" and tostring(it.Name) or tostring(_)
        local l = string.lower(nm)
        if string.find(l, "scrap", 1, true) or string.find(l, "ember", 1, true) or string.find(l, "magnet", 1, true) then
            local f = {}
            if type(it) == "table" then for k, v in pairs(it) do if type(v) ~= "table" then f[#f + 1] = tostring(k) .. "=" .. tostring(v) end end
            else f[1] = tostring(it) end
            hits[#hits + 1] = nm .. "{" .. table.concat(f, ",") .. "}"
        end
    end
    return "game data: " .. tostring(AFL.Inv.state) .. " | remote: " .. n .. " entries | " .. (#hits > 0 and table.concat(hits, " ") or "no scrap/ember/magnet entry")
end
-- ---- Vulcan (Prehistoric Island, Sea 3, Sea Danger Level 6) ----
AFL.Vulc = { scrapAt = 0, last = 0 }
do
    local V, MV = AFL.Vulc, AFL.MV
    -- Real names taken from the Banana hub code: workspace.Map.PrehistoricIsland, Core.ActivationPrompt, Core.PrehistoricRelic.Skull,
    -- Core.VolcanoRocks.Rock (VFXLayer.Specs.Enabled), Core.SpawnedDragonEggs.DragonEgg.Molten, workspace.DinoBone, HUD timers.
    function V.island()
        local map = workspace:FindFirstChild("Map")
        return (map and map:FindFirstChild("PrehistoricIsland")) or MV.mapChild("prehistor")
    end
    local function flag(k) return Config.VulcFull or Config[k] end
    local function hud(name)
        local ok, v = pcall(function() return Player.PlayerGui.Main.TopHUDList[name].Visible end)
        return ok and v == true
    end
    local function netCall(name, ...)
        local m = ReplicatedStorage:FindFirstChild("Modules")
        local n = m and m:FindFirstChild("Net")
        local r = n and n:FindFirstChild(name)
        if not r then return false, "remote " .. name .. " not found" end
        local args, done, ok, res = table.pack(...), false, false, nil
        task.spawn(function() ok, res = pcall(r.InvokeServer, r, table.unpack(args, 1, args.n)); done = true end)
        local t0 = os.clock()
        while not done and os.clock() - t0 < 8 do task.wait(0.05) end
        if not done then return false, "no response (8s)" end
        return ok, res
    end
    local function npcCF(name)
        for _, holder in ipairs({ workspace:FindFirstChild("NPCs"), ReplicatedStorage:FindFirstChild("NPCs") }) do
            local n = holder and holder:FindFirstChild(name)
            local p = n and (n:FindFirstChild("HumanoidRootPart") or n.PrimaryPart or n:FindFirstChildWhichIsA("BasePart", true))
            if p then return p.CFrame end
        end
    end
    local function spawnOf(name)
        local wo = workspace:FindFirstChild("_WorldOrigin")
        local es = wo and wo:FindFirstChild("EnemySpawns")
        for _, p in ipairs(es and es:GetChildren() or {}) do
            if p:IsA("BasePart") and string.find(p.Name, name, 1, true) then return p end
        end
    end
    local function killMob(name, why)
        local e = findEnemy({ name })
        State.Mode = "Auto Volcanic Magnet"
        if e then State.Text = why; fightEnemy(e, { name }, true); return true end
        local sp = spawnOf(name)
        if sp then State.Text = why .. " (going to the spawn)"; flyTo(sp.CFrame * CFrame.new(0, 30, 0)); return true end
        return false
    end
    local function skills()
        pcall(equipWeapon)
        for _, k in ipairs({ Enum.KeyCode.Z, Enum.KeyCode.X, Enum.KeyCode.C, Enum.KeyCode.V }) do
            pressKey(k)
            task.wait(0.15)
        end
    end
    local function ember()
        for _, d in ipairs(workspace:GetChildren()) do
            if d.Name == "EmberTemplate" and not V.badEmber[d] then
                local p = d:FindFirstChild("Part")
                if p and p.Position.Y > -100 then return d, p end
            end
        end
    end
    V.badEmber = setmetatable({}, { __mode = "k" })

    -- Blaze Ember (lógica do Quantum Onyx + Banana): Dragon Hunter fica no Dojo (5864, 1209, 808).
    -- RequestQuest + Check devolvem o texto da missão (Defeat Hydra Enforcers / Venomous Assailants, ou Destroy trees).
    -- Ao terminar aparece "Task completed!" -> pede a próxima. Os Blaze Ember caem como EmberTemplate (Part com Y > 10).
    local DH_CF = CFrame.new(5864, 1209, 808)
    local function taskDone()
        local ok, r = pcall(function()
            local n = Player.PlayerGui:FindFirstChild("Notifications")
            if not n then return false end
            for _, d in ipairs(n:GetDescendants()) do
                if d:IsA("TextLabel") and (string.find(d.Text, "Task completed!", 1, true) or string.find(d.Text, "Head back to the Dojo", 1, true)) then return true end
            end
            return false
        end)
        return ok and r
    end
    function V.checkQuest()
        netCall("RF/DragonHunter", { Context = "RequestQuest" })
        local ok, r = netCall("RF/DragonHunter", { Context = "Check" })
        if not (ok and type(r) == "table" and r.Text) then return nil, tostring(r) end
        local t = tostring(r.Text)
        if string.find(t, "Destroy", 1, true) or string.find(t, "Tree", 1, true) or string.find(t, "tree", 1, true) then return { kind = "tree", text = t } end
        if string.find(t, "Venomous", 1, true) or string.find(t, "Assailant", 1, true) then return { kind = "kill", mob = "Venomous Assailant", text = t } end
        if string.find(t, "Hydra", 1, true) or string.find(t, "Enforcer", 1, true) or string.find(t, "Defeat", 1, true) then return { kind = "kill", mob = "Hydra Enforcer", text = t } end
        return { kind = "unknown", text = t }
    end
    V.treePts = { Vector3.new(5326, 1000.5, 441.52), Vector3.new(5344.88, 1000.5, 359.94), Vector3.new(5260.73, 1000.5, 345.5), Vector3.new(5237.99, 1000.5, 429.64) }

    function V.emberStep()
        State.Mode = "Auto Volcanic Magnet"
        local e, part = ember()
        if e then
            V.emberSince = V.emberSince or os.clock()
            State.Text = "Collecting Blaze Ember"
            Diag.vulc = "Blaze Ember " .. invCount("Blaze Ember") .. "/15: collecting the drop"
            if os.clock() - V.emberSince > 15 then V.badEmber[e] = true; V.emberSince = nil; return true end
            flyTo(part.CFrame * CFrame.new(0, 3, 0))
            return true
        end
        if V.emberSince then V.emberSince, V.cur = nil, nil end -- ember collected: next task
        if V.cur and os.clock() - (V.curAt or 0) > 4 and taskDone() then V.cur = nil end
        local _, hrp = getChar()
        if not V.cur or os.clock() - (V.curAt or 0) > 180 then
            local cf = npcCF("Dragon Hunter") or DH_CF
            if hrp and (hrp.Position - cf.Position).Magnitude > 12 then
                State.Text = "Going to the Dragon Hunter"
                Diag.vulc = "going to the Dragon Hunter (Dojo)"
                flyTo(cf * CFrame.new(0, 4, 4))
                return true
            end
            local q, err = V.checkQuest()
            if q then
                V.cur, V.curAt, V.unk = q, os.clock(), 0
                Diag.vulc = "Dragon Hunter task: " .. q.text
            else
                Diag.vulc = "Dragon Hunter gave no task: " .. tostring(err)
                task.wait(2)
            end
            return true
        end
        local q = V.cur
        Diag.vulc = "Blaze Ember " .. invCount("Blaze Ember") .. "/15 | task: " .. q.text
        if q.kind == "kill" then
            if killMob(q.mob, q.mob) then return true end
            State.Text = "Looking for " .. q.mob
            flyTo(CFrame.new(5251.9, 60, 453.6))
            return true
        elseif q.kind == "tree" then
            State.Text = "Burning trees"
            local tree
            for _, d in ipairs(workspace:GetDescendants()) do
                if d.Name == "Meshes/plant1_Icosphere" then
                    local m = d:FindFirstAncestorWhichIsA("Model")
                    if not (m and m:GetAttribute("AlreadyDestroyedClient")) then tree = d; break end
                end
            end
            if tree then
                if hrp and (hrp.Position - tree.Position).Magnitude > 40 then flyTo(CFrame.new(tree.Position + Vector3.new(0, 25, 0))); return true end
                Aim.part, Aim.level = tree, false
                skills()
                return true
            end
            -- sem árvore carregada: patrulha os 4 pontos (como o Quantum) soltando as skills
            V.pi = ((math.floor(os.clock() / 2)) % #V.treePts) + 1
            local p = V.treePts[V.pi]
            flyTo(CFrame.new(p))
            if hrp and (hrp.Position - p).Magnitude < 60 then skills() end
            return true
        end
        V.unk = (V.unk or 0) + 1
        if V.unk > 20 then V.cur = nil end
        return true
    end

    -- Volcanic Magnet: 10 Scrap Metal (kill Jungle Pirates) + 15 Blaze Ember (Dragon Hunter) -> craft with RF/Craft
    function V.magnetStep()
        local haveMagnet = false
        for _, c in ipairs({ Player.Backpack, Player.Character }) do
            if c then for _, t in ipairs(c:GetChildren()) do
                if t:IsA("Tool") and string.find(string.lower(t.Name), "volcanic magnet", 1, true) then haveMagnet = true end
            end end
        end
        if haveMagnet then Diag.vulc = "already has the Volcanic Magnet: skipping to the island"; return false end
        local scrap, ember = invCount("Scrap Metal"), invCount("Blaze Ember")
        if scrap >= 10 and ember >= 15 then
            State.Mode, State.Text = "Auto Volcanic Magnet", "Crafting the Volcanic Magnet"
            if os.clock() - V.last > 5 then
                V.last = os.clock()
                local ok, r = netCall("RF/Craft", "Craft", "Volcanic Magnet", 1, {})
                Diag.vulc = "craft: " .. tostring(ok) .. " / " .. tostring(r)
            end
            return true
        end
        if scrap < 10 then
            Diag.vulc = "farming Scrap Metal " .. scrap .. "/10 (Jungle Pirate)"
            State.Text = "Scrap Metal " .. scrap .. "/10"
            if killMob("Jungle Pirate", "Scrap Metal " .. scrap .. "/10") then return true end
            Diag.vulc = "Jungle Pirate spawn not found (Sea 3, Deep Forest / Jungle)"
            return true -- fica no passo do magnet em vez de sair navegando sem o magnet
        end
        return V.emberStep()
    end

    -- eggs: Core.SpawnedDragonEggs.DragonEgg.Molten (ProximityPrompt) | bones: workspace.DinoBone
    function V.egg(isl)
        local core = isl:FindFirstChild("Core")
        local f = core and core:FindFirstChild("SpawnedDragonEggs")
        for _, e in ipairs(f and f:GetChildren() or {}) do
            local m = e.Name == "DragonEgg" and e:FindFirstChild("Molten")
            local pp = m and m:FindFirstChildOfClass("ProximityPrompt")
            if pp then return m, pp end
        end
    end
    function V.collectEgg(isl)
        local m, pp = V.egg(isl)
        if not m then return false end
        local _, hrp = getChar()
        State.Mode, State.Text = "Auto Collect Egg", "Collecting a Dragon Egg"
        if hrp and (hrp.Position - m.Position).Magnitude > 8 then flyTo(m.CFrame) else pcall(fireproximityprompt, pp) end
        return true
    end
    function V.collectBone()
        local b = workspace:FindFirstChild("DinoBone")
        if not (b and b:IsA("BasePart")) then return false end
        State.Mode, State.Text = "Auto Collect Bone", "Collecting a Dino Bone"
        flyTo(b.CFrame)
        return true
    end
    -- 10 seconds after the island is finished (or gone), reset the character to restart the cycle
    function V.finish(why)
        V.doneAt = V.doneAt or os.clock()
        local left = 10 - (os.clock() - V.doneAt)
        Diag.vulc = why .. " | reset in " .. math.max(0, math.ceil(left)) .. "s"
        if left <= 0 then
            V.doneAt, V.seen = nil, false
            local _, _, hum = getChar()
            if hum then pcall(function() hum.Health = 0 end) end
        end
        return false
    end
    local function golem()
        local _, hrp = getChar()
        for _, e in ipairs(enemiesList()) do
            if e.Name == "Lava Golem" then
                local eh, er = aliveParts(e)
                if eh and hrp and (hrp.Position - er.Position).Magnitude <= 1500 then return e end
            end
        end
    end
    local function activeRock(isl)
        local core = isl:FindFirstChild("Core")
        local f = core and core:FindFirstChild("VolcanoRocks")
        local best, bd, _, hrp = nil, 1e9, getChar()
        for _, r in ipairs(f and f:GetChildren() or {}) do
            local on = false
            pcall(function() on = r.Name == "Rock" and r.VFXLayer.Specs.Enabled end)
            if on and hrp then
                local d = (hrp.Position - r:GetPivot().Position).Magnitude
                if d < bd then best, bd = r, d end
            end
        end
        return best
    end
    -- touching lava hurts: remove the TouchInterest of the island and the interior lava (same as Banana)
    local function cleanLava(isl)
        if V.cleaned == isl then return end
        V.cleaned = isl
        pcall(function()
            for _, d in ipairs(isl:GetDescendants()) do
                if d.Name == "TouchInterest" and d.Parent and d.Parent.Name ~= "TrialTeleport" then d:Destroy() end
            end
            local il = isl.Core:FindFirstChild("InteriorLava")
            if il then for _, c in ipairs(il:GetChildren()) do c:Destroy() end end
        end)
    end

    function V.step()
        if not (Config.VulcFull or Config.VulcMagnet or Config.VulcFind or Config.VulcStart or Config.VulcEgg or Config.VulcBone) then return false end
        if getSea() ~= 3 then Diag.vulc = "Vulcan only works in Sea 3"; return false end
        local char, hrp = getChar()
        if not char then return false end
        local isl = V.island()
        if isl then
            V.seen = true
            MV.hold()
            local core = isl:FindFirstChild("Core")
            -- 1) not inside the island yet: the Fossil Expert is at the entrance
            if Player:GetAttribute("CurrentLocation") and Player:GetAttribute("CurrentLocation") ~= "Prehistoric Island" then
                local cf = npcCF("Fossil Expert") or (core and core:GetPivot())
                if cf and (hrp.Position - cf.Position).Magnitude > 12 then
                    State.Mode, State.Text = "Auto Vulcan", "Going to the Fossil Expert"
                    flyTo(cf * CFrame.new(0, 4, 4))
                    return true
                end
            end
            cleanLava(isl)
            local running = hud("PrehistoricRaidTimer")
            -- 2) event running: golems -> rocks -> skull
            if running and flag("VulcStart") then
                V.doneAt = nil
                local g = golem()
                if g then
                    State.Mode, State.Text = "Auto Start Vulcan", "Killing a Lava Golem"
                    fightEnemy(g, { "Lava Golem" }, true)
                    return true
                end
                local rock = activeRock(isl)
                if rock then
                    State.Mode, State.Text = "Auto Start Vulcan", "Fixing the volcano"
                    local pv = rock:GetPivot()
                    if (hrp.Position - pv.Position).Magnitude > 70 then flyTo(pv * CFrame.new(0, 45, 0)); return true end
                    flyTo(pv * CFrame.new(0, 45, 0))
                    local part = rock:FindFirstChildWhichIsA("BasePart", true)
                    Aim.part, Aim.level = part, false
                    skills()
                    V.skullGo = true
                    return true
                end
                local skull
                pcall(function() skull = core.PrehistoricRelic.Skull end)
                if V.skullGo and skull then
                    State.Mode, State.Text = "Auto Start Vulcan", "Going to the Relic Skull"
                    if (hrp.Position - skull.Position).Magnitude > 200 then flyTo(skull.CFrame) return true end
                    V.skullGo = false
                end
                Diag.vulc = "event running"
                return true
            end
            -- 3) not started: ActivationPrompt
            if not running and not hud("RaidTimer") and flag("VulcStart") then
                local ap = core and core:FindFirstChild("ActivationPrompt")
                local pp = ap and ap:FindFirstChildOfClass("ProximityPrompt")
                if pp then
                    State.Mode, State.Text = "Auto Start Vulcan", "Activating the event"
                    if (hrp.Position - ap.Position).Magnitude > 8 then flyTo(ap.CFrame) else pcall(fireproximityprompt, pp, 1); task.wait(3) end
                    return true
                end
            end
            -- 4) loot (bones only while no timers are running)
            if flag("VulcEgg") and V.collectEgg(isl) then V.doneAt = nil; return true end
            if flag("VulcBone") and not running and not hud("RaidTimer") and V.collectBone() then V.doneAt = nil; return true end
            if Config.VulcFull then return V.finish("island finished") end
            Diag.vulc = "Prehistoric Island found"
            return false
        end
        V.started, V.cleaned = nil, nil
        if V.seen then
            V.doneAt = V.doneAt or os.clock()
            if Config.VulcFull then return V.finish("island gone") end
            V.seen = false
        end
        V.doneAt = nil
        if flag("VulcMagnet") and V.magnetStep() then return true end
        if flag("VulcFind") then
            State.Mode = "Auto Find Vulcan"
            Diag.vulc = "sailing to Sea Danger Level 6, ignoring sea events"
            MV.equip("volcanic magnet")
            return MV.sail(6)
        end
        return false
    end
end


