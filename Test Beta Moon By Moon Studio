local function getChar()
    local char = Player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hrp and hum and hum.Health > 0 then return char, hrp, hum end
end

local function distanceTo(cf)
    local _, hrp = getChar()
    return hrp and (hrp.Position - cf.Position).Magnitude or math.huge
end

-- Voo suave por tween (duração proporcional à distância e à velocidade)
local currentTween, currentTweenTarget
local function flyTo(targetCF)
    local _, hrp = getChar()
    if not hrp then return end
    local dist = (hrp.Position - targetCF.Position).Magnitude
    if dist < 4 then return end
    -- mesmo destino e tween ainda rodando: não reinicia (evita recomeçar o voo a cada ciclo do loop)
    if currentTween and currentTweenTarget and currentTween.PlaybackState == Enum.PlaybackState.Playing
        and (currentTweenTarget - targetCF.Position).Magnitude < 3 then
        return
    end
    if currentTween then currentTween:Cancel() end
    currentTweenTarget = targetCF.Position
    currentTween = TweenService:Create(hrp,
        TweenInfo.new(dist / Config.TweenSpeed, Enum.EasingStyle.Linear),
        { CFrame = targetCF })
    currentTween:Play()
end

-- Noclip + flutuação enquanto o script estiver controlando o personagem
local NoclipLast = 0
table.insert(Connections, RunService.Stepped:Connect(function()
    if not (Alive and State.Busy) or os.clock() < Config.SeaSitUntil then return end
    local char, hrp = getChar()
    if not char then return end
    local now = os.clock()
    if now - NoclipLast > 0.2 then
        NoclipLast = now
        for _, p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart") then p.CanCollide = false end
        end
    end
    if not hrp:FindFirstChild("FarmHold") then
        local bv = Instance.new("BodyVelocity")
        bv.Name = "FarmHold"
        bv.MaxForce = Vector3.new(1e5, 1e5, 1e5)
        bv.Velocity = Vector3.zero
        bv.Parent = hrp
    end
end))

local function releaseChar()
    local _, hrp = getChar()
    if hrp and hrp:FindFirstChild("FarmHold") then hrp.FarmHold:Destroy() end
    if currentTween then currentTween:Cancel() end
end

-- ============ ARMAS ============
-- Procura uma ferramenta pelo tipo (ToolTip): Melee | Sword | Gun | Blox Fruit
local function findTool(tip)
    local function scan(container)
        if not container then return end
        for _, t in ipairs(container:GetChildren()) do
            if t:IsA("Tool") and t.ToolTip == tip then
                -- frutas físicas (no inventário) têm "Fruit" no nome: não são a fruta comida
                if not (tip == "Blox Fruit" and string.find(t.Name, "Fruit")) then return t end
            end
        end
    end
    local eq = scan(Player.Character)
    if eq then return eq, true end
    local bp = scan(Player.Backpack)
    if bp then return bp, false end
end

local function findToolByName(sub)
    for _, container in ipairs({ Player.Character, Player.Backpack }) do
        if container then
            for _, t in ipairs(container:GetChildren()) do
                if t:IsA("Tool") and string.find(string.lower(t.Name), sub, 1, true) then
                    return t, container == Player.Character
                end
            end
        end
    end
end

