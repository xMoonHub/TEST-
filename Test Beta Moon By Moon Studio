    if map then
        for _, m in ipairs(map:GetChildren()) do
            if m:IsA("Model") then
                local ok, sz = pcall(function() return m:GetExtentsSize() end)
                if ok and sz.Magnitude > 150 then
                    local ok2, cf = pcall(function() return m:GetPivot() end)
                    if ok2 then list[#list + 1] = cf.Position end
                end
            end
        end
    end
    local out, cur = {}, from
    while #list > 0 do
        local bi, bd = 1, math.huge
        for i, p in ipairs(list) do
            local d = (p - cur).Magnitude
            if d < bd then bi, bd = i, d end
        end
        cur = table.remove(list, bi)
        out[#out + 1] = cur
    end
    return out
end
function AFL.chestStep()
    local C = AFL.Chest
    local _, hrp = getChar()
    if not hrp then return false end
    -- reached the chosen amount: stop collecting and (with Chest Hop) change server
    if Config.ChestHop and C.n >= (Config.ChestCount or 10) then
        State.Mode, State.Text = "Auto Farm Chest", string.format("%d/%d chests: changing server", C.n, Config.ChestCount or 10)
        AFL.hopRequest("chests collected (" .. C.n .. ")")
        return false
    end
    if C.cur then
        local gone = (not C.cur.inst.Parent) or (not C.cur.part.Parent) or (not C.cur.part:IsDescendantOf(workspace))
        if gone then
            C.n += 1
            C.cur = nil
        elseif C.touchAt and os.clock() - C.touchAt > 1.2 then
            C.n += 1
            C.bl[C.cur.inst] = os.clock() + 600
            C.cur = nil
        elseif os.clock() - C.since > 25 then
            C.bl[C.cur.inst] = os.clock() + 120
            C.cur = nil
        end
    end
    if not C.cur then
        C.touchAt = nil
        local best, bd = nil, math.huge
        for _, ch in ipairs(AFL.chestList()) do
            local d = (ch.part.Position - hrp.Position).Magnitude
            if d < bd then best, bd = ch, d end
        end
        if best then
            C.cur, C.since, C.noneSince, C.dwell = best, os.clock(), nil, nil
        else
            -- no chest loaded: visit the islands one by one (hover above each for a moment so its chests load)
            if os.clock() >= C.restUntil then
                if not C.tour then C.tour, C.tourI, C.tourAt, C.dwell = AFL.chestTourBuild(hrp.Position), 1, os.clock(), nil end
                local tgt = C.tour[C.tourI]
                if tgt then
                    C.noneSince = nil
                    State.Mode = "Auto Farm Chest"
                    State.Text = string.format("Searching chests: island %d/%d (%d collected)", C.tourI, #C.tour, C.n)
                    local goal = tgt + Vector3.new(0, 90, 0)
                    if (hrp.Position - goal).Magnitude > 60 and os.clock() - C.tourAt < 40 then
                        flyTo(CFrame.new(goal))
                        return true
                    end
                    C.dwell = C.dwell or (os.clock() + 1.5)
                    if os.clock() < C.dwell then return true end
                    C.tourI, C.tourAt, C.dwell = C.tourI + 1, os.clock(), nil
                    return true
                end
                C.tour, C.restUntil = nil, os.clock() + 30 -- tour finished: rest 30s before the next one
            end
            C.noneSince = C.noneSince or os.clock()
            State.Mode, State.Text = "Auto Farm Chest", "no chests left (" .. C.n .. " collected)"
            if Config.ChestHop and os.clock() - C.noneSince > 60 then AFL.hopRequest("no chests in this server") end
            return false
        end
    end
    State.Mode = "Auto Farm Chest"
    State.Text = string.format("Collecting chest (%d collected%s)", C.n, Config.ChestHop and ("/" .. tostring(Config.ChestCount or 10)) or "")
    local part = C.cur.part
    if (hrp.Position - part.Position).Magnitude > 12 then
        C.touchAt = nil
        flyTo(part.CFrame)
    else
        if currentTween then currentTween:Cancel() end
        pcall(function()
            hrp.CFrame = part.CFrame
            hrp.AssemblyLinearVelocity = Vector3.zero
            if firetouchinterest then
                firetouchinterest(hrp, part, 0)
                firetouchinterest(hrp, part, 1)
            end
        end)
        C.touchAt = C.touchAt or os.clock()
    end
    return true
end

