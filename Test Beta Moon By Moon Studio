                           title = WHITE, titleStroke = Color3.fromRGB(20, 40, 60), sub = Color3.fromRGB(120, 255, 200) },
        ["Hacker Matrix"] = { base = "Darker", mul = 0.3, strokeMul = 1.1, solid = true, corner = 18,
                           stroke = Color3.fromRGB(0, 255, 70), thick = 3, strokeT = 0, acrylic = false, text = Color3.fromRGB(0, 255, 90),
                           title = Color3.fromRGB(0, 255, 90), titleStroke = BLACK, sub = Color3.fromRGB(180, 255, 200) },
