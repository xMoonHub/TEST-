    -- Warden: levers sorted by X then Z ; Pull(i) -> {Result="Accepted"|"Solved"|other}. Tries the orders step by step, replaying the prefix after a miss.
    S.lev = { prefix = {}, tried = {}, replay = nil, n = 0 }
    local function leverList()
        local loc = mapChild("Map", "Prison")
        local folder = loc and loc:FindFirstChild("BonusMoment_Locations", true)
        if not folder then
            local m = workspace:FindFirstChild("Map")
            folder = m and m:FindFirstChild("BonusMoment_Locations", true)
        end
        local lv = folder and folder:FindFirstChild("Levers")
        local out = {}
        for _, c in ipairs(lv and lv:GetChildren() or {}) do
            local arm = c:IsA("Model") and c:FindFirstChild("Lever")
            if arm and arm:IsA("BasePart") then out[#out + 1] = arm end
        end
        table.sort(out, function(a, b)
            if math.abs(a.Position.X - b.Position.X) > 0.001 then return a.Position.X < b.Position.X end
            return a.Position.Z < b.Position.Z
        end)
        return out
    end
    local function wardenRun()
        local lv = leverList()
        if #lv == 0 then Diag.awk = "Auto Awaken (Warden): levers not loaded (get closer to the main building)"; return false end
        local c = V(0, 0, 0)
        for _, a in ipairs(lv) do c = c + a.Position end
        c = c / #lv
        if not near(c, 14, 4) then Diag.awk = "Auto Awaken (Warden): flying to the levers"; return true end
        if not every("lever", 0.8) then return true end
        local rf = rem("BonusMomentsRemoteFunction")
        if not rf then return false end
        local L = S.lev
        local idx
        if L.replay and #L.replay > 0 then idx = table.remove(L.replay, 1)
        else
            L.tried[#L.prefix + 1] = L.tried[#L.prefix + 1] or {}
            local used = {}
            for _, i in ipairs(L.prefix) do used[i] = true end
            for i = 1, #lv do
                if not used[i] and not L.tried[#L.prefix + 1][i] then idx = i; break end
            end
            if not idx then L.prefix, L.tried, L.replay = {}, {}, nil; Diag.awk = "Auto Awaken (Warden): no order worked, restarting"; return true end
        end
        local ok, r = pcall(rf.InvokeServer, rf, "Lever Jailbreak", "Pull", idx)
        local res = ok and typeof(r) == "table" and r.Result or nil
        L.n = L.n + 1
        Diag.awk = "Auto Awaken (Warden): pull " .. idx .. " -> " .. tostring(res) .. " (known order: " .. table.concat(L.prefix, ",") .. ")"
        if L.replay then
            if res ~= "Accepted" and res ~= "Solved" then L.prefix, L.tried, L.replay = {}, {}, nil end
            return true
        end
        if res == "Accepted" then L.prefix[#L.prefix + 1] = idx
        elseif res == "Solved" then L.prefix = {}; L.tried = {}
        elseif res ~= nil then
            L.tried[#L.prefix + 1][idx] = true
            if #L.prefix > 0 then L.replay = { table.unpack(L.prefix) } end
        end
        return true
    end

