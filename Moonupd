    -- Auto Raid: kill the raid mobs, then move to the most advanced island
    local function fight()
        State.Mode = "Auto Raid"
        local _, hrp = getChar()
        -- Raid boss first: a strong mob (name with "boss"/"order", or MaxHealth way above the rest) wins over everything else, at any distance
        local boss, hs = nil, {}
