-- Inventário (frutas guardadas e itens de quest): cache de 5s
local InvCache = { at = 0, map = {} }
local function invCount(name)
    if os.clock() - InvCache.at > 5 then
        InvCache.at = os.clock()
        local ok, inv = invoke("getInventory")
        if ok and type(inv) == "table" then
            local m = {}
            InvCache.raw = inv
            local function cntOf(it)
                for _, k in ipairs({ "Count", "Amount", "Quantity", "Qty", "Stack", "Value", "count", "amount", "quantity" }) do
                    if tonumber(it[k]) then return tonumber(it[k]) end
                end
                for k, v in pairs(it) do
                    local kl = string.lower(tostring(k))
                    if type(v) == "number" and (string.find(kl, "count", 1, true) or string.find(kl, "amount", 1, true) or string.find(kl, "quant", 1, true)) then return v end
                end
                return 1
            end
            local function walk(t, depth)
                for key, it in pairs(t) do
                    local nm, cnt
                    if type(it) == "table" then
                        local nmv = it.Name or it.name or it.ItemName or it.Item
                        if nmv ~= nil and type(nmv) ~= "table" then nm, cnt = tostring(nmv), cntOf(it)
                        elseif depth < 4 then walk(it, depth + 1) end
                    elseif type(it) == "number" and type(key) == "string" then nm, cnt = key, it
                    elseif type(it) == "string" and type(key) == "number" then nm, cnt = it, 1 end
                    if nm then
                        local nk = string.lower(string.gsub(nm, "[^%w]", ""))
                        m[nm] = (m[nm] or 0) + cnt
                        m["#" .. nk] = (m["#" .. nk] or 0) + cnt
                    end
                end
            end
            walk(inv, 0)
            InvCache.map = m
        end
    end
    local nk = string.lower(string.gsub(tostring(name), "[^%w]", ""))
    local mc = AFL.Inv and AFL.Inv.count(name) or 0
    if mc > 0 then return mc end
    return InvCache.map[name] or InvCache.map["#" .. nk] or 0
end

-- Tem o item? (na mochila/mão ou no inventário)
local function hasItem(name)
    local nk = string.lower(string.gsub(tostring(name), "[^%w]", ""))
    for _, c in ipairs({ Player.Backpack, Player.Character }) do
        if c then
            if c:FindFirstChild(name) then return true end
            for _, ch in ipairs(c:GetChildren()) do
                if string.lower(string.gsub(ch.Name, "[^%w]", "")) == nk then return true end
            end
        end
    end
    return invCount(name) > 0
end

