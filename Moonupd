function AFL.doHop()
    local H = AFL.Hop
    local ok, err = pcall(function()
        local data
        for _, host in ipairs({ "games.roblox.com", "games.roproxy.com" }) do
            local okG, body = pcall(function()
                return game:HttpGet(string.format("https://%s/v1/games/%d/servers/Public?sortOrder=Asc&limit=100", host, game.PlaceId))
            end)
            if okG then
                local okJ, d = pcall(function() return game:GetService("HttpService"):JSONDecode(body) end)
                if okJ and d and d.data then data = d break end
            end
        end
        if not data then error("could not list the servers") end
        local list = {}
        for _, s in ipairs(data.data) do
            if s.id ~= game.JobId and s.playing and s.maxPlayers and s.playing < s.maxPlayers - 1 and s.playing >= 2 then
                list[#list + 1] = s
            end
        end
        if #list == 0 then error("no server available") end
        local s = list[math.random(#list)]
        Diag.fog = Diag.fog -- (sem alterar)
        saveAll()
        local okT = pcall(function() game:GetService("TeleportService"):TeleportToPlaceInstance(game.PlaceId, s.id, Player) end)
        if not okT then game:GetService("TeleportService"):Teleport(game.PlaceId, Player) end
    end)
    if not ok then
        H.failAt = os.clock()
        AFL.hopMsg("Hop failed: " .. tostring(err))
        task.delay(4, function() if not H.active then AFL.hopMsg(nil) end end)
    end
    return ok
end

-- reason: texto para o diagnóstico | cancel: função opcional; se retornar true durante a contagem, cancela
function AFL.hopRequest(reason, cancel)
    local H = AFL.Hop
    if H.active or os.clock() - H.failAt < 30 then return end
    H.active = true
    task.spawn(function()
        local cancelled = false
        for i = 10, 1, -1 do
            if not Alive then cancelled = true break end
            if cancel and cancel() then cancelled = true break end
            AFL.hopMsg(string.format("Hop in %d seconds", i))
            task.wait(1)
        end
        if cancelled then
            AFL.hopMsg(nil)
        else
            AFL.hopMsg("Hop in 0 seconds")
            Diag.fight = "server hop: " .. tostring(reason)
            AFL.doHop()
        end
        H.active = false
    end)
end

