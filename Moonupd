-- Comparação frouxa (ignora plural e erro de grafia, ex.: "Posessed" x "Possessed"):
-- o título da quest contém as 3 primeiras letras de alguma palavra do nome do mob
local function looseMatch(title, mobName)
    if not title then return false end
    local t = string.lower(title)
    for word in string.gmatch(string.lower(mobName), "%a+") do
        if #word >= 4 and string.find(t, string.sub(word, 1, 3), 1, true) then return true end
    end
    return false
end

-- Retorna true somente enquanto está VOANDO até o NPC. Aceitar a quest nunca bloqueia o farm.
local function questStep(q, keepActive)
    local now = os.clock()
    local key = q.quest .. ":" .. q.idx
    local visible, known = questVisible()

    if Quest.key == key then
        -- Progresso lido do título "(x/y)": a quest só conta como terminada quando x >= y, ou quando a janela
        -- da quest fica SUMIDA por vários segundos seguidos (um sumiço rápido da janela — level up, respawn,
        -- troca de tela — antes era confundido com "quest concluída" e ele pegava outra no meio).
        local tickGap = now - (Quest.lastTick or now)
        Quest.lastTick = now
        if visible then
            Quest.guiSeen, Quest.hiddenSince = true, nil
            local t = activeQuestTitle()
            local a, b = t and t:match("%((%d+)%s*/%s*(%d+)%)")
            if a then Quest.prog = { tonumber(a), tonumber(b) } end
        elseif known and (not Quest.hiddenSince or tickGap > 2) then
            Quest.hiddenSince = now -- começou a ficar sumida agora (ou ficamos um tempo sem checar: recomeça a contar)
        end
        if known then
            local prog = Quest.prog
            local complete = prog and prog[1] >= prog[2]
            local hiddenFor = (not visible and Quest.hiddenSince) and (now - Quest.hiddenSince) or 0
            local failed   = (not Quest.guiSeen) and (not visible) and now - Quest.acceptedAt > 15
            -- morreu há pouco? (aí a janela pode ter sumido porque a quest se perdeu, não porque terminou)
            local recentDeath = now - (Quest.respawnAt or -1e9) < 60
            -- terminada = vai pegar a próxima NA HORA: contagem x/x lida (mesmo com a janela ainda na tela), ou
            -- janela sumida por 0,5s (descarta só um piscar de 1 tick). Se acabou de morrer sem contagem completa,
            -- espera 8s, porque aí a janela pode ter sumido por a quest ter se perdido.
            -- A janela pode PISCAR (sumir por instantes) no meio da quest. Por isso o tempo de espera depende da
            -- contagem: perto do fim (falta no máx. 1 kill) 1s — é a conclusão normal, a janela some ao matar o
            -- último; longe do fim 6s — se a janela voltar nesse meio tempo, era só um piscar e NÃO termina a quest
            -- (antes, perto do fim ele "terminava" cedo demais e pegava outra quest com a anterior ainda em andamento).
            local nearEnd = prog and prog[1] >= prog[2] - 1
            local waitHidden = recentDeath and 20 or (nearEnd and 0.35 or (prog and 25 or 12))
            local finished = Quest.guiSeen and now - Quest.acceptedAt > 1.5
                and ((complete and true) or ((not visible) and hiddenFor >= waitHidden))
            Quest.completeSince = nil
            if failed then
                Quest.key = nil
                if Quest.tries >= 3 then Quest.cooldownUntil = now + 90; Quest.tries = 0 end
                Diag.quest = "quest did not show up on screen; continuing without it"
            elseif finished then
                qlog(string.format("Quest finished (last count read: %s | window hidden for %.1fs). Going to take the next one.",
                    prog and (prog[1] .. "/" .. prog[2]) or "?", hiddenFor))
                -- janela sumiu, contagem incompleta E o personagem morreu há pouco: a quest pode ter se perdido.
                -- Só aí pega a MESMA de novo (até 2x). Sem morte, é conclusão normal: vai para a próxima
                -- (antes ele refazia a mesma quest toda vez que terminava, pois a última contagem lida era 7/8).
                if prog and prog[1] < prog[2] and recentDeath and Quest.cur and (Quest.redoCount or 0) < 2 then
                    Quest.redo = Quest.cur
                    Quest.redoCount = (Quest.redoCount or 0) + 1
                    Diag.quest = "window disappeared at " .. prog[1] .. "/" .. prog[2] .. ": taking the SAME quest again"
                else
                    Quest.redo, Quest.redoCount = nil, 0
                end
                Quest.key, Quest.tries, Quest.prog, Quest.completeSince = nil, 0, nil, nil
                -- PARA de matar na hora: solta os mobs puxados e desliga o ataque (antes ele ainda matava os NPCs
                -- por mais ~2s depois da quest acabar, até o grupo puxado expirar)
                Fight.active, Fight.inPos, Fight.group, Fight.mobs = false, false, nil, {}
                Fight.fixStand, Fight.fixPull = nil, nil
                Config.AttackUntil = 0
                -- a janela da quest concluída ainda está na tela (x/x): limpa, senão o código abaixo
                -- acharia que "já existe uma quest em andamento" e não pegaria a próxima
                if visible then
                    invoke("AbandonQuest")
                    task.wait(0.2)
                    visible = false
                end
                Quest.cooldownUntil = 0
                -- termina o passo aqui: no próximo ciclo (0,15s) o farm reescolhe a quest pelo level ATUAL
                -- e vai direto ao NPC (antes ele reaceitava a quest velha mesmo que o level já tivesse mudado).
                -- Retorna true = "ocupado": o farm NÃO volta a bater nos mobs neste ciclo.
                return true
            else
                if not visible and Quest.guiSeen then
                    Diag.quest = string.format("quest window gone for %.0fs (progress %s); waiting before taking another",
                        hiddenFor, prog and (prog[1] .. "/" .. prog[2]) or "?")
                end
                return false
            end
        else
            -- não consegui ler a janela da quest: renova a cada 150s
            if now - Quest.acceptedAt < 150 then return false end
            Quest.key = nil
        end
    end

    if now < Quest.cooldownUntil then return false end

    -- já existe outra quest ativa?
    if known and visible then
        local title = activeQuestTitle()
        if isEliteTitle(title) then return false end -- não mexe na quest do Elite Hunter
        -- Dough/Bones: se já existe uma quest desse mob em andamento, NÃO pega outra
        if keepActive and (looseMatch(title, q.mob) or not title) then
            Quest.key, Quest.guiSeen, Quest.acceptedAt, Quest.cur = key, true, now, q
            Diag.quest = "quest in progress (" .. tostring(title) .. "); I only take another when it is complete"
            return false
        end
        -- quests lidas do jogo: aceita qualquer "Defeat N Mob" ativa (o mob vem do título)
        if q.gameDriven and title and string.find(title, "Defeat", 1, true) then
            Quest.key, Quest.guiSeen, Quest.acceptedAt, Quest.cur = key, true, now, q
            return false
        end
        local stem = string.sub(q.mob, 1, math.max(4, #q.mob - 2)) -- tolera plural
        if title and string.find(title, stem, 1, true) then
            Quest.key, Quest.guiSeen, Quest.acceptedAt, Quest.cur = key, true, now, q
            return false
        end
        -- Já existe uma quest "Defeat N ..." em andamento (ex.: o level subiu no meio dela, ou ela veio de antes
        -- de ligar o script): NUNCA abandona. Termina essa primeiro; só pega a próxima quando ela completar.
        -- (antes ele dava AbandonQuest aqui e pegava outra sem terminar a atual)
        if (not title) or string.find(title, "Defeat", 1, true) then
            Quest.key, Quest.guiSeen, Quest.acceptedAt, Quest.cur = key, true, now, q
            Quest.adopted = true
            Diag.quest = "quest in progress (" .. tostring(title) .. "); I finish it before taking the next one"
            return false
        end
        -- ja existe uma quest ativa (de outro tipo): nao abandona e nao pega outra
        Diag.quest = "a quest is active (" .. tostring(title) .. "): not taking another"
        return false
    end

    -- NPC em outra "camada" (Submerged Island x superfície): voar até ele tiraria o jogador da ilha e o
    -- controle de viagem o traria de volta, num vai-e-volta infinito. Nesse caso não viaja até o NPC.
    if q.npc then
        local _, hrp0 = getChar()
        if hrp0 and (hrp0.Position.Y <= -500) ~= (q.npc.Position.Y <= -500) then
            Diag.quest = "The quest NPC is on another map layer; not leaving the current island (farming without a quest)"
            return false
        end
    end

    -- precisa estar perto do NPC (no máximo 45s de viagem, depois desiste por 60s)
    if q.npc and distanceTo(q.npc) > 30 then
        if Quest.travelSince == 0 then Quest.travelSince = now end
        if now - Quest.travelSince > 45 then
            Quest.travelSince, Quest.cooldownUntil = 0, now + 60
            -- última tentativa: aceita a quest de onde está (se o NPC estiver um pouco fora da coordenada da wiki)
            local okq, rq = invoke("StartQuest", q.quest, q.idx)
            qlog("trip to the NPC took too long; tried to accept from a distance -> " .. tostring(okq) .. " / " .. tostring(rq))
            return false
        end
        State.Text = "Going to the quest NPC (" .. q.mob .. ")"
        flyTo(q.npc)
        return true
    end

    Quest.travelSince = 0
    do
        local vis3, known3 = questVisible()
        if known3 and vis3 then
            Diag.quest = "a quest window is on screen: only taking a quest when none is active"
            return false
        end
    end
    State.Text = "Accepting quest (" .. q.mob .. ")"
    local idx = q.idx
    if q.idxTry then idx = q.idxTry[(Quest.tries % #q.idxTry) + 1] end -- tenta outros índices se não aparecer
    local ok, r = invoke("StartQuest", q.quest, idx)
    qlog((ok and "Quest accepted: " or "Error accepting quest: ") .. q.quest .. " #" .. tostring(idx) .. " -> " .. tostring(r))
    Quest.key, Quest.acceptedAt, Quest.guiSeen = key, now, false
    Quest.prog, Quest.hiddenSince, Quest.completeSince, Quest.lastTick = nil, nil, nil, nil
    Quest.cur, Quest.adopted, Quest.redo = q, false, nil
    Quest.tries += 1
    return false
end

-- ============ AUXILIARES DO FARM DE QUEST (usados por Dough / Bones / Elite) ============
local AFL = {} -- tudo numa tabela só (limite de 200 locals do Lua)

-- Mob da quest ativa, lido do título ("Defeat 8 Reef Bandits (0/8)")
-- Retorna uma LISTA de nomes possíveis do mob: o título vem no plural ("Reef Bandits", "Posessed Mummies"),
-- mas o inimigo no jogo é singular ("Reef Bandit") — antes ele nunca achava o mob e saía andando à toa.
function AFL.questMob()
    local visible, known = questVisible()
    if not (known and visible) then return nil end
    local title = activeQuestTitle()
    if not title or isEliteTitle(title) then return nil end
    local raw = title:match("Defeat%s+%d+%s+(.-)%s+%(") or title:match("Defeat%s+(.-)%s+%(")
    if not raw or raw == "" then return nil end
    local names, seen = {}, {}
    local function add(n)
        if n and #n >= 3 and not seen[n] then seen[n] = true; names[#names + 1] = n end
    end
    add(raw)
    if string.sub(raw, -3) == "ies" then add(string.sub(raw, 1, -4) .. "y") end
    if string.sub(raw, -2) == "es" then add(string.sub(raw, 1, -3)) end
    if string.sub(raw, -1) == "s" then add(string.sub(raw, 1, -2)) end
    return names
end

-- Espera pelo respawn: lista de pontos de spawn do mob, ordenada pela distância (mais perto primeiro)
AFL.Wait = { key = nil, since = 0, last = 0, list = nil }
function AFL.spawns(names)
    local origin = workspace:FindFirstChild("_WorldOrigin")
    local folders = {}
    local f1 = origin and origin:FindFirstChild("EnemySpawns")
    local f2 = workspace:FindFirstChild("EnemySpawns")
    if f1 then table.insert(folders, f1) end
    if f2 then table.insert(folders, f2) end
    local out = {}
    local _, hrp0 = getChar()
    local isIn = hrp0 and hrp0.Position.Y <= -500
    for _, folder in ipairs(folders) do
        for _, sp in ipairs(folder:GetChildren()) do
            -- só spawns da mesma camada do jogador (Submerged Island x superfície)
            if sp:IsA("BasePart") and ((sp.Position.Y <= -500) == (isIn == true)) then
                for _, n in ipairs(names) do
                    if string.find(sp.Name, n, 1, true) then
                        out[#out + 1] = { CFrame = sp.CFrame, d = distanceTo(sp.CFrame) }
                        break
                    end
                end
            end
        end
    end
    table.sort(out, function(a, b) return a.d < b.d end)
    return out
end

-- Um passo de farm: (opcional) pega a quest e, SEMPRE depois, ataca os mobs
local function farmQuestStep(q, label, autoQuest, fallbackNames, keepActive)
    -- trocou de modo de farm: esquece a quest do modo anterior
    if Quest.mode ~= Config.Mode then
        Quest.mode, Quest.key, Quest.cur, Quest.redo, Quest.redoCount = Config.Mode, nil, nil, nil, 0
    end
    -- enquanto a quest pegada não terminar, continua nos mobs DELA (mesmo que o level tenha subido)
    if autoQuest and Quest.key and Quest.cur then
        q = Quest.cur
    elseif autoQuest and Quest.redo then
        q = Quest.redo -- refazendo a quest que sumiu antes de completar
    end
    if not q then
        State.Text = "Level too low for Sea " .. getSea()
        return
    end
    local lvl = getPlayerLevel()
    if autoQuest and (q.npc or q.bypass) and lvl >= q.min then
        if questStep(q, keepActive) then return end -- só retorna aqui enquanto voa até o NPC
    end

    -- quest ativa: bate no mob que o TÍTULO pede (se não for o da tabela, ex.: quest que veio de antes)
    local tableMobs = q.mobs -- nomes da tabela (sempre usados como reserva: a grafia do título pode diferir da do jogo)
    if autoQuest then
        local gm = AFL.questMob()
        if gm then
            local inTable = false
            for _, n in ipairs(gm) do
                for _, m in ipairs(q.mobs) do
                    if n == m then inTable = true end
                end
            end
            if q.gameDriven or not inTable then
                q = setmetatable({ mobs = gm, mob = gm[1] }, { __index = q })
            end
        end
    end
    local names = q.mobs
    local mob = findEnemy(names)
    if not mob and tableMobs ~= names then
        mob = findEnemy(tableMobs) -- o título não casou com nenhum mob: usa os nomes da tabela
        if mob then names = tableMobs end
    end
    if not mob and fallbackNames then
        mob = findEnemy(fallbackNames)
        if mob then names = fallbackNames end
    end
    -- último recurso: qualquer inimigo vivo perto cujo nome apareça no título da quest ativa
    -- (cobre diferença de plural/grafia entre o título e o nome real do mob)
    if not mob and autoQuest then
        local title = activeQuestTitle()
        local _, hrp0 = getChar()
        if title and hrp0 and not isEliteTitle(title) then
            local lt, bestD = string.lower(title), 400
            for _, e in ipairs(enemiesList()) do
                local eh, er = aliveParts(e)
                if eh and #e.Name >= 4 and string.find(lt, string.lower(e.Name), 1, true) then
                    local d = (hrp0.Position - er.Position).Magnitude
                    if d < bestD then mob, bestD = e, d end
                end
            end
            if mob then names = { mob.Name } end
        end
    end

    Diag.fight = string.format("%s | target mob: %s | alive: %d | level %d (quest asks %d) | searching: %s",
        label, q.mob, countAlive(q.mobs), lvl, q.min, table.concat(names, ", "))

    if mob then
        State.Text = label .. ": hitting " .. mob.Name
        fightEnemy(mob, names, true)
        return
    end

    -- sem mob carregado: vai até o ponto de spawn e FICA parado lá esperando o mob nascer.
    -- (antes ele girava em círculo em volta do NPC, tween reiniciando a todo ciclo = andava devagar)
    -- Se passar de 6s sem mob, vai para o próximo ponto de spawn da lista.
    local W = AFL.Wait
    local key = q.mob .. "|" .. getSea()
    if W.key ~= key or os.clock() - W.last > 3 then
        -- começou uma nova espera: monta a lista de spawns, do mais perto para o mais longe
        local both = {}
        for _, n in ipairs(q.mobs) do both[#both + 1] = n end
        for _, n in ipairs(tableMobs) do both[#both + 1] = n end
        W.key, W.since, W.list = key, os.clock(), AFL.spawns(both)
    end
    W.last = os.clock()
    -- quest antiga/estranha que ficou sem mob por muito tempo (90s): aí sim abandona para não travar
    if autoQuest and Quest.adopted and os.clock() - W.since > 90 then
        invoke("AbandonQuest")
        Quest.key, Quest.cur, Quest.adopted = nil, nil, false
        W.key = nil
        Diag.quest = "quest in progress with no mobs for 90s: abandoned"
        return
    end
    local list = W.list
    if list and #list > 0 then
        local idx = (math.floor((os.clock() - W.since) / 6) % #list) + 1
        local sp = list[idx]
        State.Text = string.format("%s: waiting for %s to spawn (point %d/%d)", label, q.mob, idx, #list)
        flyTo(sp.CFrame * CFrame.new(0, math.min(Config.HoverHeight, 20), 0))
    elseif q.npc and (select(2, getChar()) == nil or ((select(2, getChar()).Position.Y <= -500) == (q.npc.Position.Y <= -500))) then
        -- sem spawn conhecido: espera parado ao lado do NPC (sem círculo; nunca muda de camada do mapa)
        State.Text = label .. ": waiting for " .. q.mob .. " near the NPC"
        flyTo(q.npc * CFrame.new(0, 25, 0))
    else
        State.Text = label .. ": could not find where " .. q.mob .. " spawns"
    end
end

-- ============ AUTO FARM LEVEL (extraído do Dark Hub) ============
-- Level -> quest lido do próprio jogo (ReplicatedStorage.Quests): pega a de maior LevelReq <= level que tenha
-- spawn no mar atual. A quest é pega indo até o centro da área de spawn dos mobs (StartQuest) e só se pega
-- outra quando a atual termina. Quando o mob mora na Submerged Island, viaja sozinho pelo Submarine Worker.
-- Tudo numa tabela só (limite de 200 locals do Lua). O ataque/Bring é o do Moon (fightEnemy).
local DHF = {
    SubMobs = { ["Reef Bandit"] = true, ["Coral Pirate"] = true, ["Sea Chanter"] = true,
        ["Ocean Prophet"] = true, ["High Disciple"] = true, ["Grand Devotee"] = true },
    TikiPos = Vector3.new(-16269.7, 25.2, 1373.4), -- Submarine Worker (Tiki Outpost)
    cache = { lvl = nil, data = nil, t = 0, key = nil },
    totals = {}, kills = 0, lastKillAt = 0,
    takenAt = 0, lastSeen = 0, lastCur = nil, lastMax = nil, lastTry = 0,
    total = nil, questMob = nil,
    subUntil = 0, lastSubTravel = 0, subFails = 0,
    area = { key = nil }, visited = {},
    fightPos = nil, fightAt = 0, fightKey = nil,
    watched = setmetatable({}, { __mode = "k" }),
}

function DHF.folders()
    local out = {}
    local origin = workspace:FindFirstChild("_WorldOrigin")
    local f1 = origin and origin:FindFirstChild("EnemySpawns")
    local f2 = workspace:FindFirstChild("EnemySpawns")
    if f1 then out[#out + 1] = f1 end
    if f2 then out[#out + 1] = f2 end
    return out
end

function DHF.spawnExists(mob)
    local folders = DHF.folders()
    if #folders == 0 then return true end
    for _, folder in ipairs(folders) do
        for _, s in ipairs(folder:GetChildren()) do
            if string.find(s.Name, mob, 1, true) then return true end
        end
    end
    return false
end

function DHF.valid(mob)
    if getSea() == 3 and DHF.SubMobs[mob] then return true end
    return DHF.spawnExists(mob)
end

-- Submerged Island fica bem abaixo do mapa (Y <= -500). Nunca voar entre camadas "no seco":
-- era isso que jogava o personagem para fora do mapa quando os mobs da ilha estavam mortos.
function DHF.inSub()
    local _, hrp = getChar()
    return hrp ~= nil and hrp.Position.Y <= -500
end

function DHF.nameHas(name, names)
    for _, n in ipairs(names) do
        if string.find(name, n, 1, true) then return true end
    end
    return false
end

-- Quest do level atual, lida do jogo (cache: 60s com resultado, 5s sem)
function DHF.pick()
    local C = DHF.cache
    local lvl = getPlayerLevel()
    local age = os.clock() - C.t
    if C.lvl == lvl and ((C.data and age < 60) or age < 5) then return C.data end
    C.lvl, C.t = lvl, os.clock()

    local ok, quests = pcall(function() return require(ReplicatedStorage:WaitForChild("Quests", 5)) end)
    if not ok or type(quests) ~= "table" then
        C.data = nil
        Diag.quest = "could not read the game quest list (ReplicatedStorage.Quests)"
        return nil
    end

    local function pickBest(strict)
        local best, bestReq = nil, -1
        for questName, levels in pairs(quests) do
            if type(levels) == "table" then
                for idx, q in pairs(levels) do
                    if type(q) == "table" and q.LevelReq and q.Task and q.LevelReq <= lvl and q.LevelReq > bestReq then
                        local mobName, count
                        for n, c in pairs(q.Task) do mobName, count = n, c end
                        if mobName and count and count > 1 and (not strict or DHF.valid(mobName)) then
                            best, bestReq = { Name = questName, Level = idx, Mob = mobName }, q.LevelReq
                        end
                    end
                end
            end
        end
        return best
    end

    local best = pickBest(true) or pickBest(false)
    if not best then
        C.data = nil
        if C.warned ~= lvl then
            C.warned = lvl
            qlog("Level " .. lvl .. ": no quest found in this sea. Go to the right sea.")
        end
        return nil
    end

    C.data = {
        Mobs = { best.Mob },
        QuestMob = best.Mob,
        Label = tostring(best.Name) .. " #" .. tostring(best.Level),
        Quest = { Name = best.Name, Level = best.Level },
        Submerged = string.find(tostring(best.Name), "Submerged", 1, true) ~= nil or DHF.SubMobs[best.Mob] == true,
    }
    local key = tostring(best.Name) .. tostring(best.Level)
    if C.key ~= key then
        C.key = key
        qlog("Level " .. lvl .. " -> farming " .. best.Mob .. " (" .. C.data.Label .. ")")
    end
    return C.data
end

function DHF.questTotal(data)
    if not data or not data.Quest then return nil end
    local key = tostring(data.Quest.Name) .. "#" .. tostring(data.Quest.Level)
    if DHF.totals[key] ~= nil then return DHF.totals[key] or nil end
    local ok, quests = pcall(function() return require(ReplicatedStorage:WaitForChild("Quests", 5)) end)
    local total
    if ok and type(quests) == "table" then
        local lv = quests[data.Quest.Name] and quests[data.Quest.Name][data.Quest.Level]
        if lv and type(lv.Task) == "table" then
            for _, c in pairs(lv.Task) do total = c break end
        end
    end
    DHF.totals[key] = total or false
    return total
end

-- Voa até o ponto e ESPERA chegar (com limite de tempo); sai se o modo Level for desligado
function DHF.flyWait(cf, maxT)
    local t0 = os.clock()
    while Alive and Config.Mode == "Level" and os.clock() - t0 < (maxT or 60) do
        local _, hrp = getChar()
        if not hrp then return false end
        if (hrp.Position - cf.Position).Magnitude <= 6 then return true end
        if (cf.Position.Y <= -500) ~= (hrp.Position.Y <= -500) then return false end -- outra camada: não voa
        flyTo(cf)
        task.wait(0.1)
    end
    return false
end

-- ---------- achar mobs / área de farm ----------
function DHF.find(names, area)
    local _, hrp = getChar()
    if not hrp then return end
    -- grupo já puxado: continua nele (o ponto de luta não muda)
    if Fight.group and os.clock() < (Fight.groupUntil or 0) then
        local gb, gd = nil, math.huge
        for _, e in ipairs(Fight.group) do
            local eh, er = aliveParts(e)
            if eh and e.Parent and DHF.nameHas(e.Name, names) then
                local d = (hrp.Position - er.Position).Magnitude
                if d < gd then gb, gd = e, d end
            end
        end
        if gb then return gb end
    end
    local best, bestD = nil, math.huge
    for _, e in ipairs(enemiesList()) do
        local eh, er = aliveParts(e)
        if eh and DHF.nameHas(e.Name, names) and (not area or (er.Position - area.center).Magnitude <= area.radius) then
            local d = (hrp.Position - er.Position).Magnitude
            if d < bestD then best, bestD = e, d end
        end
    end
    return best
end

function DHF.spawnParts(names)
    local layerSub = DHF.inSub()
    local exact, loose = {}, {}
    for _, folder in ipairs(DHF.folders()) do
        for _, sp in ipairs(folder:GetChildren()) do
            for _, n in ipairs(names) do
                local isExact = sp.Name == n or string.sub(sp.Name, 1, #n) == n
                if isExact or string.find(sp.Name, n, 1, true) then
                    local part = sp:IsA("BasePart") and sp or sp:FindFirstChildWhichIsA("BasePart", true)
                    -- só spawns da mesma camada do jogador (superfície x Submerged Island)
                    if part and (part.Position.Y <= -500) == layerSub then
                        if isExact then exact[#exact + 1] = part else loose[#loose + 1] = part end
                    end
                    break
                end
            end
        end
    end
    return #exact > 0 and exact or loose
end

function DHF.nearestSpawn(names)
    local _, hrp = getChar()
    if not hrp then return end
    local best, bestD = nil, math.huge
    for _, part in ipairs(DHF.spawnParts(names)) do
        local d = (part.Position - hrp.Position).Magnitude
        if d < bestD then best, bestD = part, d end
    end
    return best
end

-- Centro e raio do grupo de spawns mais perto (só mobs dentro dessa área são alvo)
function DHF.getArea(names)
    if not names then return nil end
    local key = table.concat(names, "|") .. (DHF.inSub() and "|S" or "|G")
    if DHF.area.key == key and DHF.area.center then return DHF.area end
    local _, hrp = getChar()
    if not hrp then return nil end
    local parts = DHF.spawnParts(names)
    local s0, d0 = nil, math.huge
    for _, part in ipairs(parts) do
        local d = (part.Position - hrp.Position).Magnitude
        if d < d0 then s0, d0 = part, d end
    end
    if not s0 then return nil end
    local cluster, sum = {}, Vector3.zero
    for _, part in ipairs(parts) do
        if (part.Position - s0.Position).Magnitude <= 900 then
            cluster[#cluster + 1] = part
            sum = sum + part.Position
        end
    end
    local center = sum / #cluster
    local radius = 0
    for _, part in ipairs(cluster) do
        radius = math.max(radius, (part.Position - center).Magnitude)
    end
    DHF.area = { key = key, center = center, radius = radius + 250, spawns = cluster }
    return DHF.area
end

-- Próximo ponto de spawn para procurar mob (pula os visitados nos últimos 25s)
function DHF.huntSpawn(names, area)
    local _, hrp = getChar()
    if not hrp then return end
    local candidates = (area and area.spawns) or DHF.spawnParts(names)
    local best, bestD = nil, math.huge
    for _, part in ipairs(candidates) do
        local d = (part.Position - hrp.Position).Magnitude
        if d <= 70 then DHF.visited[part] = os.clock() end
        if os.clock() - (DHF.visited[part] or -1e9) > 25 and d < bestD then best, bestD = part, d end
    end
    if not best then
        DHF.visited = {}
        for _, part in ipairs(candidates) do
            local d = (part.Position - hrp.Position).Magnitude
            if d < bestD then best, bestD = part, d end
        end
    end
    return best
end

-- ---------- janela da quest / contagem de kills ----------
-- Retorna (visível, atual, máximo)
function DHF.readQuest()
    local q = findQuestGui()
    if not q or not q.Visible then return false end
    local cur, max
    for _, d in ipairs(q:GetDescendants()) do
        if d:IsA("TextLabel") and d.Text then
            local c, m = string.match(d.Text, "(%d+)%s*/%s*(%d+)")
            c, m = tonumber(c), tonumber(m)
            if c and m and c <= m and (not DHF.total or m == DHF.total) then
                cur, max = c, m
                break
            end
        end
    end
    return true, cur, max
end

function DHF.uiActive()
    local vis, cur, max = DHF.readQuest()
    if not vis then return false end
    if cur and max and cur >= max then return false end
    return true
end

function DHF.killsDone()
    return DHF.total and DHF.kills >= DHF.total
end

-- Uma quest nova só é pega quando a atual TERMINOU
function DHF.hasQuest()
    if os.clock() - DHF.takenAt < 8 then return true end
    local vis, cur, max = DHF.readQuest()
    if vis then
        DHF.lastSeen = os.clock()
        if cur and max then
            DHF.lastCur, DHF.lastMax = cur, max
            return cur < max
        end
        return not DHF.killsDone()
    end
    if DHF.killsDone() then return false end
    if DHF.lastMax and DHF.lastCur and DHF.lastCur >= DHF.lastMax - 1 and os.clock() - DHF.lastSeen < 15 then
        return false
    end
    local quiet = math.min(os.clock() - DHF.lastSeen, os.clock() - DHF.lastKillAt)
    return quiet < 150
end

task.spawn(function()
    while Alive do
        task.wait(0.5)
        if Config.Mode == "Level" and DHF.questMob then
            for _, mob in ipairs(enemiesList()) do
                if string.find(mob.Name, DHF.questMob, 1, true) then
                    local hum = mob:FindFirstChildOfClass("Humanoid")
                    if hum and not DHF.watched[hum] then
                        DHF.watched[hum] = true
                        hum.Died:Connect(function()
                            DHF.kills += 1
                            DHF.lastKillAt = os.clock()
                        end)
                    end
                end
            end
        end
    end
end)

-- ---------- pegar a quest ----------
function DHF.take(data, reason)
    if os.clock() - DHF.lastTry < 2 then return end
    DHF.lastTry = os.clock()
    if DHF.uiActive() then DHF.takenAt = os.clock() return end
    -- já pegou uma quest e ainda não matou todos os mobs dela: NÃO pega outra
    if DHF.total and DHF.takenAt > 0 and DHF.kills < DHF.total and os.clock() - DHF.takenAt < 150 then
        Diag.quest = string.format("quest in progress: %d/%d killed; I only take another when all are dead", DHF.kills, DHF.total)
        return
    end
    qlog(string.format("Taking quest (%s): %s", tostring(reason or "?"), data.Label))

    local area = DHF.getArea(data.Mobs)
    local cf
    if area then
        cf = CFrame.new(area.center + Vector3.new(0, 12, 0))
    else
        local sp = DHF.nearestSpawn(data.Mobs)
        if sp then cf = sp.CFrame * CFrame.new(0, 12, 0) end
    end
    local function start()
        invoke("StartQuest", data.Quest.Name, data.Quest.Level)
        local t0 = os.clock()
        while os.clock() - t0 < 0.7 and not DHF.uiActive() do task.wait(0.05) end
    end
    -- tenta aceitar JÁ e continua tentando durante o voo; a viagem termina assim que a quest abre
    do
        local t0, lastTry, arrivedAt = os.clock(), 0, nil
        while Alive and Config.Mode == "Level" and os.clock() - t0 < 90 and not DHF.uiActive() do
            if os.clock() - lastTry > 0.8 then
                lastTry = os.clock()
                task.spawn(invoke, "StartQuest", data.Quest.Name, data.Quest.Level)
            end
            local _, hrp0 = getChar()
            if not hrp0 then return end
            if cf then
                if (cf.Position.Y <= -500) ~= (hrp0.Position.Y <= -500) then break end
                if (hrp0.Position - cf.Position).Magnitude <= 6 then
                    arrivedAt = arrivedAt or os.clock()
                    if os.clock() - arrivedAt > 1.5 then break end
                else
                    flyTo(cf)
                end
            elseif os.clock() - t0 > 2 then
                break
            end
            task.wait(0.08)
        end
        if not Alive or Config.Mode ~= "Level" then return end
    end

    -- não apareceu: vai até o NPC mais perto da área e tenta de novo
    if not DHF.uiActive() then
        local sp = DHF.nearestSpawn(data.Mobs)
        local anchor = area and area.center or (sp and sp.Position)
        local npcs = workspace:FindFirstChild("NPCs")
        if anchor and npcs then
            local bestPos, bestD = nil, 600
            for _, n in ipairs(npcs:GetChildren()) do
                local okp, p = pcall(function() return n:GetPivot().Position end)
                if okp then
                    local d = (p - anchor).Magnitude
                    if d < bestD then bestPos, bestD = p, d end
                end
            end
            if bestPos then
                DHF.flyWait(CFrame.new(bestPos + Vector3.new(0, 4, 0)), 90)
                if not Alive or Config.Mode ~= "Level" then return end
                start()
            end
        end
    end
    DHF.takenAt, DHF.lastSeen = os.clock(), os.clock()
    DHF.lastCur, DHF.lastMax = 0, nil
    DHF.kills = 0
end

