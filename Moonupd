-- ============ SEGURANÇA: um recurso com erro não derruba o loop nem os outros ============
AFL.Err = { list = {}, count = {}, quar = {} }
function AFL.logErr(key, msg)
    local L = AFL.Err.list
    L[#L + 1] = { t = os.date("%H:%M:%S"), key = key, msg = tostring(msg) }
    if #L > 40 then table.remove(L, 1) end
    warn("[Moon Hub] " .. tostring(key) .. ": " .. tostring(msg))
end
function AFL.featOn(key, f)
    if (AFL.Err.quar[key] or 0) > os.clock() then return false end
    local ok, r = pcall(f.on)
    if not ok then AFL.logErr(key, "on(): " .. tostring(r)); return false end
    return r
end
function AFL.featRun(key, f)
    local ok, r = pcall(f.run)
    if ok then AFL.Err.count[key] = 0; return r end
    local c = (AFL.Err.count[key] or 0) + 1
    AFL.Err.count[key] = c
    AFL.logErr(key, r)
    if c >= 3 then
        AFL.Err.quar[key] = os.clock() + 30
        AFL.Err.count[key] = 0
        AFL.logErr(key, "failed 3 times in a row: paused for 30s (the other functions keep running)")
    end
    return false
end
function AFL.prioOrder()
    local order, seen = {}, {}
    if Config.PrioDefault == false then
        for _, label in ipairs(Config.Prio or {}) do
            local key = AFL.featKey[label]
            if key and not seen[key] then seen[key] = true; order[#order + 1] = key end
        end
    end
    for _, key in ipairs(AFL.FeatOrder) do
        if not seen[key] then seen[key] = true; order[#order + 1] = key end
    end
    -- v30: com a ilha do Vulcan em andamento, o Vulcan passa na frente de tudo (nenhuma outra tarefa rouba o personagem)
    local okE, eng = pcall(function() return AFL.Vulc and AFL.Vulc.engaged and AFL.Vulc.engaged() end)
    if okE and eng then
        for i, key in ipairs(order) do
            if key == "Vulcan" then table.remove(order, i); break end
        end
        table.insert(order, 1, "Vulcan")
    end
    return order
end

-- ============ LOOP PRINCIPAL ============
-- Prioridade: 1) fruta no chão (exceto durante boss)  2) gacha  3) Raids  4) Sub Farm  5) Normal Farm
AFL.runMain = function(myEpoch)
    while Alive and myEpoch == State.epoch do
        State.loopAt = os.clock()
        task.wait(Config.Interval)
        if getChar() then
            local ok, err = pcall(function()
                State.Busy = false

                -- Lutando contra um boss? Então nada interrompe (nem fruta, nem gacha, nem raid)
                local bossBusy = os.clock() - (State.bossAt or 0) < 1.5

                for _, key in ipairs(AFL.prioOrder()) do
                    local f = AFL.feat[key]
                    if f and not (f.boss and bossBusy) and AFL.featOn(key, f) then
                        if AFL.featRun(key, f) then
                            State.Busy = true
                            return
                        end
                    end
                end
                if not Config.AutoGacha then Gacha.phase = "idle" end
            end)
            if not ok then
                warn("[Moon Hub] Error: " .. tostring(err))
                Diag.fight = "ERROR: " .. tostring(err)
            end
        else
            State.Busy = false
        end
        if not State.Busy then
            State.Mode, State.Text = "Idle", "—"
            Aim.part, Fight.active, Fight.inPos = nil, false, false
            releaseChar()
        end
    end
end
State.epoch, State.loopAt, State.atkAt = 1, os.clock(), os.clock()
task.spawn(AFL.runMain, State.epoch)

-- Supervisor (v21): 1) se o loop principal travar (remote sem resposta), inicia outro;
-- 2) se o farm está ligado mas nada ataca há 25s, reinicia o ESTADO do farm (quest, grupo, tween) sem mexer nas opções.
