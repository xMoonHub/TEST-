-- ============ FOG (Settings) ============
-- v23: a neve é feita de PARTÍCULAS (ParticleEmitter), por isso sobrava mesmo com FogStart/FogEnd/Atmosphere zerados.
-- Agora ligar a opção também: desliga os emissores de neve/névoa (os que já existem e os que carregarem depois),
-- desliga os Clouds do Terrain e esconde ScreenGuis de clima. Tudo é restaurado ao desligar a opção.
-- Lighting continua sendo reaplicado a CADA FRAME (RenderStepped, depois dos scripts do jogo).
AFL.Fog = { saved = nil, em = setmetatable({}, { __mode = "k" }), tr = setmetatable({}, { __mode = "k" }), fx = setmetatable({}, { __mode = "k" }), conns = {}, gui = {}, scanning = false }
AFL.FogWords = { "snow", "neve", "blizzard", "fog", "mist", "haze", "weather", "nevoa", "névoa" }
function AFL.fogNamed(n)
    n = string.lower(n)
    for _, w in ipairs(AFL.FogWords) do
        if string.find(n, w, 1, true) then return true end
    end
    return false
end
AFL.FogPartWords = { "fog", "mist", "haze", "smog", "nevoa", "névoa", "weather" }
function AFL.fogPartNamed(n)
    n = string.lower(n)
    if string.find(n, "mistake", 1, true) then return false end
    for _, w in ipairs(AFL.FogPartWords) do
        if string.find(n, w, 1, true) then return true end
    end
    return false
end
-- v26: além dos emissores, agora também some com peças/decals/texturas/fumaça de névoa (Transparency = 1)
-- e com os ParticleEmitters cujo pai OU avô tem nome de névoa/neve. Tudo restaurado ao desligar.
function AFL.fogCheck(d)
    local F = AFL.Fog
    local cls = d.ClassName
    if cls == "ParticleEmitter" or cls == "Smoke" then
        if F.em[d] ~= nil then return end
        local p = d.Parent
        local g = p and p.Parent
        if not (AFL.fogNamed(d.Name) or (p and AFL.fogNamed(p.Name)) or (g and g ~= workspace and AFL.fogNamed(g.Name))) then return end
        local m = d:FindFirstAncestorOfClass("Model")
        if m and m:FindFirstChildOfClass("Humanoid") then return end -- não mexe em efeitos de personagens/mobs
        F.em[d] = d.Enabled
        d.Enabled = false
        if cls == "ParticleEmitter" then pcall(function() d:Clear() end) end
    elseif cls == "Part" or cls == "MeshPart" or cls == "UnionOperation" or cls == "Decal" or cls == "Texture" then
        if F.tr[d] ~= nil then return end
        if not AFL.fogPartNamed(d.Name) then
            local p = d.Parent
            if not (p and p ~= workspace and p:IsA("Model") and AFL.fogPartNamed(p.Name)) then return end
        end
        local m = d:FindFirstAncestorOfClass("Model")
        if m and m:FindFirstChildOfClass("Humanoid") then return end
        F.tr[d] = d.Transparency
        d.Transparency = 1
    end
end
function AFL.fogScan()
    local F = AFL.Fog
    if F.scanning then return end
    F.scanning = true
    task.spawn(function()
        local n = 0
        pcall(function()
            for _, root in ipairs({ workspace, game:GetService("Lighting") }) do
                for _, d in ipairs(root:GetDescendants()) do
                    if not (Alive and Config.RemoveFog) then return end
                    AFL.fogCheck(d)
                    n += 1
                    if n % 1500 == 0 then task.wait() end
                end
            end
        end)
        F.scanning = false
    end)
end
function AFL.fogGui()
    local F = AFL.Fog
    pcall(function()
        for _, g in ipairs(Player.PlayerGui:GetChildren()) do
            if g:IsA("ScreenGui") and AFL.fogNamed(g.Name) then
                if F.gui[g] == nil then F.gui[g] = g.Enabled end
                if g.Enabled then g.Enabled = false end
            end
        end
    end)
end
function AFL.fogConnect()
    local F = AFL.Fog
    if #F.conns > 0 then return end
    for _, root in ipairs({ workspace, game:GetService("Lighting") }) do
        table.insert(F.conns, root.DescendantAdded:Connect(function(d)
            if Alive and Config.RemoveFog then pcall(AFL.fogCheck, d) end
        end))
    end
end
function AFL.fogDisconnect()
    local F = AFL.Fog
    for _, c in ipairs(F.conns) do pcall(function() c:Disconnect() end) end
    F.conns = {}
end
function AFL.fogInfo()
    local n, a, pt = 0, 0, 0
    for e in pairs(AFL.Fog.em) do if e.Parent then n += 1 end end
    for d in pairs(AFL.Fog.tr) do if d.Parent then pt += 1 end end
    pcall(function()
        for _, x in ipairs(game:GetService("Lighting"):GetChildren()) do
            if x:IsA("Atmosphere") then a += 1 end
        end
    end)
    return string.format("on — %d snow/fog emitter(s), %d hidden fog part(s), %d atmosphere(s) zeroed", n, pt, a)
end
function AFL.fogApply()
    local ok = pcall(function()
        local L = game:GetService("Lighting")
        local F = AFL.Fog
        if Config.RemoveFog then
            if not F.saved then
                F.saved = { s = L.FogStart, e = L.FogEnd, atm = {}, clouds = {} }
                AFL.fogConnect()
                AFL.fogScan()
                AFL.fogGui()
                Diag.fog = "on — looking for snow/fog..."
            end
            if L.FogEnd ~= 1e6 then L.FogEnd = 1e6 end
            if L.FogStart ~= 9e5 then L.FogStart = 9e5 end
            for _, a in ipairs(L:GetChildren()) do
                if a:IsA("Atmosphere") then
                    if not F.saved.atm[a] then F.saved.atm[a] = { a.Density, a.Haze }; pcall(function() F.saved.atmClone = F.saved.atmClone or {}; table.insert(F.saved.atmClone, a:Clone()) end) end
                    if a.Density ~= 0 then a.Density = 0 end
                    if a.Haze ~= 0 then a.Haze = 0 end
                    pcall(function() if a.Glare ~= 0 then a.Glare = 0 end end)
                    pcall(function() if a.Offset ~= 0 then a.Offset = 0 end end)
                    pcall(function() a:Destroy() end)
                end
            end
            local c = workspace.Terrain:FindFirstChildOfClass("Clouds")
            if c then
                if not F.saved.clouds[c] then F.saved.clouds[c] = c.Enabled end
                if c.Enabled then c.Enabled = false end
            end
            for e in pairs(F.em) do -- se o jogo religar a neve, desliga de novo
                if e.Parent and e.Enabled then e.Enabled = false end
            end
            for d in pairs(F.tr) do
                if d.Parent and d.Transparency ~= 1 then d.Transparency = 1 end
            end
            -- efeitos de tela que embaçam a distância (parecem névoa)
            for _, x in ipairs(L:GetChildren()) do
                if x:IsA("DepthOfFieldEffect") or x:IsA("BlurEffect") then
                    if F.fx[x] == nil then F.fx[x] = x.Enabled end
                    if x.Enabled then x.Enabled = false end
                end
            end
        elseif F.saved then
            L.FogStart, L.FogEnd = F.saved.s, F.saved.e
            for a, v in pairs(F.saved.atm) do
                if a.Parent then a.Density, a.Haze = v[1], v[2] end
            end
            for _, cl in ipairs(F.saved.atmClone or {}) do pcall(function() cl.Parent = L end) end
            for c, was in pairs(F.saved.clouds) do
                if c.Parent then c.Enabled = was end
            end
            for e, was in pairs(F.em) do
                if e.Parent then e.Enabled = was end
            end
            for g, was in pairs(F.gui) do
                if g.Parent then g.Enabled = was end
            end
            for d, was in pairs(F.tr) do
                if d.Parent then d.Transparency = was end
            end
            for x, was in pairs(F.fx) do
                if x.Parent then x.Enabled = was end
            end
            F.em, F.gui, F.saved = setmetatable({}, { __mode = "k" }), {}, nil
            F.tr, F.fx = setmetatable({}, { __mode = "k" }), setmetatable({}, { __mode = "k" })
            AFL.fogDisconnect()
            Diag.fog = "off"
        end
    end)
    return ok
end
