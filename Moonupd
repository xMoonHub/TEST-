    dd:OnChanged(function(v) selected = v end)
    selected = names()[1]
    T:AddButton({ Title = "Refresh Player", Description = "Updates the player list", Callback = function()
        pcall(function() dd:SetValues(names()) end)
    end })
    local function target()
        local p = selected and Players:FindFirstChild(selected)
        local ch = p and p.Character
        return ch and ch:FindFirstChild("HumanoidRootPart")
    end
    T:AddSection("PVP Configs")
    T:AddButton({ Title = "Teleport To Player", Description = "Flies to the selected player once", Callback = function()
        local h = target()
        if h then flyTo(h.CFrame * CFrame.new(0, 0, 4)) end
    end })
    local follow = false
    T:AddToggle("PvpFollow", { Title = "Follow Player", Description = "Keeps flying to the selected player", Default = false }):OnChanged(function(v)
        follow = v
        if v then
            task.spawn(function()
                while Alive and follow do
                    local h = target()
                    if h then pcall(flyTo, h.CFrame * CFrame.new(0, 0, 4)) end
                    task.wait(0.3)
                end
            end)
        end
    end)

    T:AddSection("Movement")
    local ws, jp = tonumber(Config.PvpWS) or 16, tonumber(Config.PvpJP) or 50
    local wsOn, jpOn = false, false
    -- Input sem "Finished": aplica enquanto digita (antes só valia depois do Enter). A cada frame + sinal de mudança, porque o jogo reescreve o WalkSpeed o tempo todo.
    T:AddInput("PvpWalkSpeed", { Title = "Input WalkSpeed", Default = tostring(ws), Numeric = true, Placeholder = "16" }):OnChanged(function(v) ws = tonumber(v) or 16; Config.PvpWS = ws end)
    T:AddToggle("PvpWalkSpeedOn", { Title = "Change WalkSpeed", Default = false }):OnChanged(function(v)
        wsOn = v
        if not v then local _, _, hum = getChar(); if hum then pcall(function() hum.WalkSpeed = 16 end) end end
    end)
    T:AddInput("PvpJumpPower", { Title = "Input JumpPower", Default = tostring(jp), Numeric = true, Placeholder = "50" }):OnChanged(function(v) jp = tonumber(v) or 50; Config.PvpJP = jp end)
    T:AddToggle("PvpJumpPowerOn", { Title = "Change JumpPower", Default = false }):OnChanged(function(v)
        jpOn = v
        if not v then local _, _, hum = getChar(); if hum then pcall(function() hum.JumpPower = 50 end) end end
    end)
    local hooked = setmetatable({}, { __mode = "k" })
    local function applyMove(hum)
        if wsOn and hum.WalkSpeed ~= ws then hum.WalkSpeed = ws end
        if jpOn then
            if not hum.UseJumpPower then hum.UseJumpPower = true end
            if hum.JumpPower ~= jp then hum.JumpPower = jp end
        end
    end
    table.insert(Connections, RunService.Heartbeat:Connect(function()
        if not Alive or not (wsOn or jpOn) then return end
        local c = Player.Character
        local hum = c and c:FindFirstChildOfClass("Humanoid")
        if not hum then return end
        pcall(applyMove, hum)
        if not hooked[hum] then
            hooked[hum] = true
            for _, prop in ipairs({ "WalkSpeed", "JumpPower", "UseJumpPower" }) do
                pcall(function() hum:GetPropertyChangedSignal(prop):Connect(function() pcall(applyMove, hum) end) end)
            end
        end
    end))

    -- Walk On Water (igual ao Banana): plataforma invisível sob os pés em Y = -5 enquanto você está na faixa do mar (Y de -120 a 0)
    local plat
    local water = false
    T:AddToggle("WalkWater", { Title = "Walk On Water", Description = "You walk on top of the sea", Default = Config.WalkWater and true or false }):OnChanged(function(v)
        water = v; Config.WalkWater = v; persist()
        if not v and plat then pcall(function() plat:Destroy() end); plat = nil end
    end)
    water = Config.WalkWater and true or false
    table.insert(Connections, RunService.Heartbeat:Connect(function()
        if not (Alive and water) then return end
        local _, hrp, hum = getChar()
        if not hrp then return end
        if not (plat and plat.Parent) then
            plat = Instance.new("Part")
            plat.Name = "MHWaterWalk"
            plat.Size = Vector3.new(2048, 1, 2048)
            plat.Transparency = 1
            plat.Anchored = true
            plat.CanCollide = false
            plat.Parent = workspace
        end
        local y = hrp.Position.Y
        local sitting = hum and hum.Sit
        if sitting or y > 0 or y < -120 then
            plat.CanCollide = false
        else
            plat.CanCollide = true
            plat.CFrame = CFrame.new(hrp.Position.X, -5, hrp.Position.Z)
        end
    end))
    T:AddSection("PVP Status")
    local pinfo = T:AddParagraph({ Title = "PVP", Content = "Checking..." })
    task.spawn(function()
        while Alive do
            pcall(function()
                local h = target()
                pinfo:SetDesc(table.concat({
                    "Selected: " .. tostring(selected),
                    "Distance: " .. (h and (math.floor((h.Position - (select(2, getChar())).Position).Magnitude) .. "m") or "player not found"),
                    "Follow: " .. (follow and "ON" or "off") .. " | Walk On Water: " .. (water and "ON" or "off"),
                }, "\n"))
            end)
            task.wait(1)
        end
    end)
end


