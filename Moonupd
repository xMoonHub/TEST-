-- Procura uma ferramenta pelo tipo (ToolTip): Melee | Sword | Gun | Blox Fruit
local function findTool(tip)
    local function scan(container)
        if not container then return end
        for _, t in ipairs(container:GetChildren()) do
            if t:IsA("Tool") and t.ToolTip == tip then
                -- frutas físicas (no inventário) têm "Fruit" no nome: não são a fruta comida
                if not (tip == "Blox Fruit" and string.find(t.Name, "Fruit")) then return t end
            end
        end
    end
    local eq = scan(Player.Character)
    if eq then return eq, true end
    local bp = scan(Player.Backpack)
    if bp then return bp, false end
end

local function findToolByName(sub)
    for _, container in ipairs({ Player.Character, Player.Backpack }) do
        if container then
            for _, t in ipairs(container:GetChildren()) do
                if t:IsA("Tool") and string.find(string.lower(t.Name), sub, 1, true) then
                    return t, container == Player.Character
                end
            end
        end
    end
end

local function equipWeapon()
    local char, _, hum = getChar()
    if not char then return end
    if (Config.PayHoldUntil or 0) > os.clock() then return end -- pagando a raid com fruta: a fruta fica na mão
    local tool, equipped
    local spec = Config.SeaTool
    if Config.ForceTool and os.clock() < (Config.ForceUntil or 0) then
        tool, equipped = findToolByName(Config.ForceTool)
    elseif spec and os.clock() < Config.SeaUntil then -- Sea Events: arma escolhida para o evento
        if spec.name then tool, equipped = findToolByName(spec.name) else tool, equipped = findTool(spec.tip) end
    elseif Config.MastName then
        tool, equipped = findToolByName(string.lower(Config.MastName))
    elseif os.clock() < (Config.MastFinishUntil or 0) then
        tool, equipped = findTool(Config.MastMethod)
    else
        tool, equipped = findTool(Config.Weapon)
    end
    if tool and not equipped then hum:EquipTool(tool) end
end

-- Frutas com M1 suportado (a fruta que você comeu: Dragon East/West, T-Rex, Gas, Ice, Light)
