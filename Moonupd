    function S.ser(x, depth)
        local t = typeof(x)
        if t == "Instance" then return x:GetFullName() end
        if t == "Vector3" then return string.format("V3(%.0f,%.0f,%.0f)", x.X, x.Y, x.Z) end
        if t == "table" then
            if depth > 0 then return "{...}" end
            local out, n = {}, 0
            for k, v in pairs(x) do
                n = n + 1
                if n > 6 then out[#out + 1] = "..."; break end
                out[#out + 1] = tostring(k) .. "=" .. S.ser(v, 1)
            end
            return "{" .. table.concat(out, ",") .. "}"
        end
        return tostring(x)
    end
