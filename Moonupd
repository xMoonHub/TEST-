function AFL.tyrantEyes()
    local map = workspace:FindFirstChild("Map")
    local tiki = map and map:FindFirstChild("TikiOutpost")
    local island = tiki and tiki:FindFirstChild("IslandModel")
    if not island then return 0, false end
    local c = 0
    for i = 1, 4 do
        local eye = island:FindFirstChild("Eye" .. i, true)
        if eye and eye:IsA("BasePart") and eye.Transparency == 0 then c += 1 end
    end
    return c, true
end
-- hook no mouse: Mouse.Hit / Mouse.Target apontam para o chão do vaso enquanto a mira está ativa
function AFL.tvHook()
    local V = AFL.TV
    if V.hooked or not hookmetamethod then return end
    V.hooked = true
    local mouse = Player:GetMouse()
    local wrap = newcclosure or function(f) return f end
    local old
    local ok = pcall(function()
        old = hookmetamethod(game, "__index", wrap(function(self, key)
            if self == mouse and Alive and V.aimPos and not (checkcaller and checkcaller()) then
                if key == "Hit" then return CFrame.new(V.aimPos) end
                if key == "Target" then return V.aimPart end
            end
            return old(self, key)
        end))
    end)
    if not ok then V.hooked = false end
end
function AFL.tvAimDown(pos, action)
    local V = AFL.TV
    local char = Player.Character
    if not char then return end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { char, workspace:FindFirstChild("Enemies") or char }
    local hit = workspace:Raycast(pos, Vector3.new(0, -300, 0), params)
    local aimPos = hit and hit.Position or (pos - Vector3.new(0, 20, 0))
    local aimPart = hit and hit.Instance
    AFL.tvHook()
    V.aimPos, V.aimPart = aimPos, aimPart
    local cam = workspace.CurrentCamera
    pcall(function() RunService:UnbindFromRenderStep("MoonHubAimDown") end)
    pcall(function()
        RunService:BindToRenderStep("MoonHubAimDown", Enum.RenderPriority.Camera.Value + 2, function()
            local _, yaw = cam.CFrame:ToOrientation()
            cam.CFrame = CFrame.new(cam.CFrame.Position) * CFrame.fromOrientation(-math.rad(89), yaw, 0)
        end)
    end)
    task.wait(0.2)
    pcall(action, aimPos, aimPart)
    pcall(function() RunService:UnbindFromRenderStep("MoonHubAimDown") end)
    V.aimPos, V.aimPart = nil, nil
end
function AFL.tvShoot(pos)
    AFL.tvAimDown(pos, function(aimPos, aimPart)
        local char = Player.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local netF = ReplicatedStorage:FindFirstChild("Modules") and ReplicatedStorage.Modules:FindFirstChild("Net")
        local shootEvent = netF and netF:FindFirstChild("RE/ShootGunEvent")
        local cam = workspace.CurrentCamera
        for _ = 1, 5 do
            if not (Alive and Config.KillTyrant) then return end
            local tool = char and char:FindFirstChildOfClass("Tool")
            if not (tool and tool.Name == "Skull Guitar") then
                local g = Player.Backpack:FindFirstChild("Skull Guitar")
                if g and hum then hum:EquipTool(g) task.wait(0.3) end
                tool = char and char:FindFirstChildOfClass("Tool")
            end
            if not tool then return end
            pcall(function() tool:Activate() end)
            pcall(function()
                VirtualUser:CaptureController()
                VirtualUser:Button1Down(Vector2.new(1280, 672))
                VirtualUser:Button1Up(Vector2.new(1280, 672))
            end)
            if mouse1click then pcall(mouse1click) end
            pcall(function()
                local s = cam.ViewportSize
                local cx, cy = s.X / 2, s.Y / 2
                VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, true, game, 0)
                VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, false, game, 0)
            end)
            pcall(function()
                local s = cam.ViewportSize
                local cx, cy = s.X / 2, s.Y / 2
                VirtualInputManager:SendTouchEvent(1, 0, cx, cy)
                task.wait(0.05)
                VirtualInputManager:SendTouchEvent(1, 2, cx, cy)
            end)
            if shootEvent then pcall(shootEvent.FireServer, shootEvent, aimPos, { aimPart }) end
            local sf = tool:FindFirstChild("RemoteFunctionShoot")
            if sf then task.spawn(pcall, sf.InvokeServer, sf, aimPos, aimPart) end
            task.wait(0.3)
        end
    end)
end
-- sem Skull Guitar: cada arma que você tiver (fruta, melee, espada, gun): M1 por ~1s + skills Z X C V F
function AFL.tvSkills(abort)
    local char = Player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    for _, tip in ipairs({ "Blox Fruit", "Melee", "Sword", "Gun" }) do
        if abort() then return end
        local tool = findTool(tip)
        if tool then
            hum:EquipTool(tool)
            task.wait(0.3)
            local t0 = os.clock()
            while os.clock() - t0 < 1 and not abort() do
                if tip == "Melee" then
                    pcall(cfAttack)
                else
                    pcall(function() tool:Activate() end)
                end
                task.wait(0.08)
            end
            local low = string.lower(tool.Name)
            local isTransform = false
            for _, w in ipairs(AFL.TV.transform) do
                if tip == "Blox Fruit" and string.find(low, w, 1, true) then isTransform = true end
            end
            for _, k in ipairs({ "Z", "X", "C", "V", "F" }) do
                if abort() then return end
                if not (isTransform and k == "V") then
                    AFL.potKey(k)
                    task.wait(0.3)
                end
            end
        end
    end
end
function AFL.tvRun()
    local V = AFL.TV
    if V.running then return end
    V.running = true
    task.spawn(function()
        local function abort()
            return not (Alive and Config.KillTyrant) or bossAlive("Tyrant of the Skies") ~= nil
        end
        local ok, err = pcall(function()
            for i, pos in ipairs(V.vases) do
                if abort() then break end
                V.idx = i
                local cf = CFrame.new(pos)
                local t0 = os.clock()
                while not abort() and os.clock() - t0 < 60 do
                    local _, hrp = getChar()
                    if not hrp or (hrp.Position - pos).Magnitude <= 8 then break end
                    flyTo(cf)
                    task.wait(0.1)
                end
                if abort() then break end
                local _, hrp = getChar()
                if hrp then
                    if currentTween then currentTween:Cancel() end
                    hrp.CFrame = cf
                    hrp.AssemblyLinearVelocity = Vector3.zero
                end
                if findToolByName("skull guitar") then
                    Diag.summon = string.format("Auto Tyrant step 2: pot %d/%d with the Skull Guitar", i, #V.vases)
                    AFL.tvShoot(pos)
                else
                    if os.clock() - V.warnAt > 30 then
