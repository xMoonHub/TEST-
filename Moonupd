-- ============ SEA EVENTS ============
-- Pilota o barco, sai dele quando aparece um evento selecionado, mata (por prioridade) e volta.
-- Tudo aqui depende de nomes/pastas do jogo que NÃO consegui verificar: ver Status > sea para o diagnóstico.
local Sea = {}
do
    local st = { wp = nil, origin = nil, heading = math.random() * math.pi * 2, waterY = nil,
        skillBusy = false, skip = setmetatable({}, { __mode = "k" }), buyAt = 0, resetAt = 0, dealer = nil, returning = false, cruise = nil, roughAt = 0 }
    table.insert(Connections, Player.CharacterAdded:Connect(function() st.died = true end))
    local BoatNames = {
        ["Beast Hunter"] = { "Beast Hunter", "BeastHunter" }, Guardian = { "Guardian" }, Lantern = { "Lantern" },
        Sleigh = { "Sleigh" }, Brigade = { "PirateBrigade", "Brigade" }, ["Grand Brigade"] = { "PirateGrandBrigade", "GrandBrigade" },
    }
    local KEYS = { "Z", "X", "C", "V", "F" }
    -- Zonas do Mar 3 (coordenadas fornecidas pelo usuário); índice 7 = Infinite
    local ZONES = {
        Vector3.new(-21998.375, 30, -682.309), Vector3.new(-26779.5215, 30, -822.858),
        Vector3.new(-31171.957, 30, -2256.9377), Vector3.new(-34054.6875, 30, -2560.1201),
        Vector3.new(-38887.5547, 30, -2162.9902), Vector3.new(-44541.7617, 30, -1244.8584),
        Vector3.new(-10000000, 31, 37016.25),
    }
    -- Mar 3: Tiki Outpost | Mar 2: Docas (coordenadas aproximadas)
    local function SeaRef()
        return (getSea() == 3) and Vector3.new(-16224, 9, 439) or Vector3.new(-6500, 10, -4000)
    end
    local WEAPONS = { "Melee", "Blox Fruit", "Sword", "Gun" }

    local function classify(m)
        local n = string.lower(m.Name)
        if string.find(n, "terror", 1, true) then return "Terrorshark" end
        if string.find(n, "seabeast", 1, true) or string.find(n, "sea beast", 1, true) then return "Sea Beast" end
        if string.find(n, "piranha", 1, true) then return "Piranha" end
        if string.find(n, "shark", 1, true) then return "Shark" end
        if string.find(n, "brigade", 1, true) or string.find(n, "fishboat", 1, true) or string.find(n, "ship", 1, true) then return "Ship" end
    end
    local function partOf(m)
        return m:FindFirstChild("HumanoidRootPart") or m.PrimaryPart or m:FindFirstChildWhichIsA("BasePart", true)
    end
    local function aliveM(m)
        local h = m:FindFirstChildOfClass("Humanoid")
        if h then return h.Health > 0 end
        local hv = m:FindFirstChild("Health")
        if hv and hv:IsA("ValueBase") then return hv.Value > 0 end
        return m.Parent ~= nil
    end
    local function isMine(b)
        local o = b:FindFirstChild("Owner")
        return o and (o.Value == Player or tostring(o.Value) == Player.Name)
    end

    local function scan(hrp, range)
        local out = {}
        local folders = { workspace:FindFirstChild("SeaBeasts"), workspace:FindFirstChild("Enemies"), workspace:FindFirstChild("Boats") }
        for fi, folder in ipairs(folders) do
            if folder then
                for _, m in ipairs(folder:GetChildren()) do
                    if m:IsA("Model") and not (fi == 3 and m:FindFirstChild("Owner")) then
                        local ty = classify(m)
                        if ty and (fi ~= 3 or ty == "Ship") and aliveM(m) then
                            local p = partOf(m)
                            if p then
                                local d = (p.Position - hrp.Position).Magnitude
                                if d <= range then out[#out + 1] = { m = m, type = ty, part = p, dist = d } end
                            end
                        end
                    end
                end
            end
        end
        return out
    end

    local function pickTarget(list)
        local sel = Config.SeaEvents
        local order, used = {}, {}
        for _, n in ipairs(Config.SeaPrio) do
            if sel[n] and not used[n] then order[#order + 1] = n; used[n] = true end
        end
        for _, n in ipairs({ "Terrorshark", "Sea Beast", "Ship", "Shark", "Piranha" }) do
            if sel[n] and not used[n] then order[#order + 1] = n end
        end
        for _, want in ipairs(order) do
            local best
            for _, t in ipairs(list) do
                if t.type == want and (not best or t.dist < best.dist) then best = t end
            end
            if best then return best end
        end
    end

    local function pressKey(name)
        local kc = Enum.KeyCode[name]
        if not kc then return end
        pcall(function()
            VirtualInputManager:SendKeyEvent(true, kc, false, game)
            task.wait(0.12)
            VirtualInputManager:SendKeyEvent(false, kc, false, game)
        end)
    end

    -- arma de M1 escolhida pelas opções (nil = usar as skills)
    local function m1Weapon(ty)
        local o = Config.SeaOpt
        local ds, sg = findToolByName("dragonstorm"), findToolByName("skull guitar")
        if o.AutoChangeDS and ds and sg then return { name = (ty == "Sea Beast") and "skull guitar" or "dragonstorm" } end
        if o.UseDS and ty ~= "Sea Beast" and ds then return { name = "dragonstorm" } end
        if o.ChangeDSBoat and ty == "Ship" and ds then return { name = "dragonstorm" } end
        if o.UseSG and (ty == "Ship" or ty == "Sea Beast") and sg then return { name = "skull guitar" } end
        if o.UseM1Fruit then return { tip = "Blox Fruit" } end
    end

    local function skillWorker()
        if st.skillBusy then return end
        st.skillBusy = true
        task.spawn(function()
            for _, tip in ipairs(WEAPONS) do
                if Alive and Config.SeaWeapons[tip] then
                    Config.SeaTool = { tip = tip }
                    pcall(equipWeapon)
                    task.wait(0.25)
                    for _, k in ipairs(KEYS) do
                        if Alive and Config.SeaSkills[tip][k] then
                            Config.SeaUntil = os.clock() + 1.2
                            pressKey(k)
                            task.wait(0.2)
                        end
                    end
                end
            end
            st.skillBusy = false
        end)
    end

    -- AUTO DODGE (lógica do Banana Hub)
    -- Terrorshark: o ataque cria a parte "ChargeUp" em workspace._WorldOrigin; sobe 200 studs até ela sumir.
    -- Sea Beast: ao tocar uma animação que não é loop (ataque/raio) no Animator dele, sobe 200 studs pela duração.
    function st.dodge(sec) st.dodgeUntil = math.max(st.dodgeUntil or 0, os.clock() + sec) end
    st.hooked = setmetatable({}, { __mode = "k" })
    function st.hookBeast(part)
        local m = part and part:FindFirstAncestorOfClass("Model")
        if not m or st.hooked[m] then return end
        st.hooked[m] = true
        pcall(function()
            local an = m:FindFirstChildWhichIsA("Animator", true)
            if not an then return end
            table.insert(Connections, an.AnimationPlayed:Connect(function(track)
                if not Config.SeaOpt.DodgeBeast then return end
                local len = 2
                pcall(function() if track.Length and track.Length > 0 then len = track.Length end end)
                if track.Looped then return end
                st.dodge(math.min(len, 6) + 0.7)
            end))
        end)
    end
    task.spawn(function()
        local wo = workspace:WaitForChild("_WorldOrigin", 60)
        if not wo then return end
        local function onPart(p)
            if p.Name ~= "ChargeUp" or not Config.SeaOpt.DodgeShark then return end
            local c = Player.Character
            local hrp = c and c:FindFirstChild("HumanoidRootPart")
            if not (hrp and p:IsA("BasePart")) or (p.Position - hrp.Position).Magnitude > 250 then return end
            local born = os.clock()
            st.dodgeUntil = os.clock() + 14
            local conn
            conn = p.AncestryChanged:Connect(function()
                if p.Parent then return end
                conn:Disconnect()
                st.dodgeUntil = (os.clock() - born < 1) and (os.clock() + 2.5) or os.clock()
            end)
        end
        table.insert(Connections, wo.ChildAdded:Connect(function(p) pcall(onPart, p) end))
    end)
    local function combat(t, hrp, hum)
        local o = Config.SeaOpt
        if t.type == "Sea Beast" then st.hookBeast(t.part) end
        Config.SeaUntil = os.clock() + 1.2
        st.cruise = nil
        if hum.Sit then hum.Sit = false end
        local h = 20
        local mw = m1Weapon(t.type)
        if mw and (mw.tip == "Blox Fruit" or mw.name) then h = 14 end -- M1: mais perto, acerta mais
        if t.type == "Ship" then h = 2 end -- barco: bem perto, o M1 de fruta acerta
        if t.type == "Sea Beast" then h = h + 40 end -- +40 studs só no Sea Beast
        if st.dodgeUntil and os.clock() < st.dodgeUntil and (t.type == "Terrorshark" or t.type == "Sea Beast") then h = 200 end -- auto dodge (estilo Banana): sobe 200 studs
        local stand = t.part.Position + Vector3.new(0, h, 0)
        do
            local wy = st.waterY
            pcall(function()
                local pl = workspace:FindFirstChild("Map") and workspace.Map:FindFirstChild("WaterBase-Plane")
                if pl and pl:IsA("BasePart") then wy = pl.Position.Y + pl.Size.Y / 2 end
            end)
            wy = wy or (hrp.Position.Y - 20)
            if t.type ~= "Ship" and stand.Y < wy + 20 then stand = Vector3.new(stand.X, wy + 20, stand.Z) end
        end
        Aim.part, Aim.level = t.part, false
        if (hrp.Position - stand).Magnitude > 10 then
            flyTo(CFrame.new(stand))
        else
            if currentTween then currentTween:Cancel() end
            hrp.CFrame = CFrame.lookAt(stand, t.part.Position)
            hrp.AssemblyLinearVelocity = Vector3.zero
        end
        local w = m1Weapon(t.type)
        Config.SeaClick = w and { kind = (w.name == "dragonstorm" and "ds") or (w.name == "skull guitar" and "sg") or "fruit", part = t.part, untilT = os.clock() + 0.8 } or nil
        if w then
            Config.SeaTool = w
            pcall(equipWeapon)
        else
            skillWorker()
        end
        Config.AttackUntil = os.clock() + 0.8
        Diag.sea = string.format("killing %s (%d studs) | %s", t.type, math.floor(t.dist), w and "M1" or "skills")
    end

    local function myBoat(hum, hrp)
        local sp = hum.SeatPart
        if sp and sp:IsA("VehicleSeat") then
            local b = sp:FindFirstAncestorOfClass("Model")
            if b then return b, sp end
        end
        local folder = workspace:FindFirstChild("Boats")
        if not folder then return end
        local nearest, nd
        for _, b in ipairs(folder:GetChildren()) do
            if b:IsA("Model") then
                local seat = b:FindFirstChildWhichIsA("VehicleSeat", true)
                if seat then
                    if isMine(b) and not st.skip[b] then return b, seat end
                    -- barco recém-comprado: o mais próximo sem dono diferente
                    if os.clock() - st.buyAt < 60 and not b:FindFirstChild("Owner") then
                        local d = (seat.Position - hrp.Position).Magnitude
                        if d < 250 and (not nd or d < nd) then nearest, nd = { b, seat }, d end
                    end
                end
            end
        end
        if nearest then return nearest[1], nearest[2] end
    end

    local function findDealer()
        local npcs = workspace:FindFirstChild("NPCs")
        if not npcs then return end
        local lux = (Config.SeaBoat ~= "Brigade" and Config.SeaBoat ~= "Grand Brigade")
        -- Mar 3: só no Tiki Outpost | Mar 2: só nas Docas (pontos de referência aproximados: pega o vendedor mais perto deles)
        local ref = SeaRef()
        local best, bd, any, ad
        for _, n in ipairs(npcs:GetChildren()) do
            local nm = string.lower(n.Name)
            if string.find(nm, "boat dealer", 1, true) then
                local d = (n:GetPivot().Position - ref).Magnitude
                if (string.find(nm, "luxury", 1, true) ~= nil) == lux then
                    if not bd or d < bd then best, bd = n, d end
                end
                if not ad or d < ad then any, ad = n, d end
            end
        end
        return best or any
    end

    local function buyBoat(hrp, hum)
        local now = os.clock()
        if getSea() == 3 and (hrp.Position - SeaRef()).Magnitude > 220 then
            Diag.sea = "flying to the Tiki Outpost to buy the boat"
            st.dealer = nil
            flyTo(CFrame.new(SeaRef() + Vector3.new(0, 40, 0)))
            return true
        end
        if not (st.dealer and st.dealer.Parent) then st.dealer = findDealer() end
        if st.dealer then
            local pos = st.dealer:GetPivot().Position
            if (hrp.Position - pos).Magnitude > 35 then
                Diag.sea = "going to the boat dealer"
                flyTo(CFrame.new(pos + Vector3.new(0, 4, 0)))
                return true
            end
        elseif (hrp.Position - SeaRef()).Magnitude > 150 then
            -- vendedor ainda não carregou (longe): vai até o Tiki/Docas, de qualquer lugar do mapa
            Diag.sea = (getSea() == 3) and "going to the Tiki Outpost to buy the boat" or "going to the Docks to buy the boat"
            flyTo(CFrame.new(SeaRef() + Vector3.new(0, 40, 0)))
            return true
        end
        if now - st.buyAt < (st.buyOk and 3 or 1) then Diag.sea = "waiting for the boat to appear"; return true end
        st.buyAt = now
        local ok, r
        for _, nm in ipairs(BoatNames[Config.SeaBoat] or BoatNames["Beast Hunter"]) do
            ok, r = invoke("BuyBoat", nm)
            if ok and r then break end
        end
        st.buyOk = (ok and r) and true or false
        Diag.sea = "buy boat " .. tostring(Config.SeaBoat) .. ": " .. (ok and "" or "error ") .. tostring(r)
        if not (ok and r) and Config.SeaOpt.ResetBuy and now - st.resetAt > 60 and now - (st.noBoatAt or now) > 12 then
            st.resetAt = now
            pcall(function() hum.Health = 0 end)
        end
        return true
    end

    Sea.step = function(force)
        Sea.st = st
        local o = Config.SeaOpt
        if force then Sea.forceUntil = os.clock() + 1.5 end
        if not (Config.SeaOn or force) then st.cruise = nil; return false end
        if getSea() < 2 then Diag.sea = "Sea Events: Sea 1 does not work (use Sea 2 or 3)"; return false end
        local char, hrp, hum = getChar()
        if not char then return false end

        local t = (not force) and pickTarget(scan(hrp, o.TweenUntil and 3000 or 450)) or nil
        if t then combat(t, hrp, hum); return true end
        Aim.part = nil

        local boat, seat = myBoat(hum, hrp)
        if boat then st.hadBoat, st.noBoatAt = true, nil end
        if not boat then
            st.cruise = nil
            -- barco destruído e nenhum bicho para matar: reseta o personagem para comprar outro
            st.noBoatAt = st.noBoatAt or os.clock()
            if st.hadBoat and o.ResetBuy and os.clock() - st.resetAt > 20 and os.clock() - st.noBoatAt > 12 then
                st.hadBoat, st.resetAt = false, os.clock()
                Diag.sea = "boat destroyed: resetting character"
                pcall(function() hum.Health = 0 end)
                return true
            end
            return buyBoat(hrp, hum)
        end
        if hum.SeatPart ~= seat then
            st.cruise = nil
            local d = (hrp.Position - seat.Position).Magnitude
            if d > 150 and st.died then
                st.skip[boat] = true
                Diag.sea = "boat far away: buying another"
                return buyBoat(hrp, hum)
            end
            if d > 12 then
                Diag.sea = "going back to the boat"
                flyTo(seat.CFrame * CFrame.new(0, 3, 0))
            else
                if currentTween then currentTween:Cancel() end
                hrp.CFrame = seat.CFrame * CFrame.new(0, 2, 0)
                pcall(seat.Sit, seat, hum)
            end
            return true
        end

        -- pilotando
        st.died, st.noBoatAt = false, nil
        Config.SeaSitUntil = os.clock() + 0.6
        local pos = seat.Position
        st.waterY = st.waterY or pos.Y
        -- origem fixa: o vendedor de barcos (Mar 3 = Tiki Outpost, Mar 2 = Docas); as zonas contam a partir dele
        if not st.origin or st.originSea ~= getSea() then
            local dl = findDealer()
            st.origin = dl and dl:GetPivot().Position or pos
            st.originSea, st.wp, st.returning = getSea(), nil, false
        end
        local flat = function(a, b) return Vector3.new(a.X - b.X, 0, a.Z - b.Z).Magnitude end
        if o.Back10k and flat(pos, st.origin) > 10000 then st.returning = true end
        if st.returning then
            st.wp = st.origin
            if flat(pos, st.origin) < 300 then st.returning = false; st.wp = nil end
        else
            -- direção "para o mar": do centro do mapa para fora, passando pela origem
            local out = Vector3.new(st.origin.X, 0, st.origin.Z)
            out = (out.Magnitude > 1) and out.Unit or Vector3.new(-1, 0, 0)
            if getSea() == 3 then
                -- Mar 3: vai para a zona escolhida (1-6) e PARA nela; sem zona = Infinite (segue para sempre)
                st.wp = ((Sea.zone or Config.SeaZone) > 0) and ZONES[(Sea.zone or Config.SeaZone)] or ZONES[7]
                if (Sea.zone or Config.SeaZone) > 0 and flat(pos, st.wp) < 150 then
                    st.cruise = nil
                    Diag.sea = "stopped in zone " .. (Sea.zone or Config.SeaZone) .. " | waiting for events"
                    return true
                end
            elseif (Sea.zone or Config.SeaZone) > 0 then
                -- zona N = N*2000 studs a partir da origem; chegando lá, o barco PARA e espera os eventos
                st.wp = st.origin + out * ((Sea.zone or Config.SeaZone) * 2000)
                if flat(pos, st.wp) < 150 then
                    st.cruise = nil
                    Diag.sea = "stopped in zone " .. (Sea.zone or Config.SeaZone) .. " | waiting for events"
                    return true
                end
            else
                -- sem zona: segue em linha reta, infinitamente
                st.wp = pos + out * 3000
            end
        end
        if o.RoughTp and os.clock() - st.roughAt > 20
            and (workspace:FindFirstChild("RoughSea") or game:GetService("Lighting"):FindFirstChild("RoughSea")) then
            st.roughAt = os.clock()
            pcall(function() boat:PivotTo(boat:GetPivot() + Vector3.new(math.cos(st.heading) * 1500, 0, math.sin(st.heading) * 1500)) end)
        end
        st.cruise = { boat = boat, seat = seat, target = st.wp, fly = Config.SeaFly,
            speed = Config.SeaFly and Config.SeaFlySpeed or Config.SeaSpeed }
        Diag.sea = string.format("sailing (%s, %d studs/s) | no event", Config.SeaFly and "flying" or "on the sea", st.cruise.speed)
        return true
    end

    -- Sem colisão total enquanto estiver no barco: roda a cada passo de física (Stepped), com a lista de peças em cache
    local ncParts, ncAt = {}, 0
    table.insert(Connections, RunService.Stepped:Connect(function()
        if not (Alive and (Config.SeaOn or os.clock() < (Sea.forceUntil or 0))) then return end
        local char, _, hum = getChar()
        if not (char and hum and hum.SeatPart) then return end
        local boat = hum.SeatPart:FindFirstAncestorOfClass("Model")
        if not boat then return end
        if os.clock() - ncAt > 1 or ncParts.boat ~= boat then
            ncAt = os.clock()
            ncParts = { boat = boat }
            for _, d in ipairs(boat:GetDescendants()) do
                if d:IsA("BasePart") then ncParts[#ncParts + 1] = d end
            end
            for _, d in ipairs(char:GetDescendants()) do
                if d:IsA("BasePart") then ncParts[#ncParts + 1] = d end
            end
        end
        for _, d in ipairs(ncParts) do
            if d.Parent then d.CanCollide = false end
        end
    end))

    table.insert(Connections, RunService.Heartbeat:Connect(function(dt)
        local c = st.cruise
        if not (Alive and c) then return end
        if not ((Config.SeaOn or os.clock() < (Sea.forceUntil or 0)) and c.boat and c.boat.Parent) then st.cruise = nil; return end
        pcall(function()
            local pos = c.boat:GetPivot().Position
            local dir = Vector3.new(c.target.X - pos.X, 0, c.target.Z - pos.Z)
            -- barco sem colisão: atravessa paredes/ilhas (throttle de 0,5s)
            if os.clock() - (c.nc or 0) > 0.5 then
                c.nc = os.clock()
                for _, d in ipairs(c.boat:GetDescendants()) do
                    if d:IsA("BasePart") then d.CanCollide = false end
                end
            end
            if dir.Magnitude < 20 then return end
            dir = dir.Unit
            local y = c.fly and (st.waterY + 30) or pos.Y
            local np = Vector3.new(pos.X + dir.X * c.speed * dt, y, pos.Z + dir.Z * c.speed * dt)
            c.boat:PivotTo(CFrame.lookAt(np, np + dir))
            -- velocidade na direção do destino (o servidor não "puxa de volta" o barco para trás)
            local vel = dir * c.speed
            if c.fly then vel = Vector3.new(vel.X, 0, vel.Z) end
            local pp = c.seat or c.boat.PrimaryPart
            if pp then pp.AssemblyLinearVelocity = vel end
        end)
    end))
end

