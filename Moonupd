end)

-- ============ M1 DE FRUTA (LeftClickRemote) ============
-- Código do fruit.lua: cada fruta tem tool.LeftClickRemote.
--  * frutas normais (Dragon, T-Rex, Kitsune, Tiger, Yeti, Mammoth...): FireServer(Vector3.new(0.01,-500,0.01), 1, true)
--  * Blade-Blade, Gas-Gas, Control, Magnet, Pain, Chop: FireServer(direção até o alvo, combo 1..5) para cada mob a até 60 studs
--    (Control/Magnet/Pain/Chop: formato não confirmado -> também dispara o clique normal e o Activate)
--  * fruta com atributo ServerState ou sem LeftClickRemote: Tool:Activate
-- Rajadas de 3 cliques (o jogo põe cooldown no 4º) + zera cooldown/debounce da fruta.
local FruitM1 = { at = 0, combo = 0, cdAt = 0, last = 0,
    remoteFruits = { ["Blade-Blade"] = true, ["Gas-Gas"] = true, ["Control-Control"] = true, ["Magnet-Magnet"] = true, ["Pain-Pain"] = true, ["Chop-Chop"] = true },
    gap = { ["Normal Attack"] = 0.1, ["Fast Attack"] = 0.03, ["Super Fast Attack"] = 0 }, burst = { ["Normal Attack"] = 1, ["Fast Attack"] = 3, ["Super Fast Attack"] = 10 } }

function FruitM1.strip()
    local now = os.clock()
    if now - FruitM1.cdAt < 0.05 then return end
    FruitM1.cdAt = now
    pcall(function()
        local char = Player.Character
        local tool = char and char:FindFirstChildOfClass("Tool")
        if not tool then return end
        local function isCd(name)
            local n = string.lower(name)
            return string.find(n, "cooldown", 1, true) or string.find(n, "debounce", 1, true)
                or string.find(n, "combo", 1, true) or n == "cd" or string.find(n, "delay", 1, true)
        end
        for _, holder in ipairs({ tool, char }) do
            for name, v in pairs(holder:GetAttributes()) do
                if isCd(name) then
                    if type(v) == "number" then holder:SetAttribute(name, 0)
                    elseif type(v) == "boolean" and v == true and string.find(string.lower(name), "cooldown", 1, true) then
                        holder:SetAttribute(name, false)
                    end
                end
            end
        end
        for _, d in ipairs(tool:GetDescendants()) do
            if (d:IsA("NumberValue") or d:IsA("IntValue")) and isCd(d.Name) then d.Value = 0
            elseif d:IsA("BoolValue") and string.find(string.lower(d.Name), "cooldown", 1, true) then d.Value = false end
        end
    end)
end

function FruitM1.tick()
    local now = os.clock()
    if now - FruitM1.at < (FruitM1.gap[Config.AttackMode] or 0.04) then return end
    FruitM1.at = now
    FruitM1.strip()
    local char = Player.Character
    local tool = char and char:FindFirstChildOfClass("Tool")
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not (tool and hrp) then return end
    local remote = tool:FindFirstChild("LeftClickRemote")
    local fname = tool.Name
    local short = string.match(fname, "^(%a+)")
    local isRemote = FruitM1.remoteFruits[fname] or (short and FruitM1.remoteFruits[short .. "-" .. short])
    local hedged = isRemote and not (fname == "Blade-Blade" or fname == "Gas-Gas") -- Control/Magnet/Pain/Chop
    -- Control/Magnet/Pain/Chop: dispara mesmo com ServerState (ele pode ficar sempre preenchido nessas frutas)
    if remote and (tool:GetAttribute("ServerState") == nil or hedged) then
        if isRemote then
            -- alvos: mobs a até 60 studs (como no fruit.lua) + o alvo da mira (boss/sea beast fora da pasta Enemies)
            local dirs, poss = {}, {}
            local folder = workspace:FindFirstChild("Enemies")
            if folder then
                for _, mob in ipairs(folder:GetChildren()) do
                    if not mob:GetAttribute("IsBoat") then
                        local h = mob:FindFirstChildOfClass("Humanoid")
                        local rt = mob:FindFirstChild("HumanoidRootPart") or mob.PrimaryPart
                        if h and h.Health > 0 and rt and (rt.Position - hrp.Position).Magnitude <= (hedged and 80 or 60) then
                            dirs[#dirs + 1] = rt.Position - hrp.Position
                            poss[#poss + 1] = rt.Position
                        end
                    end
                end
            end
            if #dirs == 0 and Aim.part and Aim.part.Parent then
                dirs[1] = Aim.part.Position - hrp.Position
                poss[1] = Aim.part.Position
            end
            if os.clock() - FruitM1.last > 0.65 then FruitM1.combo = 0 end
            FruitM1.last = os.clock()
            for _ = 1, (FruitM1.burst[Config.AttackMode] or 3) do
                FruitM1.combo = FruitM1.combo % 5 + 1
                for i, d in ipairs(dirs) do
                    if d.Magnitude > 0.01 then
                        pcall(remote.FireServer, remote, d.Unit, FruitM1.combo)
                        if hedged then
                            -- formatos alternativos (posição do alvo): o remote ignora o que não entende
                            pcall(remote.FireServer, remote, poss[i], FruitM1.combo)
                            pcall(remote.FireServer, remote, poss[i], d.Unit, FruitM1.combo)
                        end
                    end
                end
            end
            if hedged then
                pcall(remote.FireServer, remote, Vector3.new(0.01, -500, 0.01), 1, true)
                pcall(function() tool:Activate() end)
            end
        else
            for _ = 1, (FruitM1.burst[Config.AttackMode] or 3) do pcall(remote.FireServer, remote, Vector3.new(0.01, -500, 0.01), 1, true) end
            if Aim.part and Aim.part.Parent and (Aim.part.Position - hrp.Position).Magnitude <= 80 then
                FruitM1.combo = FruitM1.combo % 5 + 1
                pcall(remote.FireServer, remote, (Aim.part.Position - hrp.Position).Unit, FruitM1.combo)
            end
        end
        return
    end
    do
        local rf, re = tool:FindFirstChild("RemoteFunction"), tool:FindFirstChild("RemoteEvent")
        if rf and not remote and Aim.part and Aim.part.Parent then
            if re then pcall(re.FireServer, re, Aim.part.Position) end
            pcall(rf.InvokeServer, rf, "TAP")
        end
    end
    for _ = 1, (FruitM1.burst[Config.AttackMode] or 3) do pcall(function() tool:Activate() end) end
    if remote then pcall(remote.FireServer, remote, Vector3.new(0.01, -500, 0.01), 1, true) end
end

-- Thread de ataque: só clica quando alguma rotina marcou "AttackUntil".
-- Cada passo roda dentro de pcall: um erro isolado NÃO mata mais a thread (era o que fazia o ataque parar).
local lastPoint, lastEquip = 0, 0
local function attackTick()
    -- State.Busy pisca em false enquanto o loop principal espera um remote; o Modo só vira "Parado" no fim do ciclo
    if not ((State.Busy or State.Mode ~= "Idle") and os.clock() < Config.AttackUntil) then
        Aim.on = false
        return 0.03
    end
    local sc = Config.SeaClick
    if sc and os.clock() < sc.untilT and sc.part and sc.part.Parent then
        Aim.on = false
        if os.clock() - lastEquip > 0.3 then lastEquip = os.clock(); pcall(equipWeapon) end
        if sc.kind == "fruit" then pcall(FruitM1.tick) else pcall(Config.ShotFire, sc) end
        return 0.05
    end
    if Config.MastTick and Config.MastTick() then return 0.05 end
    local cam = workspace.CurrentCamera
    -- garante que a arma continua equipada (se ela sair da mão, nenhum método bate)
    if os.clock() - lastEquip > 0.3 then
        lastEquip = os.clock()
        pcall(equipWeapon)
    end
    local method = currentMethod()
    local gunLike = (Config.Weapon == "Gun")
    local synthetic = (method == "Mouse" or method == "Touch")
    -- a câmera só é controlada com Gun/fruta; com Melee/Sword ela fica livre
    local fruitM1 = (Config.Weapon == "Blox Fruit")
    Aim.on = ((gunLike or os.clock() < Config.SeaUntil) and (synthetic or method == "Tool")) or fruitM1
    if cam and os.clock() - lastPoint > 0.3 then
        lastPoint = os.clock()
        if synthetic then
            Aim.px, Aim.py = safePoint(cam.ViewportSize)
        else
            Aim.px, Aim.py = cursorPoint(cam.ViewportSize)
        end
    end
    State.atkAt = os.clock()
    -- v28: Melee/Sword no Auto — o Net roda A CADA passo (sem esperar o ritmo do M1 do jogo, que era o delay do clique)
    -- e o M1 do jogo vai em paralelo, limitado a 20 golpes/s.
    local netAssist = Config.AttackMethod == "Auto" and (Config.Weapon == "Melee" or Config.Weapon == "Sword" or Config.MastName ~= nil)
        and method ~= "Net" and os.clock() >= Config.SeaUntil and doNetAttack and not Watch.skip["Net"]
    if netAssist then
        if os.clock() - (State.baseAt or 0) > 0 then
            State.baseAt = os.clock()
            doAttack(method)
        end
        doAttack("Net")
    else
        doAttack(method)
    end
    -- reforço: se o Net está sem causar dano há mais de 1,2s, o M1 do jogo também é acionado
    if method == "Net" and (Watch.noDmgFor or 0) > 1.2 then doAttack("Tool") end
    -- M1 de fruta: além do Net, aciona o Tool a cada passo (é o que dispara a habilidade básica da fruta)
    if Config.Weapon == "Blox Fruit" then
        FruitM1.tick() -- LeftClickRemote em rajadas de 3 (código do fruit.lua) + suporte Control/Magnet/Pain/Chop
        if not Watch.skip["VirtualUser"] then doAttack("VirtualUser") end
    end
    if method == "Net" or netAssist then
        -- o ritmo vem dos slots; Fast/Super não esperam nada (1 frame)
        return (Config.AttackMode == "Super Fast Attack") and 0 or 0
    end
    local cps = AttackCPS[Config.AttackMode] or 3
    if Config.Weapon == "Blox Fruit" then cps = cps * 2 end
    if Config.Weapon == "Gun" then cps = math.min(cps, 8) end -- arma de fogo tem delay de tiro
    return (1 / cps) * (0.85 + math.random() * 0.3)
end

task.spawn(function()
    while Alive do
        local ok, w = pcall(attackTick)
        task.wait(ok and w or 0.1)
    end
end)

