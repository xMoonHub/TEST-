        if canFile() then writefile("MoonHub_gacha.txt", tostring(Gacha.nextAt)) end
    end)
end

local function describe(v)
    if type(v) == "table" then
        local parts, n = {}, 0
        for k, x in pairs(v) do
            n += 1
            if n > 5 then break end
            parts[#parts + 1] = tostring(k) .. "=" .. tostring(x)
        end
        return "{" .. table.concat(parts, ", ") .. "}"
    end
    return tostring(v)
end

local function npcPart(m)
    return m:FindFirstChild("HumanoidRootPart") or m.PrimaryPart or m:FindFirstChildWhichIsA("BasePart")
end

-- Nomes de NPCs por perto (ajuda a achar o NPC certo se o gacha mudar de nome)
local function nearbyNpcNames()
    local names, seen = {}, {}
    local _, hrp = getChar()
    local npcs = workspace:FindFirstChild("NPCs")
    if npcs and hrp then
        for _, m in ipairs(npcs:GetChildren()) do
            local part = npcPart(m)
            if part and not seen[m.Name] and (part.Position - hrp.Position).Magnitude < 400 then
                seen[m.Name] = true
                names[#names + 1] = m.Name
                if #names >= 8 then break end
            end
        end
    end
    return #names > 0 and table.concat(names, ", ") or "none"
end

local ZiolesCache, ZiolesLast = nil, 0
local function findGachaNpc()
    local _, hrp = getChar()
    -- NPC "Zioles": primeiro em workspace.NPCs, depois uma busca geral (no máx. a cada 5s)
    if ZiolesCache and ZiolesCache.Parent then return ZiolesCache end
    local z = workspace:FindFirstChild("NPCs") and workspace.NPCs:FindFirstChild("Zioles")
    if not z and os.clock() - ZiolesLast > 5 then
        ZiolesLast = os.clock()
        z = workspace:FindFirstChild("Zioles", true)
    end
    if z and z:IsA("Model") and npcPart(z) then
        ZiolesCache = z
        return z
    end
    local npcs = workspace:FindFirstChild("NPCs")
    if not npcs then return end
    local best, bestD = nil, math.huge
    for _, m in ipairs(npcs:GetChildren()) do
        local n = string.lower(m.Name)
        if string.find(n, "cousin", 1, true) or string.find(n, "gacha", 1, true) or string.find(n, "zioles", 1, true) then
            local part = npcPart(m)
            if part then
                local d = hrp and (hrp.Position - part.Position).Magnitude or 0
                if d < bestD then best, bestD = m, d end
            end
        end
    end
    return best
end

-- Chama o remote e confere se veio fruta (ou se a resposta parece o tempo restante do cooldown)
-- Quantas frutas estão GUARDADAS no inventário (o gacha pode mandar a fruta direto para lá)
local function invFruitCount()
    local ok, inv = invoke("getInventoryFruits")
    if ok and type(inv) == "table" then
        local n = 0
        for _ in pairs(inv) do n += 1 end
        return n
    end
end

-- Recebeu fruta? (mochila OU inventário)
local function gotFruit(beforeBag, beforeInv)
    if countFruits() > beforeBag then return true end
    local now = invFruitCount()
    return beforeInv ~= nil and now ~= nil and now > beforeInv
end

local function tryRoll()
    local before, beforeInv = countFruits(), invFruitCount()
    Gacha.rollClock = os.clock()
    local ok, r
    local net = ReplicatedStorage:FindFirstChild("Modules") and ReplicatedStorage.Modules:FindFirstChild("Net")
    local rf = net and net:FindFirstChild("RF/GachaNetworkRF")
    if rf then
        ok, r = pcall(function()
            return rf:InvokeServer({ Context = "Purchase", BoxName = "ZiolesGacha" })
        end)
    else
        ok, r = invoke("Cousin", "Buy") -- plano B (remote antigo)
    end
    Gacha.tries += 1
    Gacha.last = (ok and "reply: " or "error: ") .. describe(r)
    task.wait(1.5)
    if gotFruit(before, beforeInv) then return true, "fruit received" end
    if ok and type(r) == "string" then
        local l = string.lower(r)
        if string.find(l, "cooldown", 1, true) or string.find(l, "wait", 1, true)
            or string.find(l, "hour", 1, true) or string.find(l, "minute", 1, true) then
            return true, "on cooldown (game text)", 1800
        end
    end
    if ok and type(r) == "number" and r >= 30 and r <= 7200 then
        return true, "on cooldown", math.floor(r)
    end
    if ok and type(r) == "table" then
        if r.Success == true or r.success == true then return true, "gacha accepted" end
        for k, v in pairs(r) do
            local key = string.lower(tostring(k))
            if type(v) == "number" and v >= 30 and v <= 7200
                and (string.find(key, "cool", 1, true) or string.find(key, "remain", 1, true) or string.find(key, "time", 1, true)) then
                return true, "on cooldown (" .. tostring(k) .. ")", math.floor(v)
            end
        end
    end
    return false
end

-- Plano B: ProximityPrompt do NPC e botão de girar dentro de uma janela de gacha
local function pressGachaUi(npc)
    pcall(function()
        for _, d in ipairs(npc:GetDescendants()) do
            if d:IsA("ProximityPrompt") then
                fireproximityprompt(d)
                break
            elseif d:IsA("ClickDetector") and fireclickdetector then
                fireclickdetector(d)
            end
        end
    end)
    task.wait(1.2)
    pcall(function()
        local pg = Player:FindFirstChild("PlayerGui")
        if not pg or not firesignal then return end
        for _, b in ipairs(pg:GetDescendants()) do
            if (b:IsA("TextButton") or b:IsA("ImageButton")) and b.Visible then
                local inGacha, a = false, b.Parent
                while a and a ~= pg do
                    local n = string.lower(a.Name)
                    if string.find(n, "gacha", 1, true) or string.find(n, "cousin", 1, true) then
                        inGacha = true
                        break
                    end
                    a = a.Parent
                end
                if inGacha then
                    local label = string.lower(b.Name .. " " .. (b:IsA("TextButton") and b.Text or ""))
                    if string.find(label, "roll", 1, true) or string.find(label, "spin", 1, true)
                        or string.find(label, "buy", 1, true) or string.find(label, "open", 1, true)
                        or string.find(label, "girar", 1, true) then
                        firesignal(b.MouseButton1Click)
                        Gacha.last = "clicked: " .. b:GetFullName()
                        return
                    end
                end
            end
        end
    end)
end

-- Retorna true enquanto estiver usando o personagem (voando até o NPC)
local function gachaMission()
    local now = os.time()
    if now < Gacha.nextAt or now < Gacha.pauseUntil then return false end
    if getPlayerLevel() < 50 then
        Diag.gacha = "minimum level 50 for the gacha"
        return false
    end

    -- 1) tentativa direta, de onde estiver
    if Gacha.phase == "idle" then
        local done, why, secs = tryRoll()
        if done then
            Gacha.nextAt = os.time() + (secs or 7200)
            Gacha.tries = 0
            saveGacha()
            Diag.gacha = "ok (" .. why .. ") | " .. Gacha.last
            return false
        end
        Gacha.phase, Gacha.travelSince = "travel", os.clock()
    end

    -- 2) vai até o NPC (no máximo 40s de viagem)
    local npc = findGachaNpc()
    local part = npc and npcPart(npc)
    if part and distanceTo(part.CFrame) > 10 and os.clock() - Gacha.travelSince < 40 then
        State.Mode, State.Text = "Auto Random Fruit", "Going to Zioles"
        flyTo(part.CFrame * CFrame.new(0, 4, 5))
        return true
    elseif not part and getSea() == 1 and os.clock() - Gacha.travelSince < 40 then
        -- Zioles ainda não carregou (o jogo só carrega NPCs perto): vai para Middle Town (posição aproximada)
        State.Mode, State.Text = "Auto Random Fruit", "Going to Middle Town (looking for Zioles)"
        flyTo(CFrame.new(-655, 12, 1573))
        return true
    end

    -- 3) chegou (ou o NPC não foi achado): remote de novo, depois prompt/botão
    State.Mode, State.Text = "Auto Random Fruit", "Spinning"
    local done, why, secs = tryRoll()
    if not done and npc then
        local before, beforeInv = countFruits(), invFruitCount()
        pressGachaUi(npc)
        task.wait(2)
        if gotFruit(before, beforeInv) then done, why = true, "fruit received (NPC/window)" end
    end
    Gacha.phase = "idle"
    if done then
        Gacha.nextAt = os.time() + (secs or 7200)
        Gacha.tries = 0
        saveGacha()
        Diag.gacha = "ok (" .. why .. ") | " .. Gacha.last
        return false
    end
    Gacha.pauseUntil = os.time() + ((Gacha.tries < 3) and 120 or 900)
    Diag.gacha = string.format("failed (%d attempts) | %s | NPC: %s | NPCs nearby: %s",
        Gacha.tries, Gacha.last, npc and npc.Name or "not found", nearbyNpcNames())
    return false
end

