    local function scanPrompts(center, want)
        local out = {}
        local map = workspace:FindFirstChild("Map") or workspace
        for _, o in ipairs(map:GetDescendants()) do
            if o:IsA("ProximityPrompt") and o.Enabled then
                local txt = string.lower((o.ActionText or "") .. " " .. (o.ObjectText or ""))
                for _, w in ipairs(want) do
                    if string.find(txt, w, 1, true) then
                        local par = o.Parent
                        local pos = par and (par:IsA("BasePart") and par.Position or (par:IsA("Attachment") and par.WorldPosition))
                        if pos and (pos - center).Magnitude < 160 then out[#out + 1] = { o, pos } end
                        break
