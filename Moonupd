    -- v30: while paying, R.hold blocks Auto Store and weapon re-equip, so nothing takes the fruit out of the hand.
    -- Returns true (got the chip), false (cannot pay now), nil (still working: traveling / loading a fruit)
    local function setHold(v) R.hold = v; Config.PayHoldUntil = v end
    local function holdFruit(tool)
