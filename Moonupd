-- ============ INIMIGOS ============
local function enemiesList()
    local f = workspace:FindFirstChild("Enemies")
    return f and f:GetChildren() or {}
end

-- Nome do mob bate se for igual OU começar com o nome (ex.: "Bandit [Lv. 5]")
local function matchName(enemyName, names)
    for _, n in ipairs(names) do
        if enemyName == n or string.sub(enemyName, 1, #n) == n then return true end
    end
    return false
end

local function aliveParts(e)
    local eh, er = e:FindFirstChildOfClass("Humanoid"), e:FindFirstChild("HumanoidRootPart")
    if eh and er and eh.Health > 0 then return eh, er end
end

local Fight = { active = false, expires = 0, standCF = nil, pullCF = nil, mobs = {}, inPos = false, pos = nil, enemy = nil }

local function findEnemy(names)
    local _, hrp = getChar()
    if not hrp then return end
    -- 1) grupo já puxado: continua nele (não sai voando para outros mobs)
    if Fight.group and os.clock() < (Fight.groupUntil or 0) then
        local gb, gd = nil, math.huge
        for _, e in ipairs(Fight.group) do
            local eh, er = aliveParts(e)
            if eh and e.Parent and matchName(e.Name, names) then
                local d = (hrp.Position - er.Position).Magnitude
                if d < gd then gb, gd = e, d end
            end
        end
        if gb then return gb end
    end
    local best, bestDist = nil, math.huge
    for _, e in ipairs(enemiesList()) do
        local eh, er = aliveParts(e)
        if eh and matchName(e.Name, names) then
            local d = (hrp.Position - er.Position).Magnitude
            if d < bestDist then best, bestDist = e, d end
        end
    end
    return best
end

local function countAlive(names)
    local n = 0
    for _, e in ipairs(enemiesList()) do
        if aliveParts(e) and matchName(e.Name, names) then n += 1 end
    end
    return n
end

-- ============ LOTES DE 2 MOBS ============
-- Mesmo com Bring alto (ex.: 4 mobs juntos), só 2 mobs por vez são atacados; a cada ~1,5s (ou quando
-- o par morre) passa para os 2 seguintes. Isso reduz o risco de ban.
local Batch = { pair = {}, idx = 1, switchAt = 0, expires = 0 }
function Batch.update(group)
    local alive = {}
    for _, m in ipairs(group) do
        if aliveParts(m) then alive[#alive + 1] = m end
    end
    local chunks = math.max(1, math.ceil(#alive / 2))
    local now = os.clock()
    if now >= Batch.switchAt then
        Batch.idx = Batch.idx % chunks + 1
        Batch.switchAt = now + 1.5
    end
    if Batch.idx > chunks then Batch.idx = 1 end
    Batch.pair = { alive[Batch.idx * 2 - 1], alive[Batch.idx * 2] }
    Batch.expires = now + 0.5
end

-- ============ NET (seu attack.lua, usado no método "Net") ============
-- Mesma lógica do script enviado: RegisterAttack + RegisterHit + remote de validação.
-- Diferenças: (1) só dispara quando o hub está atacando; (2) bate SOMENTE em workspace.Enemies
-- (a pasta Characters, onde ficam os outros jogadores, foi removida); (3) as esperas têm timeout,
-- para o script não travar se alguma pasta/remote não existir.
-- Normal Attack = 1 ataque por vez (como o seu loop). Fast = 5 simultâneos, Super Fast = 8, sem esperar nada; o FREIO AUTOMÁTICO (pelo FPS) reduz sozinho se o jogo começar a engasgar.
local NetAtk = { ready = false, inflight = 0, lastDone = 0, err = "starting...", remote = nil, id = nil,
    netModule = nil, seed = nil, reg = nil, hit = nil, cloneref = nil }
-- Limites anti-crash: poucos alvos por ciclo, poucos ciclos simultâneos e intervalo mínimo entre ciclos
local NET_LIMIT = { ["Normal Attack"] = 3, ["Fast Attack"] = 14, ["Super Fast Attack"] = 80 }
local NET_GAP   = { ["Normal Attack"] = 0.06, ["Fast Attack"] = 0.012, ["Super Fast Attack"] = 0 } -- Super: sem intervalo (1 lote por frame)
local NET_MAX_TARGETS = 10 -- v28: bate em TODOS os mobs puxados (limite real = slider Bring Mob)
local netLastLaunch = 0

-- Freio anti-crash: mede o tempo dos frames. Se o jogo engasgar (frame > ~45ms em média), o ataque cai
-- para 1 ciclo por vez e só volta ao normal quando o FPS se recuperar.
local Perf = { ema = 0.016, slow = false }
table.insert(Connections, RunService.Heartbeat:Connect(function(dt)
    Perf.ema = Perf.ema * 0.9 + math.min(dt, 0.5) * 0.1
    if Perf.ema > 0.045 then Perf.slow = true elseif Perf.ema < 0.03 then Perf.slow = false end
end))

task.spawn(function()
    NetAtk.cloneref = cloneref or function(x) return x end
    local folders = {}
    for _, name in ipairs({ "Util", "Common", "Remotes", "Assets", "FX" }) do
        local f = ReplicatedStorage:WaitForChild(name, 40)
        if f then folders[#folders + 1] = f end
    end
    local function check(obj)
        if obj:IsA("RemoteEvent") and obj:GetAttribute("Id") then
            NetAtk.remote, NetAtk.id = obj, obj:GetAttribute("Id")
        end
    end
    for _, folder in ipairs(folders) do
        for _, child in ipairs(folder:GetChildren()) do check(child) end
        table.insert(Connections, folder.ChildAdded:Connect(check))
    end
    local ok, err = pcall(function()
        local modules = ReplicatedStorage:WaitForChild("Modules", 40)
        local netFolder = modules and modules:WaitForChild("Net", 40)
        assert(netFolder, "ReplicatedStorage.Modules.Net not found")
        NetAtk.netModule = require(netFolder)
        NetAtk.seed = netFolder:WaitForChild("seed", 40)
        NetAtk.reg = netFolder:WaitForChild("RE/RegisterAttack", 40)
        NetAtk.hit = netFolder:WaitForChild("RE/RegisterHit", 40)
        assert(NetAtk.seed and NetAtk.reg and NetAtk.hit, "attack remotes not found")
    end)
    NetAtk.ready = ok
    NetAtk.lastDone = os.clock()
    NetAtk.err = ok and "ok" or tostring(err)
    if not ok then Watch.skip["Net"] = true end -- sem os remotes: sai do ciclo automático
end)

-- Um ciclo do seu loop
local function netAttackOnce()
    local char = Player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local tool = char:FindFirstChildOfClass("Tool")
    if not tool then return end
    local stunV = char:FindFirstChild("Stun")
    if stunV and stunV.Value ~= 0 then return end
    local weaponType = tool:GetAttribute("WeaponType") or tool.ToolTip
    -- Melee e Sword sempre; fruta só quando "Blox Fruit (M1)" estiver selecionado
    if weaponType ~= "Melee" and weaponType ~= "Sword"
        and not (Config.Weapon == "Blox Fruit" and weaponType == "Blox Fruit") then return end

    -- alvos: só inimigos (NPCs) a até 60 studs
    local targets = {}
    local function gather(source)
        for _, enemy in ipairs(source) do
            local eh, er = aliveParts(enemy)
            if eh and not (Config.MastSkip and Config.MastSkip(eh)) and (er.Position - root.Position).Magnitude <= 60 then
                targets[#targets + 1] = { enemy, er } -- 1 parte por mob (mandar todas as partes travava o jogo)
                if #targets >= math.min(NET_MAX_TARGETS, math.max(2, (Fight.bringMax and os.clock() < (Fight.bringUntil or 0) and Fight.bringMax) or Config.Bring or 2)) then break end
            end
        end
    end
    gather(Fight.mobs) -- v28: todos os mobs puxados de uma vez (antes: só 2 por vez, revezando)
    if #targets == 0 and os.clock() < Batch.expires then gather(Batch.pair) end
    if #targets == 0 and not Fight.active and not (Fight.names and os.clock() < (Fight.namesUntil or 0)) then gather(enemiesList()) end
    if #targets == 0 and Aim.part and Aim.part.Parent then
        local am = Aim.part:FindFirstAncestorOfClass("Model")
        local eh, er = am and aliveParts(am)
        if eh and (er.Position - root.Position).Magnitude <= 80 then targets[1] = { am, er } end
    end
    if #targets == 0 then return end

    -- registra o RegisterHit no máximo 1x por segundo (repetir isso a cada ciclo acumulava conexões)
    if os.clock() - (NetAtk.regAt or 0) > 1 then
        NetAtk.regAt = os.clock()
        NetAtk.netModule:RemoteEvent("RegisterHit", true)
    end
    local rep = ({ ["Fast Attack"] = 2, ["Super Fast Attack"] = 6 })[Config.AttackMode] or 1
    for _ = 1, rep do NetAtk.reg:FireServer(0) end

    local head = targets[1][1]:FindFirstChild("Head")
    if head and NetAtk.remote and NetAtk.id then
        local uidStr = tostring(Player.UserId):sub(2, 4)
        local coStr = tostring(coroutine.running()):sub(11, 15)
        for _ = 1, rep do NetAtk.hit:FireServer(head, targets, {}, uidStr .. coStr) end

        local remoteName = string.gsub("RE/RegisterHit", ".", function(c)
            return string.char(bit32.bxor(string.byte(c), math.floor((workspace:GetServerTimeNow() / 10) % 10) + 1))
        end)
        local seedValue = NetAtk.seed:InvokeServer() * 2
        local xorValue = bit32.bxor(NetAtk.id + 909090, seedValue)
        NetAtk.cloneref(NetAtk.remote):FireServer(remoteName, xorValue, head, targets)
    end
end

-- Mantém no máximo N ciclos em andamento (N depende do modo de ataque escolhido).
-- Cada ciclo ocupa um "slot" que EXPIRA em 1,2s: se o servidor demorar a responder, o slot é liberado
-- e o ataque continua (antes ele parava por até 5s quando um ciclo ficava preso).
NetAtk.slots, NetAtk.seq = {}, 0
local function netInflight()
    local now, n = os.clock(), 0
    for id, t in pairs(NetAtk.slots) do
        if now - t > 0.5 then NetAtk.slots[id] = nil else n += 1 end
    end
    return n
end

doNetAttack = function()
    if not NetAtk.ready then return false end
    local limit = NET_LIMIT[Config.AttackMode] or 1
    local gap = NET_GAP[Config.AttackMode] or 0.1
    -- M1 de fruta: bem mais ciclos simultâneos e sem intervalo (Fast = 8, Super Fast = 13)
    if Config.Weapon == "Blox Fruit" then
        if Config.AttackMode == "Super Fast Attack" then
            limit, gap = math.ceil(limit * 1.8), 0
        else
            limit, gap = math.ceil(limit * 2), gap * 0.5
        end
    end
    -- freio gradual pelo tempo de frame: o jogo engasgando é o que causa o crash
    if Perf.ema > 0.09 then
        limit, gap = 2, math.max(gap, 0.05)
    elseif Perf.ema > 0.06 then
        limit = math.max(2, math.ceil(limit / 2))
        gap = math.max(gap, 0.01)
    end
    local now = os.clock()
    if now - netLastLaunch < gap then return true end
    local free = limit - netInflight()
    for _ = 1, math.max(0, free) do
        netLastLaunch = os.clock()
        NetAtk.seq += 1
        local id = NetAtk.seq
        NetAtk.slots[id] = netLastLaunch
        task.spawn(function()
            pcall(netAttackOnce)
            NetAtk.slots[id] = nil
            NetAtk.lastDone = os.clock()
        end)
    end
    return true
end

-- v29: Melee/Sword no Auto/Net: o Net também dispara a cada Heartbeat e a cada Stepped (3 motores: loop + 2 sinais),
-- então o ritmo não depende mais só do loop de ataque. Os slots/limite/freio de FPS continuam valendo.
for _, sig in ipairs({ RunService.Heartbeat, RunService.Stepped }) do
    table.insert(Connections, sig:Connect(function()
        if not Alive or not NetAtk.ready or Watch.skip["Net"] or not doNetAttack then return end
        if not ((State.Busy or State.Mode ~= "Idle") and os.clock() < Config.AttackUntil) then return end
        local sc = Config.SeaClick
        if os.clock() < Config.SeaUntil or (sc and os.clock() < (sc.untilT or 0)) then return end
        if Config.Weapon ~= "Melee" and Config.Weapon ~= "Sword" then return end
        local m = Config.AttackMethod
        if m ~= "Auto" and m ~= "Net" then return end
        pcall(doNetAttack)
    end))
end

-- ============ LUTA (posição, puxar mobs, medir dano) ============

-- Altura efetiva: a escolhida nas Settings; desce sozinha se o ataque não causar dano
local PULL_GAP = 3 -- distância vertical menor para manter o M1 de Melee no alcance (cabe 1 jogador no meio)
-- Auto-ajuste de distância: se NENHUM método causa dano, desce o jogador e aproxima os mobs puxados.
-- (antes a altura só caía de 15 para 14 e o ponto de luta ficava congelado por grupo: o jogador ficava
-- 9 studs acima dos mobs para sempre, fora do alcance do golpe corpo a corpo = "só puxa e não mata")
--   estágio 0: altura escolhida, mobs 9 abaixo | 1: altura 10, mobs 5 abaixo | 2: altura 7, mobs 3 abaixo
local function effHover(canPull)
    local h = Config.HoverHeight
    -- v18: a altura escolhida nas Settings nunca desce sozinha (só a distância do mob se ajusta)
    if not canPull then h = math.min(h, 15) end -- boss: sempre perto
    return h
end
local function pullGap()
    local g = Config.PullGap or PULL_GAP
    if Config.FixedDistance then return g end
    return math.min(g, Watch.gapNow or g) -- calibrado: o maior valor com que o golpe ainda acerta
end

-- Mede se o alvo está perdendo vida; se não estiver (por 3s, já em posição), troca de método
-- v19: reinicia o estado do ataque (equipa de novo, relê o controlador, libera métodos descartados)
Watch.resets = 0
Watch.reset = function()
    Watch.wdAt = os.clock()
    Watch.resets += 1
    Watch.skip = {}
    CFW.tried = false -- relê o controlador de combate
    pcall(function()
        local ctrl = CFW.ctrl and CFW.ctrl.activeController
        if ctrl then
            ctrl.attacking, ctrl.blocking, ctrl.timeToNextAttack = false, false, 0
        end
    end)
    local _, _, hum = getChar()
    if hum then
        pcall(function() hum:UnequipTools() end)
        task.delay(0.2, function() pcall(equipWeapon) end)
    end
    if Config.AttackMethod == "Auto" then Watch.mi = Watch.mi % #METHODS + 1 end
end

local function watchStep(enemy, eh)
    local now = os.clock()
    Watch.lastHit = Watch.lastHit or now
    if Watch.enemy ~= enemy then
        local pe = Watch.enemy
        if pe and not aliveParts(pe) then -- o alvo anterior morreu: o golpe funcionou (mob morrendo de um golpe só)
            Watch.lastHit, Watch.confirmed = now, true
            if Config.AttackMethod == "Auto" then Watch.good = Watch.mi end
        end
        Watch.enemy, Watch.hp, Watch.lastDmg = enemy, eh.Health, now
    else
        if eh.Health < Watch.hp - 0.01 then
            Watch.lastDmg, Watch.lastHit, Watch.confirmed = now, now, true
            if Config.AttackMethod == "Auto" then Watch.good = Watch.mi end -- método que funcionou
        end
        Watch.hp = eh.Health
    end
    if not Fight.inPos then
        Watch.lastDmg = now -- ainda voando: não conta
        Watch.lastHit = now
        Watch.noDmgFor = 0
        return
    end
    Watch.noDmgFor = now - Watch.lastDmg
    -- v18: sem acertar há 3s => aproxima o mob 2 studs (mínimo 3); a altura do jogador não muda
    if not Config.FixedDistance and now - Watch.lastHit > 3 and now - (Watch.calAt or 0) > 3 then
        Watch.calAt = now
        local base = Config.PullGap or PULL_GAP
        local cur = math.min(base, Watch.gapNow or base)
        if cur > 3 then
            Watch.gapNow = math.max(3, cur - 2)
            Fight.fixStand, Fight.fixPull = nil, nil
        end
    end
    -- v19: watchdog — 6s dentro da posição sem acertar nada: reinicia o ataque (o Melee travava depois de um tempo)
    if now - Watch.lastHit > 8 and now - (Watch.wdAt or 0) > 8 then
        Watch.reset()
    end
    if Config.AttackMethod ~= "Auto" then return end
    -- tentando um método alternativo: dá só 1,2s; se também não causar dano, volta ao que já funcionou
    local limit = (Watch.good and Watch.mi ~= Watch.good) and 0.45 or 0.7
    if now - Watch.lastDmg > limit then
        Watch.confirmed = false
        Watch.lastDmg = now
        if Watch.good and Watch.mi ~= Watch.good and not Watch.skip[METHODS[Watch.good]] then
            Watch.mi = Watch.good
            return
        end
        for _ = 1, #METHODS do
            Watch.mi = Watch.mi % #METHODS + 1
            if Watch.mi == 1 then Watch.stage = (Watch.stage + 1) % 3 end
            if not Watch.skip[METHODS[Watch.mi]] then break end
        end
    end
end

-- Posição original (no chão) de cada mob, guardada ANTES de ele ser puxado.
-- Sem isto, o próximo alvo era um mob já puxado (no alto) e a altura era somada de novo a cada troca de
-- alvo: o jogador e os mobs subiam sem parar.
local Orig = setmetatable({}, { __mode = "k" })

-- Mobs do mesmo tipo para puxar junto (total = Config.Bring, contando o alvo)
local function collectBring(main, names, center)
    local list = { main }
    for _, e in ipairs(enemiesList()) do
        local ov = Fight.bringMax and os.clock() < (Fight.bringUntil or 0)
        if #list >= (ov and Fight.bringMax or Config.Bring) then break end
        if e ~= main and (matchName(e.Name, names) or (Config.KillAll and not matchName(e.Name, Config.KillAllSkip or {}))) then
            local eh, er = aliveParts(e)
            if eh and (er.Position - center).Magnitude < (ov and (Fight.bringRange or 350) or 350) then
                Orig[e] = Orig[e] or er.Position
                list[#list + 1] = e
            end
        end
    end
    return list
end

-- Posiciona o jogador no alto e puxa o mob para 3 studs ABAIXO dele (o golpe alcança de cima).
-- A posição é reaplicada a cada frame (Heartbeat) para o mob não voltar ao chão entre um ciclo e outro.
local GUN_DIST = 9 -- Gun: o mob fica 9 studs à frente, na MESMA altura (câmera reta)
local function fightEnemy(enemy, names, canPull)
    local eh, er = aliveParts(enemy)
    if not eh then return end
    equipWeapon()
    local gun = (Config.Weapon == "Gun")
    Aim.level = gun
    if not canPull then State.bossAt = os.clock() end -- lutando contra boss: o Collect Fruit espera

    Orig[enemy] = Orig[enemy] or er.Position
    Fight.enemy = enemy
    Fight.names, Fight.namesUntil = names, os.clock() + 4
    -- âncora estável: enquanto o grupo puxado estiver vivo, o jogador NÃO muda de lugar
    local inGroup = false
    if Fight.group and os.clock() < (Fight.groupUntil or 0) and Fight.anchor then
        for _, g in ipairs(Fight.group) do if g == enemy then inGroup = true break end end
    end
    if not inGroup then Fight.anchor = Orig[enemy] end
    Fight.pos = Fight.anchor
    local base = canPull and Fight.pos or er.Position
    local h = effHover(canPull)
    local stand, pullCF
    if gun then
        if canPull then
            local p = base + Vector3.new(0, h, 0)
            stand = CFrame.lookAt(p, p + Vector3.new(0, 0, 1))
            pullCF = CFrame.new(p + Vector3.new(0, 0, GUN_DIST))
        else
            local p = er.Position + Vector3.new(0, 4, -14)
            stand = CFrame.lookAt(p, Vector3.new(er.Position.X, p.Y, er.Position.Z))
        end
    else
        stand = CFrame.new(base + Vector3.new(0, h, 0)) * CFrame.Angles(math.rad(-90), 0, 0)
        if canPull then pullCF = CFrame.new(base) end -- mobs puxados ficam no chão, parados, a ~20 studs do jogador
    end
    -- ponto FIXO: calculado uma vez por grupo; o NPC não sobe e o jogador fica batendo nele
    -- (recalcula também quando o estágio de auto-ajuste muda, senão a nova distância nunca era aplicada)
    if canPull and inGroup and Fight.fixStand and Fight.fixPull and Fight.fixStage == Watch.stage then
        stand, pullCF = Fight.fixStand, Fight.fixPull
    else
        Fight.fixStand, Fight.fixPull, Fight.fixStage = stand, pullCF, Watch.stage
    end
    Fight.standCF, Fight.pullCF = stand, pullCF
    if inGroup then
        local keep = {}
        for _, g in ipairs(Fight.group) do
            if aliveParts(g) then keep[#keep + 1] = g end
        end
        Fight.mobs = keep
        if Fight.bringMax and os.clock() < (Fight.bringUntil or 0) and #keep < Fight.bringMax then
            local seen = {}
            for _, g in ipairs(keep) do seen[g] = true end
            for _, g in ipairs(collectBring(enemy, names, base)) do
                if not seen[g] and #Fight.mobs < Fight.bringMax then Fight.mobs[#Fight.mobs + 1] = g end
            end
        end
    else
        Fight.mobs = canPull and collectBring(enemy, names, base) or {}
    end
    Fight.group = canPull and Fight.mobs or nil
    Fight.groupUntil = os.clock() + 2
    Fight.active, Fight.expires = true, os.clock() + 1.0

    -- ataca só 2 mobs por vez (revezando entre os puxados)
    Batch.update(#Fight.mobs > 0 and Fight.mobs or { enemy })
    local _, tr = aliveParts(Batch.pair[1] or enemy)
    Aim.part = tr or er

    local near = false
    local _, hrp = getChar()
    if hrp then
        Fight.inPos = (hrp.Position - stand.Position).Magnitude < 8
        near = (hrp.Position - er.Position).Magnitude < 58
        if Fight.inPos then
            if currentTween then currentTween:Cancel() end
        else
            flyTo(stand)
        end
    end

    watchStep(enemy, eh)
    if Fight.inPos or near then Config.AttackUntil = os.clock() + 1.5 end -- liga o ataque automático
    Diag.attack = string.format("method=%s%s | height=%s | mob distance=%s%s | damage confirmed=%s | net=%s | cf=%s",
        currentMethod(), (Config.AttackMethod == "Auto") and " (auto)" or "",
        tostring(math.floor(h)), tostring(math.floor(pullGap())), Config.FixedDistance and " (fixed)" or "",
        Watch.confirmed and "yes" or "not yet", NetAtk.ready and "ready" or tostring(NetAtk.err),
        CFW.ctrl and (CFW.ctrl.activeController and "ok" or "no activeController") or (CFW.tried and "did not load" or "not tested"))
    Diag.attack = Diag.attack .. fruitNote() .. " | attack restarts=" .. tostring(Watch.resets)
end

table.insert(Connections, RunService.Heartbeat:Connect(function()
    if not (Alive and Fight.active) then return end
    if os.clock() > Fight.expires then
        Fight.active, Fight.inPos = false, false
        return
    end
    local _, hrp = getChar()
    if not hrp then return end
    -- jogador: já perto do ponto => fica exatamente nele (de frente para baixo)
    if Fight.standCF and (hrp.Position - Fight.standCF.Position).Magnitude < 8 then
        hrp.CFrame = Fight.standCF
        hrp.AssemblyLinearVelocity = Vector3.zero
    end
    -- mobs: mantém todos no ponto puxado
    if Fight.pullCF then
        for _, m in ipairs(Fight.mobs) do
            local eh, er = aliveParts(m)
            if eh then
                er.CFrame = Fight.pullCF
                er.AssemblyLinearVelocity = Vector3.zero
                er.AssemblyAngularVelocity = Vector3.zero
                er.CanCollide = false
                eh.WalkSpeed = 0
            end
        end
    end
end))

-- Mobs só carregam perto do spawn: acha o ponto de spawn pelo nome
local function findSpawn(names)
    local origin = workspace:FindFirstChild("_WorldOrigin")
    local folders = {}
    local f1 = origin and origin:FindFirstChild("EnemySpawns")
    local f2 = workspace:FindFirstChild("EnemySpawns")
    if f1 then table.insert(folders, f1) end
    if f2 then table.insert(folders, f2) end
    local best, bestDist = nil, math.huge
    for _, folder in ipairs(folders) do
        for _, sp in ipairs(folder:GetChildren()) do
            for _, n in ipairs(names) do
                if string.find(sp.Name, n, 1, true) then
                    local d = distanceTo(sp.CFrame)
                    if d < bestDist then best, bestDist = sp, d end
                end
            end
        end
    end
    return best
end

-- ============ QUESTS (sem prender: tentativas e tempo limitados) ============
local QuestGui
local function findQuestGui()
    if QuestGui and QuestGui.Parent then return QuestGui end
    local pg = Player:FindFirstChild("PlayerGui")
    local main = pg and pg:FindFirstChild("Main")
    if main then QuestGui = main:FindFirstChild("Quest") or main:FindFirstChild("Quest", true) end
    return QuestGui
end

-- Retorna (visível, conseguiu_ler)
local function questVisible()
    local q = findQuestGui()
    if not q then return false, false end
    return q.Visible == true, true
end

local function activeQuestTitle()
    local q = findQuestGui()
    if not q then return nil end
    local t = q:FindFirstChild("QuestTitle", true)
    if not t then return nil end
    local label = t:FindFirstChild("Title") or t
    if label:IsA("TextLabel") then return label.Text end
end

local function isEliteTitle(title)
    if not title then return false end
    for _, n in ipairs(EliteNames) do
        if string.find(title, n, 1, true) then return true end
    end
    return false
end

local Quest = { key = nil, acceptedAt = 0, guiSeen = false, tries = 0, cooldownUntil = 0, travelSince = 0 }
-- Marca quando o personagem renasceu (morte): só nesse caso a quest pode ter sido perdida de verdade.
-- Sem morte, a janela sumir = quest CONCLUÍDA (a última morte do mob some da tela antes de a contagem chegar a x/x).
-- Registro de eventos de quest: aparece como notificação na tela e na linha "quest" do Status
-- (assim dá para ver exatamente quando/por que ele aceitou ou concluiu uma quest)
local function qlog(msg)
    Diag.quest = msg
    pcall(function()
        if Fluent and Fluent.Notify then Fluent:Notify({ Title = "Moon Hub - Quest", Content = msg, Duration = 3 }) end
    end)
end
