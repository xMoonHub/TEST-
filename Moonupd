        gui.Name, gui.ResetOnSpawn, gui.DisplayOrder, gui.IgnoreGuiInset = "MoonHubProHop", false, 1000, true
        local okP = pcall(function()
            gui.Parent = (type(gethui) == "function" and gethui()) or game:GetService("CoreGui")
        end)
