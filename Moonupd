-- Sair da Submerged Island (modos de superfície: Bones / Dough / Elite / Pirate Raid).
-- Antes o farm de Bones ficava PARADO lá dentro: os spawns do Haunted Castle são de outra camada do mapa,
-- então ele não achava onde voar. Voa até a saída e usa o teleporte do Submarine para o Tiki Outpost.
DHF.Exit = CFrame.new(11426, -2155, 9732)
DHF.lastExit = 0
function DHF.leaveSub()
    local _, hrp = getChar()
    if not hrp or hrp.Position.Y > -500 then return false end
    if (hrp.Position - DHF.Exit.Position).Magnitude > 20 then
        State.Text = "Leaving the Submerged Island"
        flyTo(DHF.Exit)
        return true
    end
    State.Text = "Leaving the Submerged Island (teleport)"
    if os.clock() - DHF.lastExit > 3 then
        DHF.lastExit = os.clock()
        local rf = DHF.net("RF/SubmarineTransportation")
        if rf then
            pcall(rf.InvokeServer, rf, "InitiateTeleport", "Tiki Outpost")
            Diag.quest = "leaving the Submerged Island (InitiateTeleport sent)"
        else
            Diag.quest = "remote RF/SubmarineTransportation not found"
        end
    end
    return true
end

function DHF.findSubWorker()
    local npcs = workspace:FindFirstChild("NPCs")
    if not npcs then return end
    local direct = npcs:FindFirstChild("Submarine Worker")
    if direct then return direct end
    for _, n in ipairs(npcs:GetChildren()) do
        if string.find(n.Name, "Submarine", 1, true) then return n end
    end
end

function DHF.goSub()
    if os.clock() - DHF.lastSubTravel < 8 then return end
    DHF.lastSubTravel = os.clock()

    local npc = DHF.findSubWorker()
    local okp, npcPos = false, nil
    if npc then okp, npcPos = pcall(function() return npc:GetPivot().Position end) end
    local pos = (okp and npcPos) or DHF.TikiPos

    DHF.flyWait(CFrame.new(pos + Vector3.new(0, 4, 0)), 120)
    if not Alive or Config.Mode ~= "Level" then return end

    local _, hrp = getChar()
    if not hrp then return end
    local before = hrp.Position
    local function moved()
        local _, h = getChar()
        return h and (h.Position - before).Magnitude > 300
    end

    local attempts = {
        function()
            local rf = DHF.net("RF/SubmarineWorkerSpeak")
            if rf then rf:InvokeServer("TravelToSubmergedIsland") end
        end,
        function() invoke("SubmarineWorkerSpeak", "TravelToSubmergedIsland") end,
        function()
            local prompt = npc and npc:FindFirstChildWhichIsA("ProximityPrompt", true)
            if prompt and fireproximityprompt then fireproximityprompt(prompt) end
        end,
    }
    for _, try in ipairs(attempts) do
        pcall(try)
        for _ = 1, 8 do
            task.wait(0.5)
            if moved() then break end
        end
        if moved() then
            DHF.subFails = 0
            DHF.subUntil = os.clock() + 40
            task.wait(2)
            return
        end
        if not Alive or Config.Mode ~= "Level" then return end
    end

    DHF.subFails += 1
    if DHF.subFails == 2 then
        qlog("Could not travel to the Submerged Island. Talk once to the Submarine Worker by hand and the farm continues.")
    end
end

-- ---------- farm ----------
function DHF.farm(data, area)
    local target = DHF.find(data.Mobs, area)
    if not target and Config.KillAll then
        -- sem mob da quest vivo: bate em qualquer outro NPC perto (da mesma ilha) enquanto espera o respawn
        local _, hrp0 = getChar()
        local center = (area and area.center) or DHF.fightPos or (hrp0 and hrp0.Position)
        local bd = 600
        for _, e in ipairs(enemiesList()) do
            local eh, er = aliveParts(e)
            if eh and center and not matchName(e.Name, Config.KillAllSkip or {}) then
                local d = (er.Position - center).Magnitude
                if d < bd then target, bd = e, d end
            end
        end
        if target then data = setmetatable({ Mobs = { target.Name } }, { __index = data }) end
    end
    if not target then return false end
    local _, er = aliveParts(target)
    fightEnemy(target, data.Mobs, true)
    DHF.fightPos = Fight.anchor or (er and er.Position) or DHF.fightPos
    DHF.fightAt = os.clock()
    DHF.fightKey = table.concat(data.Mobs, "|")
    return true
end

-- Sem mob vivo: espera o respawn onde estava; só depois de 60s procura nos pontos de spawn
function DHF.idle(names, area)
    local key = table.concat(names, "|")
    local here = DHF.inSub()
    if DHF.fightPos and DHF.fightKey == key and os.clock() - DHF.fightAt < 60
        and (DHF.fightPos.Y <= -500) == here then
        flyTo(CFrame.new(DHF.fightPos + Vector3.new(0, 30, 0)))
        return "wait"
    end
    local sp = DHF.huntSpawn(names, area)
    if sp and (sp.Position.Y <= -500) == here then
        flyTo(sp.CFrame * CFrame.new(0, 20, 0))
        return "hunt"
    end
    return "none" -- sem ponto seguro na camada atual: fica parado (nunca sai do mapa)
end

function DHF.step()
    local data = DHF.pick()
    if not data then
        State.Text = "No quest for this level / sea"
        return
    end
    DHF.questMob = data.QuestMob
    DHF.total = DHF.questTotal(data)
    local area = DHF.getArea(data.Mobs)

    -- quest de superfície mas o personagem está dentro da Submerged Island: sai primeiro
    if not data.Submerged and DHF.leaveSub() then return end

    -- mobs da Submerged Island: viaja até lá se eles não estiverem por perto
    if data.Submerged and not DHF.inSub() and os.clock() > DHF.subUntil and not DHF.find(data.Mobs, nil) then
        State.Text = "Going to the Submerged Island"
        DHF.goSub()
        return
    end

    if not DHF.hasQuest() then
        State.Text = "Taking quest " .. data.Label
        DHF.take(data, "no quest")
        return
    end

    if DHF.farm(data, area) then
        State.Text = string.format("Lv.%d: hitting %s (%s)", getPlayerLevel(), data.QuestMob, data.Label)
        Diag.fight = string.format("Level | target mob: %s | alive: %d | quest %s | kills %d/%s",
            data.QuestMob, countAlive(data.Mobs), data.Label, DHF.kills, tostring(DHF.total or "?"))
    else
        local mode = DHF.idle(data.Mobs, area)
        State.Text = "Level | " .. (mode == "wait" and "waiting for the respawn" or mode == "hunt" and "looking for mobs" or "no mobs found")
    end
end

