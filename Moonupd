-- Instinct (Observação): a janela de overlay "ScreenGui.ImageLabel" aparece quando está ativo
local Ken = { last = 0, presses = 0, seen = false }
local function kenActive()
    local ok, v = pcall(function()
        local sg = Player.PlayerGui:FindFirstChild("ScreenGui")
        return sg and sg:FindFirstChild("ImageLabel") ~= nil
    end)
    return ok and v == true
end
local function due(key, interval)
    local now = os.clock()
    if (Timers[key] or 0) <= now then
        Timers[key] = now + interval
        return true
    end
    return false
end

task.spawn(function()
    while Alive do
