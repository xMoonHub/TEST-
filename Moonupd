            end
        end
        if best then
            State.Text = "Raid: killing " .. best.Name
            fightEnemy(best, { best.Name }, true)
            return true
        end
        local isl = nearIsland()
        if isl then
            State.Text = "Raid: going to " .. isl.Name
            local off = (isl.Name == "Island 2" and Config.RaidType == "Phoenix") and Vector3.new(300, 60, 0) or Vector3.new(0, 60, 0)
            flyTo(CFrame.new(isl.Position + off))
            return true
        end
        State.Text = "Raid: waiting for mobs"
        return true
    end

    -- true while it is using the character
    raidStep = function()
        if not (Config.AutoStartRaid or Config.AutoRaid or Config.AutoPay) then return false end
        if getSea() == 1 then
            Diag.raid = "Raids only exist in Seas 2 and 3"
            return false
        end
        if active() then
            R.wasActive = true
            if Config.AutoRaid then return fight() end
            return false
        end
        if R.wasActive then R.wasActive, R.doneAt = false, os.clock() end
        if os.clock() - R.doneAt < 6 then
            State.Mode, State.Text = "Raids", "Raid finished: collecting"
            return true
        end
        local now = os.time()
        local chip = hasChip()
        if not chip and Config.AutoPay and now >= R.payAt then
            if getPlayerLevel() < 1100 then
                Diag.raid = "Raids need level 1100+"
                return false
            end
            State.Mode, State.Text = "Raids", "Buying the chip (" .. Config.RaidType .. ")"
            local r = payChip()
            if r == true then R.fails, chip = 0, true
            elseif r == false then
                R.fails += 1
                R.payAt = now + ((R.fails < 3) and 60 or 600)
            else return true end
        end
        if chip and Config.AutoStartRaid and os.clock() - R.pressAt > 12 then
            local btn = raidButton()
            if not btn then
                Diag.raid = "Raid button not found: go to Hot and Cold Island (Sea 2) or Castle on the Sea (Sea 3)"
                return false
            end
            State.Mode = "Raids"
            if distanceTo(btn.CFrame) > 14 then
                State.Text = "Going to the Raid button"
                flyTo(btn.CFrame * CFrame.new(0, 3, 5))
                return true
            end
            State.Text = "Starting the Raid"
            unequip()
            task.wait(0.3)
            pcall(function() fireclickdetector(btn:FindFirstChildOfClass("ClickDetector")) end)
            R.pressAt = os.clock()
            Diag.raid = "button pressed (" .. Config.RaidType .. ")"
            return true
        elseif not chip and Config.AutoStartRaid and not Config.AutoPay then
            Diag.raid = "no Special Microchip (turn on Auto Pay or buy the chip)"
        end
        return false
    end
end

