local function eliteStep(askQuest)
    local boss = findEnemy(EliteNames)
    if boss then
        State.Mode = "Auto Elite Hunter"
        State.Text = "Killing " .. boss.Name
        fightEnemy(boss, EliteNames, false)
        return true
    end
    -- o elite ainda não carregou: o modelo fica em ReplicatedStorage, voa até a posição dele
    for _, n in ipairs(EliteNames) do
        local m = ReplicatedStorage:FindFirstChild(n)
        local part = m and (m:FindFirstChild("HumanoidRootPart") or m.PrimaryPart)
        if part then
            State.Mode = "Auto Elite Hunter"
            State.Text = "Going to " .. n
            flyTo(part.CFrame * CFrame.new(0, 20, 0))
            return true
        end
    end
    -- sem elite ativo: vai até o NPC Elite Hunter e pede a quest (só se "Auto Quest Elite Hunter" estiver ligado)
    if askQuest and os.clock() >= EliteS.pauseUntil then
        local visible, known = questVisible()
        local hasEliteQuest = known and visible and isEliteTitle(activeQuestTitle())
        if not hasEliteQuest then
            local cf = eliteNpcCF()
            if distanceTo(cf) > 25 then
                if EliteS.travelSince == 0 then EliteS.travelSince = os.clock() end
                if os.clock() - EliteS.travelSince > 45 then
                    EliteS.travelSince, EliteS.pauseUntil = 0, os.clock() + 60
                    Diag.elite = "trip to the Elite Hunter took too long; trying again in 60s"
                    return false
                end
                State.Mode, State.Text = "Auto Elite Hunter", "Going to the Elite Hunter NPC"
                flyTo(cf * CFrame.new(0, 3, 4))
                return true
            end
            EliteS.travelSince = 0
            State.Mode, State.Text = "Auto Elite Hunter", "Asking the Elite Hunter for the quest"
            if os.clock() - EliteAsk > 12 then
                EliteAsk = os.clock()
                if known and visible then -- tem outra quest ativa: abandona antes
                    invoke("AbandonQuest")
                    task.wait(0.4)
                end
                local ok, r = invoke("EliteHunter")
                Diag.elite = (ok and "EliteHunter -> " or "error -> ") .. tostring(r)
                local low = string.lower(tostring(r))
                if string.find(low, "later", 1, true) or string.find(low, "don't have", 1, true)
                    or string.find(low, "come back", 1, true) then
                    EliteS.pauseUntil = os.clock() + 120 -- sem elite disponível agora: volta ao farm e tenta depois
                    EliteS.unavailAt = EliteS.unavailAt or os.clock()
                    local mins, secs = tonumber(string.match(low, "(%d+)%s*min")), tonumber(string.match(low, "(%d+)%s*sec"))
                    local mm, ss = string.match(low, "(%d+):(%d+)")
                    EliteS.remain = mins and (mins * 60 + (secs or 0)) or (mm and (tonumber(mm) * 60 + tonumber(ss))) or secs
                    return false
                else
                    EliteS.unavailAt, EliteS.remain = nil, nil
                end
            end
            return true
        end
    end
    return false
end

