    end
    -- stored fruits (inventory) that are allowed: returns the candidates, cheapest first { {name, info}, ... }
    -- v30: reads getInventoryFruits and, if empty, getInventory (fruit items); accepts several entry formats
    local function storedList(only1M, needMin)
        local names, seen = {}, {}
        local function add(nm)
            nm = tostring(nm)
            if not seen[nm] then seen[nm] = true; names[#names + 1] = nm end
        end
        local function walk(t, depth, fruitOnly)
            for k, it in pairs(t) do
                if type(it) == "table" then
                    local nm = it.Name or it.name or it.ItemName
                    local ty = string.lower(tostring(it.Type or it.type or ""))
                    if nm ~= nil and type(nm) ~= "table" then
                        if not fruitOnly or string.find(ty, "fruit", 1, true) then add(nm) end
                    elseif depth < 3 then walk(it, depth + 1, fruitOnly) end
                elseif type(it) == "string" and type(k) == "number" then
                    add(it)
                elseif type(k) == "string" and (it == true or type(it) == "number") and not fruitOnly then
                    add(k)
                end
            end
        end
        local ok, inv = invoke("getInventoryFruits")
        if ok and type(inv) == "table" then walk(inv, 1, false) end
        if #names == 0 then
            local ok2, inv2 = invoke("getInventory")
            if ok2 and type(inv2) == "table" then walk(inv2, 1, true) end
        end
        local out = {}
        for _, nm in ipairs(names) do
            local f = infoOf(nm)
            if f and eligible(f, only1M, needMin) then out[#out + 1] = { nm, f } end
        end
        table.sort(out, function(x, y) return x[2][2] < y[2][2] end)
        R.invSummary = #names .. " in inventory, " .. #out .. " allowed" .. (#out > 0 and (" (cheapest: " .. out[1][1] .. ")") or "")
        return out
    end
    -- takes ONE fruit out of the inventory and returns the new backpack tool (or nil)
    local function loadOne(entry)
        local before = {}
        for _, t in ipairs(Player.Backpack:GetChildren()) do before[t] = true end
        local nm = entry[1]
        local tries = { nm }
        local base = string.match(nm, "^(%a+)")
        if base then
            tries[#tries + 1] = base .. "-" .. base
            tries[#tries + 1] = base .. " Fruit"
        end
        for _, arg in ipairs(tries) do
            local ok, res = invoke("LoadFruit", arg)
            Diag.raid = "Auto Pay (fruit): LoadFruit " .. arg .. " -> " .. (ok and describe(res) or tostring(res))
            local found
            waitFor(function()
                for _, t in ipairs(Player.Backpack:GetChildren()) do
                    if t:IsA("Tool") and not before[t] then found = t; return true end
                end
                local ch = Player.Character
                for _, t in ipairs(ch and ch:GetChildren() or {}) do
                    if t:IsA("Tool") and not before[t] and string.find(t.Name, "Fruit") then found = t; return true end
