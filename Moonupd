        local r = n and n:FindFirstChild(name)
        if not r then return false, "remote " .. name .. " not found" end
        local args, done, ok, res = table.pack(...), false, false, nil
        task.spawn(function() ok, res = pcall(r.InvokeServer, r, table.unpack(args, 1, args.n)); done = true end)
        local t0 = os.clock()
        while not done and os.clock() - t0 < 8 do task.wait(0.05) end
        if not done then return false, "no response (8s)" end
        return ok, res
    end
    local function npcCF(name)
        for _, holder in ipairs({ workspace:FindFirstChild("NPCs"), ReplicatedStorage:FindFirstChild("NPCs") }) do
            local n = holder and holder:FindFirstChild(name)
            local p = n and (n:FindFirstChild("HumanoidRootPart") or n.PrimaryPart or n:FindFirstChildWhichIsA("BasePart", true))
            if p then return p.CFrame end
        end
    end
    local function spawnOf(name)
        local wo = workspace:FindFirstChild("_WorldOrigin")
        local es = wo and wo:FindFirstChild("EnemySpawns")
        for _, p in ipairs(es and es:GetChildren() or {}) do
            if p:IsA("BasePart") and string.find(p.Name, name, 1, true) then return p end
        end
    end
    local function killMob(name, why)
        local e = findEnemy({ name })
        State.Mode = "Auto Volcanic Magnet"
        if e then State.Text = why; fightEnemy(e, { name }, true); return true end
        local sp = spawnOf(name)
        if sp then State.Text = why .. " (going to the spawn)"; flyTo(sp.CFrame * CFrame.new(0, 30, 0)); return true end
        return false
    end
    local function skills()
        pcall(equipWeapon)
        for _, k in ipairs({ Enum.KeyCode.Z, Enum.KeyCode.X, Enum.KeyCode.C, Enum.KeyCode.V }) do
            pressKey(k)
            task.wait(0.15)
        end
    end
    -- ===== v30: usa as armas e ataques escolhidos (Melee / Blox Fruit / Sword / Gun; M1 e teclas) contra uma parte =====
    local VWEAPONS = { "Melee", "Blox Fruit", "Sword", "Gun" }
    local VKEYS = { "Z", "X", "C", "V", "F" }
    local function needClose(wset)
        return wset and (wset.Melee or wset.Sword) and true or false -- Melee/Sword só alcançam de perto
    end
    local function m1Burst(tip, part)
        local t0 = os.clock()
        while Alive and part.Parent and os.clock() - t0 < 0.6 do
            Aim.part = part
            if tip == "Melee" then pcall(cfAttack)
            elseif tip == "Blox Fruit" then pcall(FruitM1.tick)
            elseif tip == "Gun" and Config.ShotFire then pcall(Config.ShotFire, { kind = "gun", part = part }) end
            pcall(function()
                local tool = Player.Character and Player.Character:FindFirstChildOfClass("Tool")
                if tool and tip ~= "Melee" then tool:Activate() end
            end)
            task.wait(0.05)
        end
    end
    -- devolve true se pelo menos uma arma escolhida foi usada
    function V.useSet(wkey, kkey, part)
        local used = false
        local wset, kset = Config[wkey] or {}, Config[kkey] or {}
        for _, tip in ipairs(VWEAPONS) do
            if Alive and wset[tip] and part and part.Parent then
                Config.SeaTool, Config.SeaUntil = { tip = tip }, os.clock() + 1.5
                pcall(equipWeapon)
                local tool = findTool(tip)
                if tool then
                    used = true
                    task.wait(0.2)
                    local ks = kset[tip] or {}
                    Aim.part = part
                    if ks.M1 then m1Burst(tip, part) end
                    for _, k in ipairs(VKEYS) do
                        if ks[k] and Alive and part.Parent then
                            local kc = Enum.KeyCode[k]
                            if kc then
                                Config.SeaUntil = os.clock() + 1.5
                                pcall(AFL.tvHook)
                                AFL.TV.aimPos, AFL.TV.aimPart = part.Position, part
                                VirtualInputManager:SendKeyEvent(true, kc, false, game)
                                task.wait(0.22)
                                VirtualInputManager:SendKeyEvent(false, kc, false, game)
                                task.wait(0.12)
                            end
                        end
                    end
                end
            end
        end
        Config.SeaUntil = 0
        AFL.TV.aimPos, AFL.TV.aimPart = nil, nil
        return used
    end
    -- árvores / plantas da missão (cache de 2,5s; antes varria o workspace inteiro a cada passo)
    V.badPlant, V.plantTry = setmetatable({}, { __mode = "k" }), setmetatable({}, { __mode = "k" })
    V.plants, V.plantsAt = {}, 0
    local PLANT_CENTER = Vector3.new(5290, 1000, 390)
    local function nearestPlant(hrp)
        if os.clock() - V.plantsAt > 2.5 then
            V.plantsAt = os.clock()
            local out = {}
            local map = workspace:FindFirstChild("Map")
            for _, root in ipairs({ map or workspace, workspace }) do
                for _, d in ipairs(root:GetDescendants()) do
                    if d:IsA("BasePart") then
                        local n = string.lower(d.Name)
                        if (n == "meshes/plant1_icosphere" or (string.find(n, "plant", 1, true) and string.find(n, "icosphere", 1, true))
                            or (string.find(n, "tree", 1, true) and string.find(n, "meshes/", 1, true)))
                            and (d.Position - PLANT_CENTER).Magnitude < 900 then
                            out[#out + 1] = d
                        end
                    end
                end
                if #out > 0 then break end
            end
            V.plants = out
            if #out == 0 then V.plantsAt = os.clock() + 5 end
        end
        local best, bd
        for _, d in ipairs(V.plants) do
            if d.Parent and not V.badPlant[d] then
                local m = d:FindFirstAncestorWhichIsA("Model")
                if not (m and m:GetAttribute("AlreadyDestroyedClient")) then
                    local dist = (d.Position - hrp.Position).Magnitude
                    if not bd or dist < bd then best, bd = d, dist end
                end
            end
        end
        return best
    end
    -- toca na caveira da relíquia (voa até ela, firetouchinterest + prompt/click se houver)
    local function touchSkull(skull, hrp)
        if (hrp.Position - skull.Position).Magnitude > 9 then
            flyTo(skull.CFrame * CFrame.new(0, 3, 0))
            return false
        end
        pcall(function()
            if firetouchinterest then
                firetouchinterest(hrp, skull, 0)
                task.wait()
                firetouchinterest(hrp, skull, 1)
            end
        end)
        for _, o in ipairs({ skull, skull.Parent }) do
            if o then
                for _, dsc in ipairs(o:GetDescendants()) do
                    if dsc:IsA("ProximityPrompt") or dsc:IsA("ClickDetector") then MV.trigger(dsc) end
                end
            end
        end
        return true
    end
    local function ember()
        for _, d in ipairs(workspace:GetChildren()) do
            if d.Name == "EmberTemplate" and not V.badEmber[d] then
                local p = d:FindFirstChild("Part")
                if p and p.Position.Y > -100 then return d, p end
            end
        end
    end
    V.badEmber = setmetatable({}, { __mode = "k" })

    -- Blaze Ember (lógica do Quantum Onyx + Banana): Dragon Hunter fica no Dojo (5864, 1209, 808).
    -- RequestQuest + Check devolvem o texto da missão (Defeat Hydra Enforcers / Venomous Assailants, ou Destroy trees).
    -- Ao terminar aparece "Task completed!" -> pede a próxima. Os Blaze Ember caem como EmberTemplate (Part com Y > 10).
    local DH_CF = CFrame.new(5864, 1209, 808)
    local function taskDone()
        local ok, r = pcall(function()
            local n = Player.PlayerGui:FindFirstChild("Notifications")
            if not n then return false end
            for _, d in ipairs(n:GetDescendants()) do
                if d:IsA("TextLabel") and (string.find(d.Text, "Task completed!", 1, true) or string.find(d.Text, "Head back to the Dojo", 1, true)) then return true end
            end
            return false
        end)
        return ok and r
    end
    function V.checkQuest()
        netCall("RF/DragonHunter", { Context = "RequestQuest" })
        local ok, r = netCall("RF/DragonHunter", { Context = "Check" })
        if not (ok and type(r) == "table" and r.Text) then return nil, tostring(r) end
        local t = tostring(r.Text)
        if string.find(t, "Destroy", 1, true) or string.find(t, "Tree", 1, true) or string.find(t, "tree", 1, true) then return { kind = "tree", text = t } end
        if string.find(t, "Venomous", 1, true) or string.find(t, "Assailant", 1, true) then return { kind = "kill", mob = "Venomous Assailant", text = t } end
        if string.find(t, "Hydra", 1, true) or string.find(t, "Enforcer", 1, true) or string.find(t, "Defeat", 1, true) then return { kind = "kill", mob = "Hydra Enforcer", text = t } end
        return { kind = "unknown", text = t }
    end
    V.treePts = { Vector3.new(5326, 1000.5, 441.52), Vector3.new(5344.88, 1000.5, 359.94), Vector3.new(5260.73, 1000.5, 345.5), Vector3.new(5237.99, 1000.5, 429.64) }

    function V.emberStep()
        State.Mode = "Auto Volcanic Magnet"
        local e, part = ember()
        if e then
            V.emberSince = V.emberSince or os.clock()
            State.Text = "Collecting Blaze Ember"
            Diag.vulc = "Blaze Ember " .. invCount("Blaze Ember") .. "/15: collecting the drop"
            if os.clock() - V.emberSince > 15 then V.badEmber[e] = true; V.emberSince = nil; return true end
            flyTo(part.CFrame * CFrame.new(0, 3, 0))
            return true
        end
        if V.emberSince then V.emberSince, V.cur = nil, nil end -- ember collected: next task
        if V.cur and os.clock() - (V.curAt or 0) > 4 and taskDone() then V.cur = nil end
        local _, hrp = getChar()
        if not V.cur or os.clock() - (V.curAt or 0) > 180 then
            local cf = npcCF("Dragon Hunter") or DH_CF
            if hrp and (hrp.Position - cf.Position).Magnitude > 12 then
                State.Text = "Going to the Dragon Hunter"
                Diag.vulc = "going to the Dragon Hunter (Dojo)"
                flyTo(cf * CFrame.new(0, 4, 4))
                return true
            end
            local q, err = V.checkQuest()
            if q then
                V.cur, V.curAt, V.unk = q, os.clock(), 0
                Diag.vulc = "Dragon Hunter task: " .. q.text
            else
                Diag.vulc = "Dragon Hunter gave no task: " .. tostring(err)
                task.wait(2)
            end
            return true
        end
        local q = V.cur
        Diag.vulc = "Blaze Ember " .. invCount("Blaze Ember") .. "/15 | task: " .. q.text
        if q.kind == "kill" then
            if killMob(q.mob, q.mob) then return true end
            State.Text = "Looking for " .. q.mob
            flyTo(CFrame.new(5251.9, 60, 453.6))
            return true
        elseif q.kind == "tree" then
            State.Text = "Breaking trees / plants"
            local tree = nearestPlant(hrp)
            if tree then
                local close = needClose(Config.VulcTreeW)
                local goal = tree.Position + Vector3.new(0, close and 8 or 25, 0)
                if (hrp.Position - goal).Magnitude > 12 then flyTo(CFrame.new(goal)); return true end
                V.plantTry[tree] = (V.plantTry[tree] or 0) + 1
                if V.plantTry[tree] > 10 then V.badPlant[tree] = true end -- não quebrou depois de 10 rodadas: pula
                if not V.useSet("VulcTreeW", "VulcTreeK", tree) then
                    Aim.part, Aim.level = tree, false
                    skills()
                end
                return true
            end
            -- sem árvore carregada: patrulha os 4 pontos soltando as skills
            V.pi = ((math.floor(os.clock() / 2)) % #V.treePts) + 1
            local p = V.treePts[V.pi]
            flyTo(CFrame.new(p))
            return true
        end
        V.unk = (V.unk or 0) + 1
        if V.unk > 20 then V.cur = nil end
        return true
    end

    -- Volcanic Magnet: 10 Scrap Metal (kill Jungle Pirates) + 15 Blaze Ember (Dragon Hunter) -> craft with RF/Craft
    function V.magnetStep()
        local haveMagnet = false
        for _, c in ipairs({ Player.Backpack, Player.Character }) do
            if c then for _, t in ipairs(c:GetChildren()) do
                if t:IsA("Tool") and string.find(string.lower(t.Name), "volcanic magnet", 1, true) then haveMagnet = true end
            end end
        end
        if haveMagnet then Diag.vulc = "already has the Volcanic Magnet: skipping to the island"; return false end
        local scrap, ember = invCount("Scrap Metal"), invCount("Blaze Ember")
        if scrap >= 10 and ember >= 15 then
            State.Mode, State.Text = "Auto Volcanic Magnet", "Crafting the Volcanic Magnet"
            if os.clock() - V.last > 5 then
                V.last = os.clock()
                local ok, r = netCall("RF/Craft", "Craft", "Volcanic Magnet", 1, {})
                Diag.vulc = "craft: " .. tostring(ok) .. " / " .. tostring(r)
            end
            return true
        end
        if scrap < 10 then
            Diag.vulc = "farming Scrap Metal " .. scrap .. "/10 (Jungle Pirate)"
            State.Text = "Scrap Metal " .. scrap .. "/10"
            if killMob("Jungle Pirate", "Scrap Metal " .. scrap .. "/10") then return true end
            Diag.vulc = "Jungle Pirate spawn not found (Sea 3, Deep Forest / Jungle)"
            return true -- fica no passo do magnet em vez de sair navegando sem o magnet
        end
        return V.emberStep()
    end

    -- eggs: Core.SpawnedDragonEggs.DragonEgg.Molten (ProximityPrompt) | bones: workspace.DinoBone
    function V.egg(isl)
        local core = isl:FindFirstChild("Core")
        local f = core and core:FindFirstChild("SpawnedDragonEggs")
        for _, e in ipairs(f and f:GetChildren() or {}) do
            local m = e.Name == "DragonEgg" and e:FindFirstChild("Molten")
            local pp = m and m:FindFirstChildOfClass("ProximityPrompt")
            if pp then return m, pp end
        end
    end
    function V.collectEgg(isl)
        local m, pp = V.egg(isl)
        if not m then return false end
        local _, hrp = getChar()
        State.Mode, State.Text = "Auto Collect Egg", "Collecting a Dragon Egg"
        if hrp and (hrp.Position - m.Position).Magnitude > 8 then flyTo(m.CFrame) else pcall(fireproximityprompt, pp) end
        return true
    end
    function V.collectBone()
        local b = workspace:FindFirstChild("DinoBone")
        if not (b and b:IsA("BasePart")) then return false end
        State.Mode, State.Text = "Auto Collect Bone", "Collecting a Dino Bone"
        flyTo(b.CFrame)
        return true
    end
    -- 10 seconds after the island is finished (or gone), reset the character to restart the cycle
    function V.finish(why)
        V.doneAt = V.doneAt or os.clock()
        local left = 10 - (os.clock() - V.doneAt)
        Diag.vulc = why .. " | reset in " .. math.max(0, math.ceil(left)) .. "s"
        if left <= 0 then
            V.doneAt, V.seen = nil, false
            local _, _, hum = getChar()
            if hum then pcall(function() hum.Health = 0 end) end
            return false
        end
        State.Mode, State.Text = "Auto Fully Vulcan", why .. " (reset in " .. math.max(0, math.ceil(left)) .. "s)"
        return true
    end
    -- true while an island is being worked on: the scheduler puts Vulcan first so nothing else steals the character
    function V.engaged() return os.clock() - (V.activeAt or -1e9) < 3 end
    -- devolve o golem mais perto e quantos existem
    local function golem()
        local _, hrp = getChar()
        local best, bd, n = nil, 1e9, 0
        for _, e in ipairs(enemiesList()) do
            if e.Name == "Lava Golem" then
                local eh, er = aliveParts(e)
                if eh and hrp then
                    local d = (hrp.Position - er.Position).Magnitude
                    if d <= 1500 then
                        n += 1
                        if d < bd then best, bd = e, d end
                    end
                end
            end
        end
        return best, n
    end
    local function activeRock(isl)
        local core = isl:FindFirstChild("Core")
        local f = core and core:FindFirstChild("VolcanoRocks")
        local best, bd, _, hrp = nil, 1e9, getChar()
        for _, r in ipairs(f and f:GetChildren() or {}) do
            local on = false
            pcall(function() on = r.Name == "Rock" and r.VFXLayer.Specs.Enabled end)
            if on and hrp then
                local d = (hrp.Position - r:GetPivot().Position).Magnitude
                if d < bd then best, bd = r, d end
            end
        end
        return best
    end
    -- touching lava hurts: remove the TouchInterest of the island and the interior lava (same as Banana)
    local function cleanLava(isl)
        if V.cleaned == isl then return end
        V.cleaned = isl
        pcall(function()
            for _, d in ipairs(isl:GetDescendants()) do
                if d.Name == "TouchInterest" and d.Parent and d.Parent.Name ~= "TrialTeleport" then d:Destroy() end
            end
            local il = isl.Core:FindFirstChild("InteriorLava")
            if il then for _, c in ipairs(il:GetChildren()) do c:Destroy() end end
        end)
    end

    function V.step()
        if not (Config.VulcFull or Config.VulcMagnet or Config.VulcFind or Config.VulcStart or Config.VulcEgg or Config.VulcBone) then return false end
        if getSea() ~= 3 then Diag.vulc = "Vulcan only works in Sea 3"; return false end
        Fight.bringMax, Fight.bringRange = nil, nil -- só vale durante a luta contra os golens
        local char, hrp = getChar()
        if not char then return false end
        local isl = V.island()
        if isl then
            V.seen = true
            MV.hold()
            local core = isl:FindFirstChild("Core")
            -- 1) not inside the island yet: the Fossil Expert is at the entrance
            V.activeAt = os.clock()
            if Player:GetAttribute("CurrentLocation") == "Prehistoric Island" then V.entered = true end
            if not V.entered then
                local cf = npcCF("Fossil Expert") or (core and core:GetPivot())
                if cf and (hrp.Position - cf.Position).Magnitude > 12 then
                    State.Mode, State.Text = "Auto Vulcan", "Going to the Fossil Expert"
                    Diag.vulc = "phase: entering the island"
                    flyTo(cf * CFrame.new(0, 4, 4))
                    return true
                end
                V.entered = true -- chegou na entrada: nunca mais volta para ela durante esta visita (evitava vai-e-vem)
            end
            cleanLava(isl)
            local running = hud("PrehistoricRaidTimer")
            -- 2) event running: golems -> rocks -> skull
            if running and flag("VulcStart") then
                V.doneAt = nil
                State.bossAt = os.clock() -- evento rodando: coleta de fruta, dungeon, gacha e raid esperam
                local g, gn = golem()
                if g then
                    -- 2 ou mais golens: puxa todos para o mesmo ponto e bate neles juntos (até o limite escolhido)
                    if Config.VulcPull ~= false and gn > 1 then
                        Fight.bringMax = math.clamp(math.min(gn, tonumber(Config.VulcPullMax) or 6), 2, 10)
                        Fight.bringRange, Fight.bringUntil = 1100, os.clock() + 1.5
                    end
                    V.noRockAt = nil
                    State.Mode, State.Text = "Auto Start Vulcan", "Killing " .. gn .. " Lava Golem" .. (gn > 1 and "s" or "")
                    Diag.vulc = "Lava Golems alive: " .. gn .. (Fight.bringMax and (" | pulling up to " .. Fight.bringMax) or "")
                    fightEnemy(g, { "Lava Golem" }, true)
                    return true
                end
                local rock = activeRock(isl)
                if rock then
                    State.Mode, State.Text = "Auto Start Vulcan", "Breaking the volcano rock"
                    local pv = rock:GetPivot()
                    local up = needClose(Config.VulcRockW) and 10 or 45
                    local goal = pv * CFrame.new(0, up, 0)
                    if (hrp.Position - goal.Position).Magnitude > 14 then flyTo(goal); return true end
                    local part = rock:FindFirstChildWhichIsA("BasePart", true)
                    if part then
                        Aim.part, Aim.level = part, false
                        if not V.useSet("VulcRockW", "VulcRockK", part) then skills() end
                    end
                    V.skullGo, V.noRockAt = true, nil
                    return true
                end
                V.noRockAt = V.noRockAt or os.clock()
                local skull
                pcall(function() skull = core.PrehistoricRelic.Skull end)
                if V.skullGo and skull and os.clock() - V.noRockAt > 2 then
                    State.Mode, State.Text = "Auto Start Vulcan", "Going to the Relic Skull"
                    if touchSkull(skull, hrp) then
                        V.skullGo = false
                        Diag.vulc = "Relic Skull touched"
                    end
                    return true
                end
                Diag.vulc = "event running"
                return true
            end
            -- 3) not started: ActivationPrompt
            if not running and not hud("RaidTimer") and flag("VulcStart") then
                local ap = core and core:FindFirstChild("ActivationPrompt")
                local pp = ap and ap:FindFirstChildOfClass("ProximityPrompt")
                if pp and pp.Enabled then
                    State.Mode, State.Text = "Auto Start Vulcan", "Activating the event"
                    if (hrp.Position - ap.Position).Magnitude > 8 then flyTo(ap.CFrame) else pcall(fireproximityprompt, pp, 1); task.wait(3) end
                    return true
                end
            end
            -- 4) loot (bones only while no timers are running)
            if flag("VulcEgg") and V.collectEgg(isl) then V.doneAt = nil; return true end
            if flag("VulcBone") and not running and not hud("RaidTimer") and V.collectBone() then V.doneAt = nil; return true end
            if Config.VulcFull then return V.finish("island finished") end
            Diag.vulc = "Prehistoric Island found"
            return false
        end
        V.started, V.cleaned, V.entered, V.skullGo, V.noRockAt = nil, nil, nil, nil, nil
        if V.seen then
            V.doneAt = V.doneAt or os.clock()
            if Config.VulcFull then return V.finish("island gone") end
            V.seen = false
        end
        V.doneAt = nil
        if flag("VulcMagnet") and V.magnetStep() then return true end
        if flag("VulcFind") then
            State.Mode = "Auto Find Vulcan"
            Diag.vulc = "sailing to Sea Danger Level 6, ignoring sea events"
            MV.equip("volcanic magnet")
            return MV.sail(6)
        end
        return false
    end
end


