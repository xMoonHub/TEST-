                end
            end
        end
        return out
    end
    function S.assist()
        if not (Config.SecretAssist or Config.SecretAuto) then return false end
        S.refresh(false)
        if not S.done then Diag.secret = "assist: waiting for the secret progress"; return false end
        local now = os.clock()
        local d = S.cur
        if d and (S.isDone(d) or now - S.curSince > (Config.SecretAuto and 300 or 90)) then
            S.skip[d[3]] = now + 180
            d, S.cur = nil, nil
        end
        if not d then
            for _, x in ipairs(S.defs) do
                if selected(x) and not S.isDone(x) and (S.skip[x[3]] or 0) < now and not string.find(x[2], "Awakened", 1, true) then
                    d = x; break
                end
            end
            if not d then Diag.secret = "assist: nothing pending in the selection"; return false end
            S.cur, S.curSince = d, now
        end
        local _, hrp = getChar()
        if not hrp then return false end
        State.Mode, State.Text = "Auto Secret Quest", d[1] .. " - " .. d[2]
        local pos = d[5] + Vector3.new(0, 3, 0)
        if (hrp.Position - pos).Magnitude > 30 then
            Diag.secret = "assist: flying to " .. d[4] .. " (" .. d[1] .. ")"
            flyTo(CFrame.new(pos))
            return true
        end
        Diag.secret = "assist: at " .. d[4] .. " - " .. d[2] .. " (do the steps; known prompts are pressed)"
        if Config.SecretAuto and S.autoStep then
            local okA, handled = pcall(S.autoStep, d)
            if okA and handled then return true end
            if not okA then Diag.secret = "auto error: " .. tostring(handled) end
        end
        if #d[7] > 0 and fireproximityprompt and now - (S.lastScan or 0) > 4 then
            S.lastScan = now
            for _, pr in ipairs(scanPrompts(d[5], d[7])) do
                local p, at = pr[1], pr[2]
                if (hrp.Position - at).Magnitude > 12 then
                    flyTo(CFrame.new(at + Vector3.new(0, 3, 0)))
                    break
                end
                pcall(fireproximityprompt, p, 1)
            end
        end
        return true
    end
