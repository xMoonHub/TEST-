-- ---- Mirage Island (Sea 3) ----
AFL.Mirage = { gearAt = 0, leverDone = false, lookAt = 0, gearTouches = 0 }
do
    local M, MV = AFL.Mirage, AFL.MV
    local TEMPLE = Vector3.new(28286, 14897, 103) -- Temple of Time (from other hubs)
    function M.island() return MV.mapChild("mysticisland") or MV.mapChild("mirage") end
    function M.findGear(isl)
        local best, bd
        local _, hrp = getChar()
        for _, d in ipairs(isl:GetDescendants()) do
            if d:IsA("BasePart") and d.Material == Enum.Material.Neon and (d.Name:lower():find("gear", 1, true) or d:IsA("MeshPart")) then
                local dist = hrp and (d.Position - hrp.Position).Magnitude or 0
                if not bd or dist < bd then best, bd = d, dist end
            end
        end
        return best
    end
    function M.step()
        if not Config.MirageOn then return false end
        if getSea() ~= 3 then Diag.mirage = "Mirage only works in Sea 3"; return false end
        local char, hrp, hum = getChar()
        if not char then return false end
        local isl = M.island()
        if not isl then
            M.gearTouches, M.leverDone = 0, false
            State.Mode = "Auto Mirage"
            Diag.mirage = "sailing, ignoring sea events"
            return MV.sail(Config.SeaZone > 0 and Config.SeaZone or nil)
        end
        MV.hold()
        State.Mode = "Auto Mirage"
        if not Config.PullLever then
            State.Text = "Mirage Island found"
            Diag.mirage = "Mirage Island found (Auto Pull Lever is off)"
            return false
        end
        if M.leverDone then Diag.mirage = "lever already pulled on this island"; return false end
        -- 1) blue gear
        local gear = (M.gearTouches < 6) and M.findGear(isl)
        if gear then
            State.Text = "Getting the Blue Gear"
            Diag.mirage = "touching the gear"
            hrp.CFrame = CFrame.new(gear.Position + Vector3.new(0, 3, 0))
            MV.touch(gear)
            MV.trigger(gear:FindFirstChildWhichIsA("ProximityPrompt", true) or gear:FindFirstChildWhichIsA("ClickDetector", true) or gear)
            M.gearTouches += 1
            task.wait(0.4)
            return true
        end
        -- 2) no gear yet: go up, look at the moon and use the race ability (key T) during the night
        if M.gearTouches == 0 then
            local top = MV.islandTop(isl)
            local t = Lighting.ClockTime
            local night = t >= 18 or t <= 5
            if top then flyTo(CFrame.new(top)) end
            if night then
                State.Text = "Looking at the moon (race ability)"
                Diag.mirage = "night: looking at the moon + race ability"
                local cam = workspace.CurrentCamera
                pcall(function()
                    local dir = Lighting:GetMoonDirection()
                    cam.CFrame = CFrame.lookAt(cam.CFrame.Position, cam.CFrame.Position + dir * 1000)
                end)
                if os.clock() - M.lookAt > 1.5 then M.lookAt = os.clock(); MV.pressKey("T") end
            else
                Diag.mirage = "waiting for the night to find the gear"
            end
            return true
        end
        -- 3) gear touched: Temple of Time lever
        State.Text = "Temple of Time: lever"
        if (hrp.Position - TEMPLE).Magnitude > 150 then
            hrp.CFrame = CFrame.new(TEMPLE + Vector3.new(0, 5, 0))
            task.wait(0.5)
            return true
        end
        local found
        for _, d in ipairs(workspace:GetDescendants()) do
            if (d:IsA("ProximityPrompt") or d:IsA("ClickDetector")) and d.Parent then
                local nm = (d.Parent.Name .. " " .. (d:IsA("ProximityPrompt") and tostring(d.ActionText) or "")):lower()
                local pp = d.Parent:IsA("BasePart") and d.Parent.Position or nil
                if pp and (pp - hrp.Position).Magnitude < 200 and (nm:find("lever", 1, true) or nm:find("pull", 1, true)) then
                    found = d
                    hrp.CFrame = CFrame.new(pp + Vector3.new(0, 4, 4))
                    task.wait(0.3)
                    MV.trigger(d)
                    break
                end
            end
        end
        if found then M.leverDone = true; Diag.mirage = "lever pulled" else Diag.mirage = "lever not found near the Temple of Time" end
        return true
    end
end

-- ---- Inventory read straight from the game's client data (same method as the Banana hub) ----
-- Finds, at runtime, the store (GetItems/ReadItem), the KEYS table (QUANTITY/MASTERY) and ReplicatedStorage.ItemConfig.
AFL.Inv = { map = {}, at = 0, tries = 0, state = "not started" }
do
    local I = AFL.Inv
    local RS = game:GetService("ReplicatedStorage")
    local store, keys, cfg
    local function try(f) local ok, v = pcall(f); if ok then return v end end
    local function discover()
        if store and keys and cfg then return true end
        if not cfg then
            local ms = RS:FindFirstChild("ItemConfig")
            cfg = ms and try(function() return require(ms) end)
        end
        if (not store or not keys) and getgc and os.clock() - (I.lastScan or -99) > 20 then
            I.lastScan = os.clock()
            I.tries += 1
            for _, v in ipairs(getgc(true)) do
                if type(v) == "table" then
                    if not keys and try(function() return rawget(v, "QUANTITY") end) ~= nil and try(function() return rawget(v, "MASTERY") end) ~= nil then keys = v end
                    if not store and type(try(function() return v.GetItems end)) == "function" and type(try(function() return v.ReadItem end)) == "function" then store = v end
                    if store and keys then break end
                end
            end
        end
        return (store and keys and cfg) and true or false
    end
    -- Método principal (Quantum Onyx): remote GetAllItemValues devolve {ItemId, NetworkedUID, Key, Value}; o nome vem do ItemConfig
    local netMod
    local function viaRemote()
        if not netMod then
            local mods = RS:FindFirstChild("Modules")
            local nf = mods and mods:FindFirstChild("Net")
            netMod = nf and try(function() return require(nf) end)
        end
        local cfg2 = cfg
        if not cfg2 then
            local ms = RS:FindFirstChild("ItemConfig")
            cfg2 = ms and try(function() return require(ms) end)
            cfg = cfg2 or cfg
        end
        if not (netMod and cfg2) then return nil, "Net/ItemConfig missing" end
        local ok, res = pcall(function() return netMod:RemoteFunction("GetAllItemValues"):InvokeServer() end)
        if not ok or type(res) ~= "table" then return nil, "GetAllItemValues failed: " .. tostring(res) end
        local by, rows = {}, 0
        for _, r in next, res do
            rows += 1
            local k = tostring(r.ItemId) .. "_" .. tostring(r.NetworkedUID)
            by[k] = by[k] or { id = r.ItemId, at = {} }
            if r.Value ~= nil then by[k].at[r.Key] = r.Value end
        end
        local m, n, mast = {}, 0, {}
        for _, it in next, by do
            local okc, conf = pcall(function() return cfg2.match(it.id):unwrap() end)
            local names = {}
            if okc and conf then
                local dl = conf.Index and conf.Index.DebugLabel
                if dl then dl = tostring(dl); names[#names + 1] = dl:match("^(.-)%s*%[") or dl end
                local d = conf.Display and conf.Display.Name
                if d then names[#names + 1] = tostring(d) end
                local sk = conf.Index and conf.Index.StorageKey
                if sk then names[#names + 1] = tostring(sk) end
            end
            local mv = tonumber(it.at.Mastery)
            if mv and it.at.IsOwned == true then for _, nm in ipairs(names) do mast[nm] = math.max(mast[nm] or 0, mv) end end
            local q = tonumber(it.at.Quantity) -- só Quantity conta (IsOwned também vale para receitas/itens desbloqueados e dava falso positivo)
            if q and q > 0 and #names > 0 then
                n += 1
                for _, nm in ipairs(names) do
                    m[nm] = math.max(m[nm] or 0, q)
                    local nk = "#" .. string.lower(string.gsub(nm, "[^%w]", ""))
                    m[nk] = math.max(m[nk] or 0, q)
                end
            end
        end
        if n == 0 then return nil, "GetAllItemValues returned " .. rows .. " rows but no item matched" end
        I.mast = mast
        return m, n .. " items read (GetAllItemValues)"
    end
    function I.refresh()
        if os.clock() - I.at < 4 then return end
        I.at = os.clock()
        local m0, st0 = viaRemote()
        if m0 then I.map, I.state = m0, st0 return end
        I.remoteErr = st0
        if not discover() then
            I.state = string.format("module not found (store=%s keys=%s config=%s) | remote: %s", tostring(store ~= nil), tostring(keys ~= nil), tostring(cfg ~= nil), tostring(I.remoteErr))
            return
        end
        local m, n = {}, 0
        local ok, err = pcall(function()
            local a, b, c = store:GetItems(keys.QUANTITY)
            local function each(fn)
                if type(a) == "function" then for k, v in a, b, c do fn(k, v) end
                elseif type(a) == "table" then for k, v in pairs(a) do fn(k, v) end end
            end
            each(function(_, it)
                local q = type(it) == "table" and tonumber(it.Value)
                if q and q > 0 then
                    local okc, conf = pcall(function() return cfg.match(it.ItemId):unwrap() end)
                    local name
                    if okc and conf then
                        local d = conf.Display
                        name = (d and d.Name) or (conf.Index and conf.Index.StorageKey)
                    end
                    name = tostring(name or ("ItemId_" .. tostring(it.ItemId)))
                    n += 1
                    m[name] = (m[name] or 0) + q
                    local nk = "#" .. string.lower(string.gsub(name, "[^%w]", ""))
                    m[nk] = (m[nk] or 0) + q
                end
            end)
        end)
        if ok then I.map, I.state = m, n .. " item types read from the game data"
        else I.state = "read error: " .. tostring(err) end
    end
    function I.mastery(name) return I.mast and I.mast[name] or nil end
    function I.count(name)
        pcall(I.refresh)
        local nk = "#" .. string.lower(string.gsub(tostring(name), "[^%w]", ""))
        return I.map[name] or I.map[nk] or 0
    end
end


-- ---- Tiro por remote (Dragonstorm / Skull Guitar): mira sozinho no alvo, sem clicar na tela e sem mexer na câmera ----
-- Base: Quantum Onyx (RE/ShootGunEvent + Validator2 com o contador do CombatController) e Banana (SpamGunDragonStorm / Skull Guitar "TAP").
AFL.Shot = { last = 0, state = "not started" }
do
    local S = AFL.Shot
    local RS = game:GetService("ReplicatedStorage")
    local getup = getupvalue or (debug and debug.getupvalue)
    local setup = setupvalue or (debug and debug.setupvalue)
    local ctrlFn, shootEv, validator
    local function init()
        if shootEv and validator then return true end
        pcall(function()
            local mods = RS:FindFirstChild("Modules")
            local net = mods and mods:FindFirstChild("Net")
            shootEv = shootEv or (net and net:FindFirstChild("RE/ShootGunEvent"))
            local rem = RS:FindFirstChild("Remotes")
            validator = validator or (rem and rem:FindFirstChild("Validator2"))
        end)
        return shootEv ~= nil
    end
    -- contador que o servidor confere (mesma conta do CombatController)
    local function sig()
        if not ctrlFn and getup then
            pcall(function()
                local cc = require(RS.Controllers.CombatController)
                ctrlFn = getup(cc.Attack, 9)
            end)
        end
        if not (ctrlFn and getup and setup) then return 0, 0 end
        local ok, a, b = pcall(function()
            local v19, v20, v21, v22 = getup(ctrlFn, 15), getup(ctrlFn, 13), getup(ctrlFn, 16), getup(ctrlFn, 17)
            local v23, v24, v25 = getup(ctrlFn, 14), getup(ctrlFn, 18), getup(ctrlFn, 19)
            if not (v19 and v20 and v21 and v22 and v23 and v24 and v25) then return 0, 0 end
            local n = ((v19 * v23 + v20 * v21) % v22 * v22 + v20 * v23) % v24
            local n2 = math.floor(n / v22)
            local n3 = n - n2 * v22
            local n4 = v25 + 1
            setup(ctrlFn, 15, n2); setup(ctrlFn, 13, n3); setup(ctrlFn, 19, n4)
            return math.floor(n / v24 * 16777215), n4
        end)
        if ok then return a, b end
        return 0, 0
    end
    function S.fire(sc)
        local char = Player.Character
        local tool = char and char:FindFirstChildOfClass("Tool")
        local part = sc.part
        if not (tool and part and part.Parent) then return end
        local name = string.lower(tool.Name)
        local pos = part.Position
        if os.clock() - S.last < 0.1 then return end
        if sc.kind == "sg" and string.find(name, "skull guitar", 1, true) then
            S.last = os.clock()
            local re = tool:FindFirstChild("RemoteEvent")
            if re then re:FireServer("TAP", pos); S.state = "Skull Guitar: TAP" end
        elseif sc.kind == "gun" and tool.ToolTip == "Gun" then
            S.last = os.clock()
            local re = tool:FindFirstChild("RemoteEvent")
            if re and string.find(name, "skull guitar", 1, true) then re:FireServer("TAP", pos); S.state = "Skull Guitar: TAP"; return end
            if not init() then S.state = "RE/ShootGunEvent not found"; return end
            pcall(function()
                tool:SetAttribute("IsReloading_Client", false)
                tool:SetAttribute("LocalShotsLeft", 100)
                tool:SetAttribute("LocalTotalShots", (tool:GetAttribute("LocalTotalShots") or 0) + 1)
            end)
            local a, b = sig()
            if validator then pcall(function() validator:FireServer(a, b) end) end
            pcall(function() shootEv:FireServer(pos, { part }) end)
            S.state = "Gun " .. tool.Name .. ": shot at " .. tostring(part.Name)
        elseif sc.kind == "ds" and string.find(name, "dragonstorm", 1, true) then
            if not init() then S.state = "RE/ShootGunEvent not found"; return end
            S.last = os.clock()
            pcall(function()
                tool:SetAttribute("IsReloading_Client", false)
                tool:SetAttribute("LocalShotsLeft", 100)
                tool:SetAttribute("LocalTotalShots", (tool:GetAttribute("LocalTotalShots") or 0) + 1)
            end)
            local a, b = sig()
            if validator then pcall(function() validator:FireServer(a, b) end) end
            pcall(function() shootEv:FireServer(pos, { part }) end)
            S.state = "Dragonstorm: shot at " .. tostring(part.Name)
        end
    end
    Config.ShotFire = S.fire
end

function AFL.invDebug()
    local raw = InvCache.raw
    if type(raw) ~= "table" then return "game data: " .. tostring(AFL.Inv.state) .. " | remote: no data" end
    local n, hits = 0, {}
    for _, it in pairs(raw) do
        n += 1
        local nm = type(it) == "table" and tostring(it.Name) or tostring(_)
        local l = string.lower(nm)
        if string.find(l, "scrap", 1, true) or string.find(l, "ember", 1, true) or string.find(l, "magnet", 1, true) then
            local f = {}
            if type(it) == "table" then for k, v in pairs(it) do if type(v) ~= "table" then f[#f + 1] = tostring(k) .. "=" .. tostring(v) end end
            else f[1] = tostring(it) end
            hits[#hits + 1] = nm .. "{" .. table.concat(f, ",") .. "}"
        end
    end
    return "game data: " .. tostring(AFL.Inv.state) .. " | remote: " .. n .. " entries | " .. (#hits > 0 and table.concat(hits, " ") or "no scrap/ember/magnet entry")
end
