        task.wait(4)
        pcall(function()
            local now = os.clock()
            if now - (State.loopAt or now) > 15 then
                State.epoch += 1
                State.loopAt = now
                task.spawn(AFL.runMain, State.epoch)
                Diag.fight = "supervisor: the main loop froze; restarted"
                return
            end
            local farming = (Config.Mode ~= nil) or Config.KillTyrant
            local _, hrp = getChar()
            if farming and hrp and now - (State.atkAt or now) > 25 and now - (State.supAt or 0) > 25 then
