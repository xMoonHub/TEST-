    local ensure
    function ensure(s)
        if tool(s.tool) then return false end
        if (SF.cool[s.tool] or 0) > os.clock() then return false end
        -- 1) estilos pre-requisito: primeiro compra os que faltam, depois treina
        for _, p in ipairs(s.pre or {}) do
            if not tool(p[1]) then
                if ensure(STY[p[1]]) then return true end
                note(s.label .. ": could not get " .. p[1] .. " yet")
                return false
            end
        end
        for _, p in ipairs(s.pre or {}) do
            if train(p[1], p[2]) then return true end
        end
        -- 2) materiais
        for _, m in ipairs(s.mats or {}) do
            if farmMat(m) then return true end
            local have = 0
            pcall(function() have = AFL.Inv.count(m.name) end)
            if have < m.n then note(s.label .. ": missing " .. m.name .. " " .. have .. "/" .. m.n); return false end
        end
        -- 3) mar certo
        if s.seas then
            local w, b = wrongSea(s.seas)
            if w then return b end
        end
        -- 4) passos especiais
        if s.extra then
            local r = s.extra(s)
            if r == "busy" then return true end
            if r == "block" then return false end
        end
        -- 5) compra
        local cf = (s.npc and findNpc(s.npc)) or (s.pos and CFrame.new(s.pos))
        if not cf and not s.noNpc then note(s.label .. ": teacher NPC not found in this sea"); return false end
        if cf and not goTo(cf, 10, s.label .. " teacher") then return true end
        if not every("buy" .. s.tool, 4) then
            set("Buying " .. s.label)
            return true
        end
        local last
        for _, a in ipairs(s.buy) do
            local _, r = invoke(table.unpack(a))
            last = r
        end
        set(s.label .. ": server replied " .. tostring(last))
        if s.after then s.after() end
        SF.fail[s.tool] = (SF.fail[s.tool] or 0) + 1
        if SF.fail[s.tool] >= 6 then
            SF.fail[s.tool] = 0
            SF.cool[s.tool] = os.clock() + 180
            note(s.label .. ": purchase keeps failing (" .. tostring(last) .. ") - retrying in 3 min")
            return false
        end
        return true
    end

