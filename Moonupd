    local cur = THEMES["Default"]
    local Locks = setmetatable({}, { __mode = "k" }) -- [instância] = { propriedade = valor fixo }

    local function lockProp(inst, prop, value)
        local t = Locks[inst]
        if not t then t = {}; Locks[inst] = t end
        local first = (t[prop] == nil)
        t[prop] = value
        pcall(function() inst[prop] = value end)
        if first then
            pcall(function()
                inst:GetPropertyChangedSignal(prop):Connect(function()
                    pcall(function() if Locks[inst] and Locks[inst][prop] ~= nil and inst[prop] ~= Locks[inst][prop] then inst[prop] = Locks[inst][prop] end end)
                end)
            end)
        end
    end

    local function restyle(obj, th)
        if obj:IsA("UIStroke") then
            local root = Window and Window.Root
            if obj.Name:sub(1, 2) == "MH" or (root and obj.Parent == root) then return end
            local orig = obj:GetAttribute("MHOrig")
            if orig == nil then orig = obj.Color; obj:SetAttribute("MHOrig", orig) end
            if th.strokeMul ~= nil then obj.Color = Color3.new(orig.R * th.strokeMul, orig.G * th.strokeMul, orig.B * th.strokeMul)
            elseif th.strokeLerp then obj.Color = orig:Lerp(WHITE, th.strokeLerp)
            else obj.Color = orig end
            return
        end
        if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
            if not obj:GetAttribute("MHTitle") and obj.Name ~= "MHStudio" then
                local o = obj:GetAttribute("MHOT")
                if th.text then
                    if o == nil then o = obj.TextColor3; obj:SetAttribute("MHOT", o) end
                    lockProp(obj, "TextColor3", th.text)
                    if obj.TextTransparency < 0.9 then lockProp(obj, "TextTransparency", 0) end
                    local ts = obj:FindFirstChild("MHTS")
                    if th.textStroke then
                        if not ts then
                            ts = Instance.new("UIStroke")
                            ts.Name = "MHTS"
                            ts.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
                            ts.Color, ts.Thickness, ts.Transparency = Color3.fromRGB(0, 0, 0), 1, 0.35
                            ts.Parent = obj
                        end
                    elseif ts then ts:Destroy() end
                elseif o ~= nil then
                    local ts = obj:FindFirstChild("MHTS")
                    if ts then ts:Destroy() end
                    if Locks[obj] then Locks[obj].TextColor3 = nil; Locks[obj].TextTransparency = nil end
                    pcall(function() obj.TextColor3 = o end)
                    obj:SetAttribute("MHOT", nil)
                end
            end
        end
        if not (obj:IsA("Frame") or obj:IsA("ScrollingFrame") or obj:IsA("CanvasGroup")
            or obj:IsA("TextButton") or obj:IsA("ImageButton") or obj:IsA("TextBox")) then return end
        if obj:GetAttribute("MHTheme") == th.base .. (th.mul or 0) then return end
        -- cor ORIGINAL do Fluent: guardada na 1a vez; se o Fluent trocou a cor (SetTheme), recaptura.
        -- (sem isso, trocar de tema várias vezes empilhava um efeito em cima do outro: as cores se fundiam)
        local c = obj.BackgroundColor3
        local applied, orig0 = obj:GetAttribute("MHApplied"), obj:GetAttribute("MHBG")
        local function same(a, b) return math.abs(a.R - b.R) + math.abs(a.G - b.G) + math.abs(a.B - b.B) < 0.004 end
        if orig0 ~= nil and applied ~= nil and same(c, applied) then c = orig0
        else obj:SetAttribute("MHBG", c) end
        local mx, mn = math.max(c.R, c.G, c.B), math.min(c.R, c.G, c.B)
        local bt0 = obj:GetAttribute("MHBT")
        if bt0 == nil then bt0 = obj.BackgroundTransparency; obj:SetAttribute("MHBT", bt0) end
        if mx - mn < 0.08 and bt0 < 0.98 then
            obj:SetAttribute("MHTheme", th.base .. (th.mul or 0))
            local n = Color3.new(c.R * th.mul, c.G * th.mul, c.B * th.mul)
            if th.lerp then n = n:Lerp(th.lerp, th.lerpA) end
            if th.tint then n = n:Lerp(th.tint, th.tintA) end
            local isCard = false
            if th.card then
                local sz = obj.AbsoluteSize
                if sz.Y > 0 and sz.Y <= 90 and sz.X > 80 then n = th.card.color; isCard = true end
            end
            obj.BackgroundColor3 = n
            obj:SetAttribute("MHApplied", n)
            -- transparência: tema sólido = opaco (travado, o Fluent não clareia no hover); Water = vidro; Padrão = original
            local target
            if th.solid then target = 0
            elseif isCard then target = math.max(bt0, th.card.glass)
            elseif th.glass then target = math.max(bt0, th.glass) end
            if target ~= nil then
                lockProp(obj, "BackgroundTransparency", target)
            else
                if Locks[obj] then Locks[obj].BackgroundTransparency = nil end
                pcall(function() obj.BackgroundTransparency = bt0 end)
            end
        end
    end

    local function paintLabel(lbl, text, fill, stroke)
        lockProp(lbl, "Text", text)
        lockProp(lbl, "TextColor3", fill)
        lockProp(lbl, "TextTransparency", 0)
        local st = lbl:FindFirstChild("MHStroke")
        if not st then
            st = Instance.new("UIStroke")
            st.Name = "MHStroke"
            st.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
            st.Parent = lbl
        end
        lockProp(st, "Color", stroke)
        lockProp(st, "Thickness", 1)
        lockProp(st, "Transparency", 0)
        lockProp(st, "Enabled", true)
        lbl:SetAttribute("MHTitle", true)
    end

    local function styleTitle(root, th)
        local titleLbl, subLbl, studio
        for _, d in ipairs(root:GetDescendants()) do
            if d:IsA("TextLabel") then
                if d.Name == "MHStudio" then studio = d
                elseif d:GetAttribute("MHKind") == "title" then titleLbl = d
                elseif d:GetAttribute("MHKind") == "sub" then subLbl = d
                elseif d.Text == "Moon Hub" and not titleLbl then titleLbl = d; d:SetAttribute("MHKind", "title")
                elseif d.Text == "( Key-Version Pro )" and not subLbl then subLbl = d; d:SetAttribute("MHKind", "sub") end
            end
        end
        if titleLbl then paintLabel(titleLbl, "Moon Hub", th.title or WHITE, th.titleStroke or BLACK) end
        if subLbl then
            paintLabel(subLbl, "( Key-Version Pro )", th.sub or CYAN, WHITE)
            if not studio then
                studio = subLbl:Clone()
                studio.Name = "MHStudio"
                for _, ch in ipairs(studio:GetChildren()) do if ch:IsA("UIStroke") then ch:Destroy() end end
                local layout = subLbl.Parent:FindFirstChildWhichIsA("UIListLayout")
                studio.LayoutOrder = subLbl.LayoutOrder + 1
                studio.Parent = subLbl.Parent
                if not layout then
                    studio.Position = subLbl.Position + UDim2.fromOffset(subLbl.TextBounds.X + 8, 0)
                end
            end
            paintLabel(studio, "By Moon Studio", BLACK, WHITE)
        end
    end

    function AFL.applyTheme(name)
        local th = THEMES[name] or THEMES["Default"]
        cur = th
        pcall(function() Fluent:SetTheme(th.base) end)
        pcall(function() if Fluent.ToggleAcrylic then Fluent:ToggleAcrylic(th.acrylic) end end)
        local root = Window and Window.Root
        if not root then return end
        -- janela: borda (cor/espessura do tema)
        pcall(function()
            local st = root:FindFirstChildOfClass("UIStroke")
            if not st then
                st = Instance.new("UIStroke")
                st.Parent = root
            end
            st.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
            lockProp(st, "Color", th.stroke)
            lockProp(st, "Transparency", th.strokeT)
            lockProp(st, "Thickness", th.thick)
            lockProp(st, "Enabled", true)
        end)
        -- pontas arredondadas: raio igual na janela, no fundo/acrílico e no contorno (a borda acompanha o raio)
        pcall(function()
            local rad = UDim.new(0, th.corner or 18)
            root.ClipsDescendants = true
            local list = root:GetChildren()
            table.insert(list, root)
            for _, ch in ipairs(list) do
                local uc = ch:FindFirstChildOfClass("UICorner")
                if not uc and ch == root then uc = Instance.new("UICorner"); uc.Parent = root end
                if uc then lockProp(uc, "CornerRadius", rad) end
            end
        end)
        root:SetAttribute("MHTheme", nil)
        pcall(restyle, root, th)
        for _, d in ipairs(root:GetDescendants()) do
            d:SetAttribute("MHTheme", nil)
            pcall(restyle, d, th)
        end
        pcall(styleTitle, root, th)
    end

    pcall(AFL.applyTheme, Config.Theme)
    task.delay(1.5, function() if Alive then pcall(AFL.applyTheme, Config.Theme) end end)
    pcall(function()
        local gui = Fluent.GUI or Window.Root:FindFirstAncestorOfClass("ScreenGui")
        if gui then
            table.insert(Connections, gui.DescendantAdded:Connect(function(d)
                task.defer(function() pcall(restyle, d, cur) end)
            end))
        end
    end)
    if IsBloxFruits then
        Fluent:Notify({ Title = "Moon Hub ( Key-Version Pro )", Content = "Loaded in Sea " .. getSea() .. ".", Duration = 4 })
    else
        Fluent:Notify({ Title = "Moon Hub ( Key-Version Pro )", Content = "Blox Fruits remote not found: the UI opens, but the farm does not work in this game.", Duration = 8 })
    end
end
