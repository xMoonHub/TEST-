-- ============ PERSONAGEM / MOVIMENTO ============
local function getChar()
    local char = Player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hrp and hum and hum.Health > 0 then return char, hrp, hum end
end

local function distanceTo(cf)
    local _, hrp = getChar()
    return hrp and (hrp.Position - cf.Position).Magnitude or math.huge
end

-- Voo por Heartbeat (v30): parte sempre da posição REAL do personagem
local Fly = { goal = nil, lastPos = nil }
local currentTween = { PlaybackState = Enum.PlaybackState.Completed } -- compatibilidade: o resto do script chama currentTween:Cancel()
function currentTween:Cancel() Fly.goal = nil; self.PlaybackState = Enum.PlaybackState.Completed end
local function flyTo(targetCF)
    local _, hrp = getChar()
    if not hrp then return end
    if (hrp.Position - targetCF.Position).Magnitude < 3 then return end
    Fly.goal = targetCF
    currentTween.PlaybackState = Enum.PlaybackState.Playing
end
table.insert(Connections, RunService.Heartbeat:Connect(function(dt)
    local goal = Fly.goal
    if not goal then return end
    if not Alive then Fly.goal = nil return end
    local _, hrp = getChar()
    if not hrp then Fly.goal = nil return end
    local pos = hrp.Position
    local delta = goal.Position - pos
    local dist = delta.Magnitude
    if dist <= 2.5 then
        hrp.CFrame = goal
        hrp.AssemblyLinearVelocity = Vector3.zero
        Fly.goal = nil
        currentTween.PlaybackState = Enum.PlaybackState.Completed
        return
    end
    local step = math.min(dist, math.max(Config.TweenSpeed, 50) * math.min(dt, 0.1))
    local np = pos + delta.Unit * step
    local rot = hrp.CFrame.Rotation:Lerp(goal.Rotation, math.clamp(dt * 8, 0, 1))
    hrp.CFrame = CFrame.new(np) * rot
    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.AssemblyAngularVelocity = Vector3.zero
end))

-- Noclip + flutuação enquanto o script estiver controlando o personagem
local NoclipLast = 0
table.insert(Connections, RunService.Stepped:Connect(function()
    if not (Alive and State.Busy) or os.clock() < Config.SeaSitUntil then return end
    local char, hrp = getChar()
    if not char then return end
    local now = os.clock()
    if now - NoclipLast > 0.2 then
        NoclipLast = now
        for _, p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart") then p.CanCollide = false end
        end
    end
    if not hrp:FindFirstChild("FarmHold") then
        local bv = Instance.new("BodyVelocity")
        bv.Name = "FarmHold"
        bv.MaxForce = Vector3.new(1e5, 1e5, 1e5)
        bv.Velocity = Vector3.zero
        bv.Parent = hrp
    end
end))

local function releaseChar()
    local _, hrp = getChar()
    if hrp and hrp:FindFirstChild("FarmHold") then hrp.FarmHold:Destroy() end
    if currentTween then currentTween:Cancel() end
end

