-- Tenta comprar SEMPRE que o stock normal resetar (mudança de época de 4h OU mudança no conteúdo do stock).
-- Só considera frutas de prioridade MAIOR que a melhor que você já tem; compra a primeira à venda e não repete a compra.
local Buy = { epoch = nil, sig = nil, reads = 0, bought = {} }
-- v30: compara nomes de fruta de forma tolerante ("Dragon East-Dragon East", "Dragon (East)-Dragon (East)", "Dragon East" -> "dragoneast")
local function normFruit(n)
    n = string.lower(tostring(n))
    local half = string.match(n, "^(.+)%-%1$")
    if half then n = half end
    return (string.gsub(n, "[^%w]", ""))
end
local function ownsFruit(name)
    local short = string.lower(string.sub(name, 1, math.floor((#name - 1) / 2))) -- "Dragon-Dragon" -> "dragon", "T-Rex-T-Rex" -> "t-rex"
    local function match(n) return n and string.find(string.lower(n), short, 1, true) end
    for _, c in ipairs({ Player.Backpack, Player.Character }) do
        if c then
            for _, t in ipairs(c:GetChildren()) do
                if t:IsA("Tool") and string.find(t.Name, "Fruit", 1, true) == nil and match(t.Name) and t.ToolTip == "Blox Fruit" then return true end
            end
        end
    end
    local okD, eaten = pcall(function() return Player.Data.DevilFruit.Value end)
    if okD and type(eaten) == "string" and eaten ~= "" and match(eaten) then return true end
    return invCount(name) > 0
end
local function buyStep()
    local prios = {}
    for _, f in ipairs(Config.BuyPrio) do
        if f and f ~= "None" then prios[#prios + 1] = f end
    end
    if #prios == 0 then
        Diag.buy = "choose at least 1 fruit in the priorities"
        return
    end
    local ok, stock = invoke("GetFruits")
    if not ok or type(stock) ~= "table" then
        Buy.reads += 1
        Diag.buy = "could not read the stock: " .. tostring(stock)
        return
    end
    Buy.reads = 0
    local hasFlag, onSale, names = false, {}, {}
    for _, v in pairs(stock) do
        if type(v) == "table" and v.Name and v.OnSale ~= nil then hasFlag = true end
    end
    for _, v in pairs(stock) do
        if type(v) == "table" and v.Name and ((not hasFlag) or v.OnSale == true) then
            onSale[normFruit(v.Name)] = v.Name
            names[#names + 1] = v.Name
        end
    end
    table.sort(names)
    local epoch, sig = math.floor(os.time() / 14400), table.concat(names, ",")
    if Buy.epoch == epoch and Buy.sig == sig then return end -- mesmo stock: nada novo para tentar
    if Buy.epoch ~= epoch or Buy.sig ~= sig then Buy.bought = {} end -- stock novo: libera novas compras
    Buy.epoch, Buy.sig = epoch, sig
    -- a melhor fruta (menor número) que você já possui: só vale comprar as de prioridade MAIOR que ela
    local ownedIdx = #prios + 1
    for i, want in ipairs(prios) do
        if ownsFruit(want) then ownedIdx = i break end
    end
    for i = 1, ownedIdx - 1 do
        local want = prios[i]
        local real = onSale[normFruit(want)]
        if real and not Buy.bought[real] then
            Buy.bought[real] = true -- uma única tentativa por fruta neste stock
            local ok2, r = invoke("PurchaseRawFruit", real)
            Diag.buy = string.format("priority %d (%s): %s -> %s", i, real, ok2 and "tried to buy" or "error", tostring(r))
            return
        end
    end
    if ownedIdx <= #prios then
        Diag.buy = "you already have " .. prios[ownedIdx] .. " (priority " .. ownedIdx .. "): I won't buy the lower priority ones"
    else
        Diag.buy = "no fruit from your list is in the normal stock right now"
    end
end

